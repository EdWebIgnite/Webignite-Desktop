<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The heavier tools (PDF pages, picture shrinking, QR codes, and later PDF editing, the image viewer and
    screen recording), kept apart from the app so their libraries are only read from disk the first time a
    tool is used. Nothing at start-up may touch a type in here.
  -->
  <PropertyGroup>
    <RootNamespace>Webignite.Tools</RootNamespace>
    <!-- Windows' text reading (WindowsOcr.cs) is called through its own tables of functions, which needs pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The WebView2 wrapper comes with a 600 KB file of notes for programmers; it isn't shipped. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="QRCoder" />
    <!-- Only the wrapper (Microsoft.Web.WebView2.Core.dll) and its small loader are wanted. The package's own build
         files would also pull in its WPF and WinForms controls, so they are left out and the wrapper is named below. -->
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive;compile" PrivateAssets="build;buildTransitive;contentfiles;analyzers" />
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Webignite.Core\Webignite.Core.csproj" />
  </ItemGroup>
</Project>
