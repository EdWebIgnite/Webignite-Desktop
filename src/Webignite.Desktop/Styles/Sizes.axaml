<!--
  The small text sizes, by name, so a style (Looks.cs) can change them in one place. These are Classic's: each name
  is the size it has always been. Text typed onto a page as FontSize="12" can't be changed by a style, so pages use
  FontSize="{DynamicResource Text12}" for any of these sizes. Body text is the window's own size (14) and headings
  have their own classes in Controls.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="Text10">10</x:Double>
  <x:Double x:Key="Text10x5">10.5</x:Double>
  <x:Double x:Key="Text11">11</x:Double>
  <x:Double x:Key="Text11x5">11.5</x:Double>
  <x:Double x:Key="Text12">12</x:Double>
  <x:Double x:Key="Text12x5">12.5</x:Double>
  <x:Double x:Key="Text13">13</x:Double>
</ResourceDictionary>
