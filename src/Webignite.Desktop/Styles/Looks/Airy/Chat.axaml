<!-- Chat in the Airy style, laid over the styles in ChatView.axaml (see Looks.cs). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Bubbles sit flat on the page, like the cards. -->
  <Style Selector="Window.look-airy Border.bubble">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
</Styles>
