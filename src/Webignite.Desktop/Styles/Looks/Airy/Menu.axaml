<!-- The menus without a sidebar in the Airy style, laid over the styles in MenuBarView, DockView and MenuOverlayView (see Looks.cs). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The menus without a sidebar: rounder, roomier. -->
  <Style Selector="Window.look-airy Border.menubar">
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="Window.look-airy Button.menubutton">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Window.look-airy Button.barbutton">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Window.look-airy Border.megamenu">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="26,26,26,28" />
  </Style>
  <Style Selector="Window.look-airy Button.menuentry">
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Window.look-airy Border.dock">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="10,9" />
  </Style>
  <Style Selector="Window.look-airy Button.dockitem">
    <Setter Property="Width" Value="76" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>
</Styles>
