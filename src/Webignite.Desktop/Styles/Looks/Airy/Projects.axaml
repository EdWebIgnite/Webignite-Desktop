<!-- Projects in the Airy style, laid over the page's own styles in ProjectsView.axaml (see Looks.cs). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window.look-airy Border.taskrow">
    <Setter Property="MinHeight" Value="46" />
  </Style>
  <Style Selector="Window.look-airy Border.listhead">
    <Setter Property="Padding" Value="16,10,8,10" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Window.look-airy Border.listsection">
    <Setter Property="Margin" Value="0,26,0,0" />
    <Setter Property="Padding" Value="0,0,0,6" />
  </Style>
  <Style Selector="Window.look-airy Border.cellline">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Window.look-airy Button.listtool">
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Window.look-airy Button.addtask">
    <Setter Property="CornerRadius" Value="9,0,0,9" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Window.look-airy Button.addtaskmore">
    <Setter Property="CornerRadius" Value="0,9,9,0" />
    <Setter Property="Padding" Value="9,9" />
  </Style>
  <Style Selector="Window.look-airy Border.boardcolumn">
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Window.look-airy Border.boardcard">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
</Styles>
