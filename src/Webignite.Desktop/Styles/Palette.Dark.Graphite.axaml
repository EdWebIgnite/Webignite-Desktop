<!--
  Dark palette "Graphite". Same names as Palette.axaml, so every screen picks these up when dark mode is on.
  Graphite: neutral dark grey, light buttons. Red and green still mean "needs attention" and "done" only, a shade lighter so they read on dark.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Canvas" Color="#16171A" />
  <SolidColorBrush x:Key="Surface" Color="#1F2024" />
  <!-- Behind a page of a PDF or a picture: white, as on paper, in every look. -->
  <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
  <!-- Writing on paper (the mail editor): the paper stays white in every palette, so its ink does too. -->
  <SolidColorBrush x:Key="PaperText" Color="#1F2A26" />
  <SolidColorBrush x:Key="PaperLine" Color="#C8CDD0" />
  <SolidColorBrush x:Key="PaperMuted" Color="#7A8580" />
  <SolidColorBrush x:Key="PaperShade" Color="#F4F5F5" />
  <SolidColorBrush x:Key="PaperLink" Color="#1A5FB4" />
  <SolidColorBrush x:Key="PaperSelection" Color="#B9D3F5" />
  <SolidColorBrush x:Key="Surface2" Color="#26282C" />
  <SolidColorBrush x:Key="TableHead" Color="#2A2C31" />
  <SolidColorBrush x:Key="Line" Color="#33363C" />
  <SolidColorBrush x:Key="Line2" Color="#454850" />
  <SolidColorBrush x:Key="Text" Color="#E6E7EA" />
  <!-- Selected text in boxes: a soft highlight the text stays readable on. -->
  <SolidColorBrush x:Key="Selection" Color="#4A5568" />
  <SolidColorBrush x:Key="OnSelection" Color="#E6E7EA" />
  <!-- A picked tab or filter shown as a pill, as Asana marks the picked tab on Home. -->
  <SolidColorBrush x:Key="Picked" Color="#4A5568" />
  <SolidColorBrush x:Key="OnPicked" Color="#E6E7EA" />
  <!-- Where something dragged will land: the line, the ring and the card's outline, blue as in Asana. -->
  <SolidColorBrush x:Key="DropMark" Color="#4A9EFF" />
  <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Muted" Color="#9EA2AA" />

  <!-- Sidebar: a little darker than the page. -->
  <SolidColorBrush x:Key="Nav" Color="#0F1012" />
  <SolidColorBrush x:Key="NavHover" Color="#1B1C20" />
  <SolidColorBrush x:Key="NavSelected" Color="#2A2C31" />
  <SolidColorBrush x:Key="NavText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavMuted" Color="#8D9099" />
  <!-- Dims the page behind the Ctrl+K search box. -->
  <SolidColorBrush x:Key="Scrim" Color="#99000000" />

  <SolidColorBrush x:Key="Primary" Color="#E6E7EA" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OnPrimary" Color="#16171A" />

  <SolidColorBrush x:Key="Attention" Color="#F0907A" />
  <SolidColorBrush x:Key="AttentionSoft" Color="#3B231E" />
  <SolidColorBrush x:Key="AttentionLine" Color="#5C3329" />
  <SolidColorBrush x:Key="InvoiceTint" Color="#73B6D8" />
  <SolidColorBrush x:Key="InvoiceSoft" Color="#1A2C35" />
  <SolidColorBrush x:Key="QuoteTint" Color="#B79DE2" />
  <SolidColorBrush x:Key="QuoteSoft" Color="#2A2339" />
  <SolidColorBrush x:Key="Ok" Color="#62C593" />
  <SolidColorBrush x:Key="OkSoft" Color="#18301F" />
  <SolidColorBrush x:Key="OkLine" Color="#255238" />

  <!-- Mail categories and the Important mark: dots and flags only, never backgrounds. No red or green here. -->
  <SolidColorBrush x:Key="CategoryBlue" Color="#4A9EFF" />
  <SolidColorBrush x:Key="CategoryPurple" Color="#C17BEA" />
  <SolidColorBrush x:Key="CategoryOrange" Color="#FFA733" />
  <SolidColorBrush x:Key="CategoryYellow" Color="#FFD633" />
  <SolidColorBrush x:Key="CategoryTeal" Color="#4CC4D8" />
  <SolidColorBrush x:Key="CategoryPink" Color="#F06AAE" />
  <SolidColorBrush x:Key="CategoryGrey" Color="#9C9CA3" />
  <SolidColorBrush x:Key="Important" Color="#FFA733" />

  <!-- Project squares: Asana's 16 project colours, the same in light and dark, with a near-black picture on top.
       Red and green appear here only as a project's own colour; they still mean problem and done everywhere else. -->
  <SolidColorBrush x:Key="ProjectRed" Color="#FF8576" />
  <SolidColorBrush x:Key="ProjectOrange" Color="#FF9F4B" />
  <SolidColorBrush x:Key="ProjectYellowOrange" Color="#F7BD51" />
  <SolidColorBrush x:Key="ProjectYellow" Color="#FFD721" />
  <SolidColorBrush x:Key="ProjectYellowGreen" Color="#C3E684" />
  <SolidColorBrush x:Key="ProjectGreen" Color="#82D990" />
  <SolidColorBrush x:Key="ProjectBlueGreen" Color="#6AD8BC" />
  <SolidColorBrush x:Key="ProjectAqua" Color="#93F0D9" />
  <SolidColorBrush x:Key="ProjectBlue" Color="#8DB8FF" />
  <SolidColorBrush x:Key="ProjectIndigo" Color="#B8ACFF" />
  <SolidColorBrush x:Key="ProjectPurple" Color="#E39EF2" />
  <SolidColorBrush x:Key="ProjectMagenta" Color="#FFBEFF" />
  <SolidColorBrush x:Key="ProjectHotPink" Color="#FC96BF" />
  <SolidColorBrush x:Key="ProjectPink" Color="#FFC6BD" />
  <SolidColorBrush x:Key="ProjectCoolGrey" Color="#AAAAAA" />
  <SolidColorBrush x:Key="ProjectNone" Color="#D9D9D9" />
  <SolidColorBrush x:Key="OnProject" Color="#050505" />

  <!-- Depth: cards sit just above the page; cards you can click rise a little more under the mouse. -->
  <BoxShadows x:Key="CardShadow">0 1 2 0 #40000000, 0 4 14 0 #33000000</BoxShadows>
  <BoxShadows x:Key="CardShadowRaised">0 2 4 0 #4D000000, 0 10 24 0 #80000000</BoxShadows>
  <!-- Under things that float over the page: the Ctrl+K box, a note in the corner, the address suggestions. -->
  <BoxShadows x:Key="OverlayShadow">0 12 32 0 #99000000</BoxShadows>
  <BoxShadows x:Key="PopupShadow">0 6 18 0 #80000000</BoxShadows>
  <BoxShadows x:Key="HeadShadow">0 3 8 0 #73000000</BoxShadows>

  <!-- Mark-up pens, drawn on client screenshots. Red marks what needs fixing. -->
  <Color x:Key="MarkRed">#E03131</Color>
  <Color x:Key="MarkYellow">#FCC419</Color>
  <Color x:Key="MarkBlue">#1971C2</Color>
  <!-- Round a numbered note, and its number: white, or black on the yellow pen. -->
  <Color x:Key="MarkOutline">#FFFFFF</Color>
  <Color x:Key="MarkOnYellow">#000000</Color>

  <!-- Fluent accent follows the primary colour, so focus rings and selections match. -->
  <Color x:Key="SystemAccentColor">#E6E7EA</Color>

  <!-- Notes in the window corner: a raised dark card with a strip in the button colour. -->
  <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="#E6E7EA" />
  <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Color="#26282C" />
  <SolidColorBrush x:Key="NotificationCardForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
