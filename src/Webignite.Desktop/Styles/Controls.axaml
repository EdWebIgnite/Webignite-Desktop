<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Webignite.Desktop.Controls">

  <Styles.Resources>
    <!-- A folding row on a page such as a client's: grip, arrow, icon, name and a one-line summary; what's in it below when open. -->
    <ControlTheme x:Key="{x:Type c:FoldSection}" TargetType="c:FoldSection">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Row" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <Border Height="2" Background="{DynamicResource Primary}" IsVisible="{TemplateBinding DropAbove}" />
              <Grid ColumnDefinitions="22,*">
                <Border Name="PART_Grip" Background="Transparent" Cursor="SizeAll" ToolTip.Tip="Drag to move it. Right-click for more.">
                  <c:Icon Data="{StaticResource Icon.Grip}" Size="13" Foreground="{DynamicResource Line2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Name="PART_Header" Grid.Column="1" Classes="foldhead" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <c:Icon Name="PART_Chevron" Data="{StaticResource Icon.ChevronRight}" Size="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <c:Icon Grid.Column="1" Data="{TemplateBinding Icon}" Size="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{TemplateBinding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Name="PART_Summary" Text="{TemplateBinding Summary}" Classes="muted" FontSize="{DynamicResource Text13}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" MaxLines="2" />
                  </Grid>
                </Button>
              </Grid>
              <ContentPresenter Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsOpen}" Margin="26,0,18,16" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[IsOpen=True] /template/ c|Icon#PART_Chevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
      <Style Selector="^[Attention=True] /template/ TextBlock#PART_Summary">
        <Setter Property="Foreground" Value="{DynamicResource Attention}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- The header of a folding row: the whole line is the button. -->
  <Style Selector="Button.foldhead">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,14,20,14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.foldhead:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Selected text everywhere: the accent is near-black in the light look, which hid the text. -->
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnSelection}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource Selection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnSelection}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="{DynamicResource Text12}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <!-- A label in small capitals over a list (CLIENTS, NOTEBOOKS). Its size is set here, not on the label itself:
       a named size on the element doesn't win over the label's own, as a typed number did. -->
  <Style Selector="TextBlock.label.caps">
    <Setter Property="FontSize" Value="{DynamicResource Text10x5}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.tablehead">
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <!-- More went out than came in -->
  <!-- Money that came in short of what went out, or a date that has passed. For messages, use problem. -->
  <Style Selector="TextBlock.short">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>
  <Style Selector="TextBlock.amount">
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>
  <!-- A table's column titles, pinned while the rows scroll under them (Controls/Sticky.cs).
       Each table sets only its own Padding, to line the titles up with its rows. -->
  <Style Selector="Border.stickyhead">
    <Setter Property="c:Sticky.IsEnabled" Value="True" />
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
    <Setter Property="Height" Value="36" />
  </Style>
  <!-- A table cell with a faint line down its left, for tables of figures: the heading's and the rows' cells share it. -->
  <Style Selector="Border.colline">
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="16,0,20,0" />
  </Style>
  <Style Selector="Border.stickyhead:stuck">
    <Setter Property="BoxShadow" Value="{DynamicResource HeadShadow}" />
  </Style>
  <Style Selector="Border.pending">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <!-- A box whose text isn't right, e.g. a rate that isn't an amount. -->
  <Style Selector="TextBox.problem">
    <Setter Property="BorderBrush" Value="{DynamicResource Attention}" />
  </Style>
  <Style Selector="TextBlock.problem">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>
  <!-- A view tab under a page's heading (a project's List and Board), as Asana's: words, the open one underlined -->
  <Style Selector="Button.viewtab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="2,6" />
    <Setter Property="Margin" Value="0,0,18,0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.viewtab.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.viewtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- A project's square in its header: the button around it stays out of the way -->
  <Style Selector="Button.projecthead">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="c|Icon.starred">
    <Setter Property="Foreground" Value="{DynamicResource CategoryYellow}" />
  </Style>
  <!-- Small tabs as Asana's (Comments / All activity, Activity / Archive): the one showing is filled in. -->
  <Style Selector="Button.feedtab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.feedtab.on">
    <Setter Property="Background" Value="{DynamicResource Picked}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
  </Style>
  <Style Selector="Button.feedtab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Picked}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
  </Style>
  <!-- A like I gave, as Asana's: the thumbs-up in the primary colour. -->
  <Style Selector="c|Icon.liked">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
  </Style>
  <!-- A handle to drag something taller or shorter (Calendar's month, Planner's days): a short bar, darker on hover. -->
  <Style Selector="Border.sizegrip">
    <Setter Property="Height" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>
  <Style Selector="Border.sizegripline">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.sizegrip:pointerover > Border.sizegripline">
    <Setter Property="Background" Value="{DynamicResource Muted}" />
  </Style>
  <!-- A value in a list row that reads as words and changes with a click: who a task is for, when it's due. -->
  <Style Selector="Button.cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{DynamicResource Text13}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.cell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.cell.empty">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.cell.late">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>
  <Style Selector="Border.ready">
    <Setter Property="Background" Value="{DynamicResource OkSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Button.navsearch">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.navsearch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelected}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource NavText}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Nav}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- A small label on a light card, e.g. "Contact person" -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,1" />
  </Style>

  <!-- A pill that stands out, e.g. a High priority task -->
  <Style Selector="Border.pill.strong">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Border.pill.strong > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>

  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>

  <!-- Buttons: one solid primary action per screen, everything else quiet. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <!-- A primary button that can't be pressed yet stays the same shape, just faded, so the screen doesn't jump. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <!-- The drag handle between panes: invisible until the pointer is over it. -->
  <Style Selector="GridSplitter.panes">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter.panes:pointerover">
    <Setter Property="Background" Value="{DynamicResource Line2}" />
  </Style>

  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <!-- A palette preview in Settings: a quiet frame that darkens when it's the one in use. -->
  <Style Selector="Button.palette">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Margin" Value="0,0,12,12" />
  </Style>
  <Style Selector="Button.palette:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
  </Style>
  <Style Selector="Button.palette.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Button.palette.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>

  <!-- A row of choices where one is on, e.g. Bars / Filled / Lines -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="{DynamicResource Text12}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.segment.on">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="Button.format">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- A format button that is on where the caret is (bold, a list, an alignment). -->
  <Style Selector="Button.format.on">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Button.format.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Button.format.icon">
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <!-- The paper the mail editor writes on: white in every look, as the mail will arrive. -->
  <Style Selector="Border.paper">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.paper:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
  </Style>
  <!-- A group's list, opened just above the dock: a white card with soft corners, each row an icon on a small
       tile and its name. The row for what is on screen is tinted. -->
  <Style Selector="Border.dockpopcard">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="8,10,8,8" />
    <Setter Property="BoxShadow" Value="{DynamicResource OverlayShadow}" />
  </Style>
  <Style Selector="FlyoutPresenter.dockpop">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="8,10,8,8" />
    <Setter Property="MaxHeight" Value="620" />
  </Style>
  <Style Selector="TextBlock.grouptitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.groupentry">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="6,5,10,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Button.groupentry.sub">
    <Setter Property="Padding" Value="20,3,10,3" />
  </Style>
  <Style Selector="Button.groupentry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.groupentry.current">
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.grouptile">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.groupentry.current Border.grouptile">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.groupdot">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="Border.groupdot Ellipse">
    <Setter Property="Fill" Value="{DynamicResource Muted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The date box (Controls/DateBox): it looks like the text boxes beside it, and opens a small calendar. -->
  <Style Selector="Button.datebox">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.datebox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.datebox:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <!-- A day in the date box's month: a round button; today has a ring, the day picked is filled. -->
  <Style Selector="Button.calday">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="Button.calday:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.calday.other">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.calday:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.calday.today">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.calday.today:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Button.calday.picked">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.calday.picked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.calnav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.calnav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <!-- A colour you click (the shades on Tools): the colour itself is the button, with no grey behind it. -->
  <Style Selector="Button.shade">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.shade:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.shade:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.shade:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- List rows that open a document -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,11" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <!-- A row in a Reports list: plain until the pointer is on a client that can be opened. -->
  <Style Selector="Button.sharerow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.sharerow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>

  <!-- The row whose item is open beside the list, e.g. the client open in the right-hand pane. -->
  <Style Selector="Button.row.open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
  </Style>
  <!-- The chevron at the end of a row you can open: faint until the pointer is on the row. -->
  <Style Selector="c|Icon.chevron">
    <Setter Property="Size" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Opacity" Value="0.35" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.row:pointerover c|Icon.chevron">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Status as a coloured dot and a word, the way Apple shows tags. Red is a problem, green is done,
       orange is waiting on you, grey is everything else. -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource CategoryGrey}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.dot.done">
    <Setter Property="Fill" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="Ellipse.dot.waiting">
    <Setter Property="Fill" Value="{DynamicResource CategoryOrange}" />
  </Style>
  <Style Selector="Ellipse.dot.problem">
    <Setter Property="Fill" Value="{DynamicResource Attention}" />
  </Style>
  <Style Selector="TextBlock.problem.status">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Quick filters above a list: soft pills, the one in use filled in. -->
  <Style Selector="Button.filter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="{DynamicResource Text13}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.filter.on">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.filter.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>

  <!-- A badge for something paused or set aside. -->
  <Style Selector="Border.dim">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- The line under a page title that says where things stand. -->
  <Style Selector="TextBlock.headline">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- A small icon before a card's heading. -->
  <Style Selector="c|Icon.cardicon">
    <Setter Property="Size" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Border.status.done">
    <Setter Property="Background" Value="{DynamicResource OkSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
  </Style>
  <Style Selector="Border.status.done TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
  </Style>
  <Style Selector="Border.status.problem">
    <Setter Property="Background" Value="{DynamicResource AttentionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AttentionLine}" />
  </Style>
  <Style Selector="Border.status.problem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>

  <!-- To-do -->
  <!-- A bold edge down the left of a row that needs you: overdue in the problem colour. Rows put it first in a
       Panel, with a negative margin that takes it out to the row's own edge. -->
  <Style Selector="Border.edge">
    <Setter Property="Width" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Attention}" />
  </Style>
  <Style Selector="Border.taskrow">
    <!-- See-through, so a right-click anywhere on the row opens its menu. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,8,8,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.taskrow.done TextBlock.tasktitle">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="TextBlock.label.overdue">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>

  <!-- Section headings inside a page, e.g. "Renew soon" or "Today" above a card. -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="{DynamicResource Text12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>
  <Style Selector="TextBlock.section.overdue">
    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
  </Style>

  <!-- Typing boxes and pickers: soft grey edge, rounded like the buttons, a dark edge while typing. -->
  <Style Selector="TextBox, ComboBox, NumericUpDown, DatePicker, TimePicker, CalendarDatePicker, AutoCompleteBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Typed straight into a list row, as in Projects: no edge until pointed at or typed in. -->
  <Style Selector="TextBox.inline">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.inline:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="TextBox.inline.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <!-- The template gallery: round category chips (the picked one a pill, as in Asana) and a card per template. -->
  <Style Selector="Button.gallerychip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Button.gallerychip.on">
    <Setter Property="Background" Value="{DynamicResource Picked}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Picked}" />
  </Style>
  <Style Selector="Button.gallerychip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Picked}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
  </Style>
  <Style Selector="Button.gallerycard">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="96" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.gallerycard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
  </Style>
  <!-- A task's six dots show under the mouse, as in Asana: the whole row or card can be dragged (Controls/DragReorder.cs). -->
  <Style Selector="Border.taskrow > Grid > Border.grip, Border.card > Grid > Border.grip">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.taskrow:pointerover > Grid > Border.grip, Border.card:pointerover > Grid > Border.grip">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A task's row can be grabbed anywhere; tasks picked with Ctrl or Shift, to drag together, are tinted. -->
  <Style Selector="Border.taskrow">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.taskrow.picked">
    <Setter Property="Background" Value="{DynamicResource Picked}" />
  </Style>
  <Style Selector="Border.card.picked">
    <Setter Property="BorderBrush" Value="{DynamicResource DropMark}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Empty pages: a quiet icon in a soft circle, a heading, one line, and the button that adds the first one. -->
  <Style Selector="c|EmptyState">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Classes="card" Padding="32,40">
          <StackPanel HorizontalAlignment="Center" MaxWidth="440" Spacing="8">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Surface2}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,6"
                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
              <c:Icon Data="{TemplateBinding Icon}" Size="24" Foreground="{DynamicResource Muted}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="h2" Text="{TemplateBinding Title}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{TemplateBinding Text}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="primary" Content="{TemplateBinding ActionText}" Command="{TemplateBinding Command}"
                    HorizontalAlignment="Center" Margin="0,10,0,0"
                    IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- The quiet line under a short list: a hint and, when there is one, the next thing to do. -->
  <Style Selector="c|ListHint">
    <Setter Property="Template">
      <ControlTemplate>
        <!-- A grid rather than a row, so the words wrap in a narrow pane instead of running off the edge. -->
        <Grid ColumnDefinitions="Auto,8,*,8,Auto" Margin="4,2,0,0" HorizontalAlignment="Left" MaxWidth="780">
          <c:Icon Data="{StaticResource Icon.Hint}" Size="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="muted" Text="{TemplateBinding Text}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="640" />
          <Button Grid.Column="4" Classes="link" Content="{TemplateBinding ActionText}" Command="{TemplateBinding Command}" VerticalAlignment="Center"
                  IsVisible="{TemplateBinding ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- A short "Saved" beside a Save button, shown for a moment after each save (Controls/SavedNote.cs). -->
  <Style Selector="c|SavedNote">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <c:Icon Data="{StaticResource Icon.Check}" Size="14" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" />
          <TextBlock Text="Saved" FontSize="{DynamicResource Text12}" Foreground="{DynamicResource Ok}" VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|SavedNote.shown">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- A row on its way out can't be clicked again. -->
  <Style Selector="Border.taskrow.leaving">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The side menu on a page, e.g. the sections of Settings. -->
  <Style Selector="ListBox.sections">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.sections ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>

  <!-- The strip a hidden pane leaves where it was: its name, standing up; a click brings it back. -->
  <!-- A minimised pane's chip under its page in the sidebar. -->
  <Style Selector="Button.panechip">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.panechip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
  </Style>

  <!-- The minimise tab on a divider between panes. -->
  <Style Selector="Button.panehandle">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="-8,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.panehandle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Button.panerail">
    <Setter Property="Width" Value="28" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,14" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.panerail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- When the window is split, the header over each side: its page, and buttons to swap, pop out or close.
       Dragged, it moves the side; the hand says so. -->
  <Style Selector="Border.sidehead">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,4,6,4" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>
  <Style Selector="Border.sidehead.dragging">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Button.sidebutton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.sidebutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>

  <!-- Tabs across the top of the page area, once there are two. The tab on screen joins the page below it. -->
  <Style Selector="Border.tabstrip">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Padding" Value="8,6,8,0" />
  </Style>
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,6,8,7" />
    <Setter Property="Margin" Value="0,0,2,-1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TableHead}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter, ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <!-- The bar between two pages side by side: drag it to share the width differently. -->
  <!-- A gap between two parts of a page that can be dragged: invisible until the pointer is on it. -->
  <Style Selector="GridSplitter.gap">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="GridSplitter.gap:pointerover">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="GridSplitter.divider">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="MinWidth" Value="5" />
  </Style>
  <!-- A popped-out window's own tab, joined to its page like the main window's tab on screen. -->
  <Style Selector="Border.poptab">
    <Setter Property="Background" Value="{DynamicResource Canvas}" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="Padding" Value="12,6,12,7" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.tabclose, Button.tabplus">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.tabplus">
    <Setter Property="Padding" Value="7" />
    <Setter Property="Margin" Value="4,0,0,4" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter, Button.tabplus:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Sidebar -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <!-- The sidebar folded to icons: square items, the icon in the middle. -->
  <Style Selector="ListBox.nav.icons ListBoxItem">
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem.heading">
    <Setter Property="Padding" Value="12,12,12,4" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem.heading:pointerover c|Icon.fold">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="c|Icon.fold">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- The button that tucks the sidebar away, and the one on the thin strip that brings it back. -->
  <Style Selector="Button.navtoggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource NavMuted}" />
  </Style>
  <Style Selector="Button.navtoggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
  </Style>
  <!-- A heading with no words is just a little space, e.g. above Settings. -->
  <Style Selector="ListBox.nav ListBoxItem.gap">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="c|Icon.navicon">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected c|Icon.navicon">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A project in the sidebar's Projects group: a small dot where a page has its icon. -->
  <Style Selector="Ellipse.projectdot">
    <Setter Property="Fill" Value="{DynamicResource NavMuted}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Ellipse.projectdot">
    <Setter Property="Fill" Value="{DynamicResource NavText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}" />
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource NavText}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelected}" />
  </Style>
  <!-- Group headings: clicking one folds its pages up or opens them out. They never look selected or lit up.
       Last on purpose: Avalonia gives later styles the say, so these must come after the hover and selected rules. -->
  <Style Selector="ListBox.nav ListBoxItem.heading:pointerover /template/ ContentPresenter, ListBox.nav ListBoxItem.heading:selected /template/ ContentPresenter, ListBox.nav ListBoxItem.gap:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Files: the side list of places, the address bar, the column headings, and the list in its three views. -->
  <Style Selector="Button.place">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.place:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Border.address">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Ibeam" />
  </Style>
  <Style Selector="Button.crumb">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.sorthead">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="FontSize" Value="{DynamicResource Text12}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter, ListBox.files ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="ListBox.files.thumbs">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.files.thumbs ListBoxItem">
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- Cut and not pasted yet: faded, as in Explorer. -->
  <Style Selector="Panel.cut">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="c|Icon.folder">
    <Setter Property="Foreground" Value="{DynamicResource CategoryYellow}" />
  </Style>
  <!-- A colour to pick, e.g. a tag's in Settings: ringed when it is the one in use. -->
  <Style Selector="Border.swatch">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.swatch.chosen">
    <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
  </Style>
  <!-- Files' column view: the list of the folder you're in is a column like the others. -->
  <Style Selector="ListBox.files.columns">
    <Setter Property="Width" Value="300" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.columnrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.columnrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.columnrow.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <!-- Label and value pairs, e.g. Files' details pane. -->
  <Style Selector="Grid.facts > TextBlock">
    <Setter Property="Margin" Value="0,0,12,6" />
    <Setter Property="FontSize" Value="{DynamicResource Text12}" />
  </Style>
  <!-- A folder's share of the space in Files' Space view. -->
  <Style Selector="Border.spacebar">
    <Setter Property="Background" Value="{DynamicResource Muted}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- PDF tools: pages as cards, and what's put on a page while filling it in. -->
  <Style Selector="ListBox.pdfpages ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.pdfpages ListBoxItem:selected /template/ ContentPresenter, ListBox.pdfpages ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.stamp">
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.stamptext">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PaperText}" />
  </Style>
  <Style Selector="TextBox.stamptext:focus /template/ Border#PART_BorderElement, TextBox.stamptext:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.stampclose">
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="0,-10,-10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
