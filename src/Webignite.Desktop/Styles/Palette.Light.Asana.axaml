<!--
  Light palette "Asana": the colours of Asana's light theme, read from its own design tokens (Nov 2026).
  Same names as Palette.axaml. White page and cards with thin grey lines, a light grey sidebar, blue for buttons
  and what's picked. Red and green still mean "needs attention" and "done" only.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Canvas" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <!-- Behind a page of a PDF or a picture: white, as on paper, in every look. -->
  <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
  <!-- Writing on paper (the mail editor): the paper stays white in every palette, so its ink does too. -->
  <SolidColorBrush x:Key="PaperText" Color="#1F2A26" />
  <SolidColorBrush x:Key="PaperLine" Color="#C8CDD0" />
  <SolidColorBrush x:Key="PaperMuted" Color="#7A8580" />
  <SolidColorBrush x:Key="PaperShade" Color="#F4F5F5" />
  <SolidColorBrush x:Key="PaperLink" Color="#1A5FB4" />
  <SolidColorBrush x:Key="PaperSelection" Color="#B9D3F5" />
  <SolidColorBrush x:Key="Surface2" Color="#F8F8F8" />
  <SolidColorBrush x:Key="TableHead" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Line" Color="#EAEAEA" />
  <SolidColorBrush x:Key="Line2" Color="#C6C6C6" />
  <SolidColorBrush x:Key="Text" Color="#1E1E1E" />
  <!-- Text a step softer than Text, for long lists such as the mail list; the same as Text in the light looks. -->
  <SolidColorBrush x:Key="SoftText" Color="#1E1E1E" />
  <!-- Selected text in boxes: a soft highlight the text stays readable on. -->
  <SolidColorBrush x:Key="Selection" Color="#D1E3FF" />
  <SolidColorBrush x:Key="OnSelection" Color="#050505" />
  <!-- A picked tab or filter shown as a pill, as Asana marks the picked tab on Home. -->
  <SolidColorBrush x:Key="Picked" Color="#EFF4FD" />
  <SolidColorBrush x:Key="OnPicked" Color="#2C60B8" />
  <!-- Where something dragged will land: the line, the ring and the card's outline, blue as in Asana. -->
  <SolidColorBrush x:Key="DropMark" Color="#4075CF" />
  <SolidColorBrush x:Key="Ink" Color="#050505" />
  <SolidColorBrush x:Key="Muted" Color="#636363" />

  <!-- Sidebar: a soft black, not pure black and not grey, with white text. -->
  <SolidColorBrush x:Key="Nav" Color="#F3F3F3" />
  <SolidColorBrush x:Key="NavHover" Color="#E6E6E6" />
  <SolidColorBrush x:Key="NavSelected" Color="#E0E0E0" />
  <SolidColorBrush x:Key="NavText" Color="#1E1E1E" />
  <SolidColorBrush x:Key="NavMuted" Color="#767676" />
  <!-- Dims the page behind the Ctrl+K search box. -->
  <SolidColorBrush x:Key="Scrim" Color="#66050505" />

  <SolidColorBrush x:Key="Primary" Color="#4075CF" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#2C60B8" />
  <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Attention" Color="#BE241E" />
  <SolidColorBrush x:Key="AttentionSoft" Color="#FFEBE8" />
  <SolidColorBrush x:Key="AttentionLine" Color="#FF998B" />
  <SolidColorBrush x:Key="InvoiceTint" Color="#2C60B8" />
  <SolidColorBrush x:Key="InvoiceSoft" Color="#EFF4FD" />
  <SolidColorBrush x:Key="QuoteTint" Color="#805BEE" />
  <SolidColorBrush x:Key="QuoteSoft" Color="#F3F3FF" />
  <SolidColorBrush x:Key="Ok" Color="#398548" />
  <SolidColorBrush x:Key="OkSoft" Color="#E6FFE6" />
  <SolidColorBrush x:Key="OkLine" Color="#ABF2B5" />

  <!-- Mail categories and the Important mark: dots and flags only, never backgrounds. No red or green here. -->
  <SolidColorBrush x:Key="CategoryBlue" Color="#4075CF" />
  <SolidColorBrush x:Key="CategoryPurple" Color="#805BEE" />
  <SolidColorBrush x:Key="CategoryOrange" Color="#DA6523" />
  <SolidColorBrush x:Key="CategoryYellow" Color="#C9A800" />
  <SolidColorBrush x:Key="CategoryTeal" Color="#199977" />
  <SolidColorBrush x:Key="CategoryPink" Color="#FC2E90" />
  <SolidColorBrush x:Key="CategoryGrey" Color="#888888" />
  <SolidColorBrush x:Key="Important" Color="#DA6523" />

  <!-- Project squares: Asana's 16 project colours, the same in light and dark, with a near-black picture on top.
       Red and green appear here only as a project's own colour; they still mean problem and done everywhere else. -->
  <SolidColorBrush x:Key="ProjectRed" Color="#FF8576" />
  <SolidColorBrush x:Key="ProjectOrange" Color="#FF9F4B" />
  <SolidColorBrush x:Key="ProjectYellowOrange" Color="#F7BD51" />
  <SolidColorBrush x:Key="ProjectYellow" Color="#FFD721" />
  <SolidColorBrush x:Key="ProjectYellowGreen" Color="#C3E684" />
  <SolidColorBrush x:Key="ProjectGreen" Color="#82D990" />
  <SolidColorBrush x:Key="ProjectBlueGreen" Color="#6AD8BC" />
  <SolidColorBrush x:Key="ProjectAqua" Color="#93F0D9" />
  <SolidColorBrush x:Key="ProjectBlue" Color="#8DB8FF" />
  <SolidColorBrush x:Key="ProjectIndigo" Color="#B8ACFF" />
  <SolidColorBrush x:Key="ProjectPurple" Color="#E39EF2" />
  <SolidColorBrush x:Key="ProjectMagenta" Color="#FFBEFF" />
  <SolidColorBrush x:Key="ProjectHotPink" Color="#FC96BF" />
  <SolidColorBrush x:Key="ProjectPink" Color="#FFC6BD" />
  <SolidColorBrush x:Key="ProjectCoolGrey" Color="#AAAAAA" />
  <SolidColorBrush x:Key="ProjectNone" Color="#D9D9D9" />
  <SolidColorBrush x:Key="OnProject" Color="#050505" />

  <!-- Depth: cards sit just above the page; cards you can click rise a little more under the mouse. -->
  <!-- Two layers: a tight edge and a soft spread, so cards sit on the page rather than float. -->
  <BoxShadows x:Key="CardShadow">0 1 4 0 #14767676</BoxShadows>
  <BoxShadows x:Key="CardShadowRaised">0 3 8 0 #1A767676, 0 6 12 0 #14767676</BoxShadows>
  <!-- Under things that float over the page: the Ctrl+K box, a note in the corner, the address suggestions. -->
  <BoxShadows x:Key="OverlayShadow">0 6 12 0 #1F767676, 0 12 32 0 #26767676</BoxShadows>
  <BoxShadows x:Key="PopupShadow">0 3 8 0 #1F767676</BoxShadows>
  <!-- Under a table heading pinned at the top while its rows scroll. -->
  <BoxShadows x:Key="HeadShadow">0 3 8 0 #1A767676</BoxShadows>

  <!-- Mark-up pens, drawn on client screenshots. Red marks what needs fixing. -->
  <Color x:Key="MarkRed">#E03131</Color>
  <Color x:Key="MarkYellow">#FCC419</Color>
  <Color x:Key="MarkBlue">#1971C2</Color>
  <!-- Round a numbered note, and its number: white, or black on the yellow pen. -->
  <Color x:Key="MarkOutline">#FFFFFF</Color>
  <Color x:Key="MarkOnYellow">#000000</Color>

  <!-- Fluent accent follows the primary colour, so focus rings and selections match. -->
  <Color x:Key="SystemAccentColor">#4075CF</Color>

  <!-- Notes in the window corner (new mail): white card with a soft black strip, like the sidebar. -->
  <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="#4075CF" />
  <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NotificationCardForegroundBrush" Color="#050505" />
</ResourceDictionary>
