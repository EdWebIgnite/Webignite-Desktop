<!--
  Dark palette "Midnight". Same names as Palette.axaml, so every screen picks these up when dark mode is on.
  Midnight: deep blue-grey, soft blue buttons. Red and green still mean "needs attention" and "done" only, a shade lighter so they read on dark.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Canvas" Color="#0F1520" />
  <SolidColorBrush x:Key="Surface" Color="#172030" />
  <!-- Behind a page of a PDF or a picture: white, as on paper, in every look. -->
  <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
  <!-- Writing on paper (the mail editor): the paper stays white in every palette, so its ink does too. -->
  <SolidColorBrush x:Key="PaperText" Color="#1F2A26" />
  <SolidColorBrush x:Key="PaperLine" Color="#C8CDD0" />
  <SolidColorBrush x:Key="PaperMuted" Color="#7A8580" />
  <SolidColorBrush x:Key="PaperShade" Color="#F4F5F5" />
  <SolidColorBrush x:Key="PaperLink" Color="#1A5FB4" />
  <SolidColorBrush x:Key="PaperSelection" Color="#B9D3F5" />
  <SolidColorBrush x:Key="Surface2" Color="#1C2738" />
  <SolidColorBrush x:Key="TableHead" Color="#1F2B3E" />
  <SolidColorBrush x:Key="Line" Color="#26344A" />
  <SolidColorBrush x:Key="Line2" Color="#36475F" />
  <SolidColorBrush x:Key="Text" Color="#DCE4F0" />
  <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Muted" Color="#8E9BB0" />

  <!-- Sidebar: a little darker than the page. -->
  <SolidColorBrush x:Key="Nav" Color="#0A0F18" />
  <SolidColorBrush x:Key="NavHover" Color="#131B28" />
  <SolidColorBrush x:Key="NavSelected" Color="#1F2B3E" />
  <SolidColorBrush x:Key="NavText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavMuted" Color="#7F8CA3" />
  <!-- Dims the page behind the Ctrl+K search box. -->
  <SolidColorBrush x:Key="Scrim" Color="#99000000" />

  <SolidColorBrush x:Key="Primary" Color="#8AAEF5" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#A9C4FA" />
  <SolidColorBrush x:Key="OnPrimary" Color="#0F1520" />

  <SolidColorBrush x:Key="Attention" Color="#F0907A" />
  <SolidColorBrush x:Key="AttentionSoft" Color="#3B231E" />
  <SolidColorBrush x:Key="AttentionLine" Color="#5C3329" />
  <SolidColorBrush x:Key="InvoiceTint" Color="#73B6D8" />
  <SolidColorBrush x:Key="InvoiceSoft" Color="#1A2C35" />
  <SolidColorBrush x:Key="QuoteTint" Color="#B79DE2" />
  <SolidColorBrush x:Key="QuoteSoft" Color="#2A2339" />
  <SolidColorBrush x:Key="Ok" Color="#62C593" />
  <SolidColorBrush x:Key="OkSoft" Color="#18301F" />
  <SolidColorBrush x:Key="OkLine" Color="#255238" />

  <!-- Mail categories and the Important mark: dots and flags only, never backgrounds. No red or green here. -->
  <SolidColorBrush x:Key="CategoryBlue" Color="#4A9EFF" />
  <SolidColorBrush x:Key="CategoryPurple" Color="#C17BEA" />
  <SolidColorBrush x:Key="CategoryOrange" Color="#FFA733" />
  <SolidColorBrush x:Key="CategoryYellow" Color="#FFD633" />
  <SolidColorBrush x:Key="CategoryTeal" Color="#4CC4D8" />
  <SolidColorBrush x:Key="CategoryPink" Color="#F06AAE" />
  <SolidColorBrush x:Key="CategoryGrey" Color="#9C9CA3" />
  <SolidColorBrush x:Key="Important" Color="#FFA733" />

  <!-- Depth: cards sit just above the page; cards you can click rise a little more under the mouse. -->
  <BoxShadows x:Key="CardShadow">0 1 2 0 #40000000, 0 4 14 0 #33000000</BoxShadows>
  <BoxShadows x:Key="CardShadowRaised">0 2 4 0 #4D000000, 0 10 24 0 #80000000</BoxShadows>
  <!-- Under things that float over the page: the Ctrl+K box, a note in the corner, the address suggestions. -->
  <BoxShadows x:Key="OverlayShadow">0 12 32 0 #99000000</BoxShadows>
  <BoxShadows x:Key="PopupShadow">0 6 18 0 #80000000</BoxShadows>
  <BoxShadows x:Key="HeadShadow">0 3 8 0 #73000000</BoxShadows>

  <!-- Mark-up pens, drawn on client screenshots. Red marks what needs fixing. -->
  <Color x:Key="MarkRed">#E03131</Color>
  <Color x:Key="MarkYellow">#FCC419</Color>
  <Color x:Key="MarkBlue">#1971C2</Color>
  <!-- Round a numbered note, and its number: white, or black on the yellow pen. -->
  <Color x:Key="MarkOutline">#FFFFFF</Color>
  <Color x:Key="MarkOnYellow">#000000</Color>

  <!-- Fluent accent follows the primary colour, so focus rings and selections match. -->
  <Color x:Key="SystemAccentColor">#8AAEF5</Color>

  <!-- Notes in the window corner: a raised dark card with a strip in the button colour. -->
  <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="#8AAEF5" />
  <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Color="#1C2738" />
  <SolidColorBrush x:Key="NotificationCardForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
