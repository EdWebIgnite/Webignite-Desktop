<!-- Shared look for agenda items: a coloured bar by kind (event, to-do, quote, invoice). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Background" Value="{DynamicResource OkSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="Border.chip.task">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
  </Style>
  <Style Selector="Border.chip.quote">
    <Setter Property="Background" Value="{DynamicResource QuoteSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QuoteTint}" />
  </Style>
  <Style Selector="Border.chip.invoice">
    <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InvoiceTint}" />
  </Style>
  <Style Selector="Border.chip.done TextBlock">
    <Setter Property="TextDecorations" Value="Strikethrough" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style Selector="Button.day">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.day:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.day.other">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
  </Style>
  <Style Selector="Button.day.other TextBlock.daynum">
    <Setter Property="Foreground" Value="{DynamicResource Line2}" />
  </Style>
  <Style Selector="Button.day.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.todaydot">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>
  <Style Selector="TextBlock.daynum.today">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
  </Style>
  <Style Selector="Border.card.today">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
