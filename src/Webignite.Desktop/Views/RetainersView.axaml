<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.RetainersView"
             x:DataType="vm:RetainersViewModel">
  <Panel>
    <ContentControl Content="{Binding Editor}" IsVisible="{Binding !IsListing}" />

    <StackPanel Spacing="18" IsVisible="{Binding IsListing}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{StaticResource Icon.Plus}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="New retainer" />
          </StackPanel>
        </Button>
        <Button DockPanel.Dock="Right" Classes="quiet" Content="From Xero's repeating invoices" Command="{Binding ShowXeroRepeatingCommand}"
                VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="{Binding !ReadingRepeating}"
                ToolTip.Tip="Brings repeating invoices set up in Xero over as retainers, so Webignite drafts them instead." />
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Retainers" />
          <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
        </StackPanel>
      </DockPanel>

      <Border Classes="card" IsVisible="{Binding ShowingRepeating}">
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding HideXeroRepeatingCommand}" VerticalAlignment="Top" />
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="REPEATING INVOICES IN XERO" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Text="{Binding RepeatingNote}" />
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Repeating}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RepeatingRowViewModel">
                <DockPanel Margin="0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Classes="amount" Text="{Binding Amount}" VerticalAlignment="Center" />
                    <Button Classes="quiet" Content="Make it a retainer" Command="{Binding MakeCommand}" IsVisible="{Binding CanMake}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding WhyNot}" IsVisible="{Binding !CanMake}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Client}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Title}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Schedule}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="ready" IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Retainers}" Title="No retainers yet"
                    Text="Set up a monthly fee once, and the invoice is drafted on this PC each month for you to check and send."
                    ActionText="New retainer" Command="{Binding NewCommand}" />

      <Border Classes="card" Padding="0" IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RetainerRowViewModel">
              <Border Classes="taskrow" Padding="20,12,12,12">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Change" Command="{Binding EditCommand}" />
                    <MenuItem Header="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" />
                    <Separator />
                    <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <c:Monogram Text="{Binding Client}" Size="34" VerticalAlignment="Top" Margin="0,2,0,0" Classes.dim="{Binding IsPaused}" />
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Client}" FontWeight="SemiBold" Classes.muted="{Binding IsPaused}" />
                      <TextBlock Text="{Binding Title}" Classes.muted="{Binding IsPaused}" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Schedule}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="amount" Classes.muted="{Binding IsPaused}" Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0,16,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Stop goes at once; the note in the corner undoes it. -->
                    <Button Classes="link" Content="Change" Command="{Binding EditCommand}" />
                    <Button Classes="link" Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" />
                    <Button Classes="link" Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stops it. Drafted invoices stay. You can undo it for a few seconds." />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </Panel>
</UserControl>
