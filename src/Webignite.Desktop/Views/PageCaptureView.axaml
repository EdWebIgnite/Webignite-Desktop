<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.PageCaptureView"
             x:DataType="vm:ToolsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.pagepane">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.grouphead">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="WrapPanel.choices > :is(Control)">
      <Setter Property="Margin" Value="0,0,12,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The address -->
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Classes="primary" Content="Open" Margin="8,0,0,0" IsDefault="True"
              Command="{Binding OpenCapturePageCommand}" />
      <TextBox x:Name="AddressBox" Text="{Binding CaptureAddress}" PlaceholderText="karoocoffee.co.za" />
    </DockPanel>

    <!-- What the page is, or what went wrong, with what was last saved -->
    <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" MinHeight="22">
      <Button DockPanel.Dock="Right" Classes="link" Content="Show it in Files" Click="ShowInFiles"
              IsVisible="{Binding HasCaptured}" Margin="12,0,0,0" />
      <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="90" Margin="12,0,0,0" VerticalAlignment="Center"
                   IsVisible="{Binding CaptureWorking}" />
      <TextBlock Classes="muted" Classes.problem="{Binding CaptureProblem}" FontSize="{DynamicResource Text12}"
                 Text="{Binding CaptureNote}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>

    <!-- Save as PDF -->
    <WrapPanel DockPanel.Dock="Top" Classes="choices" Margin="0,10,0,0">
      <TextBlock Classes="grouphead" Text="PDF" Width="64" />
      <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding Paper}" Width="130" />
      <CheckBox Content="Sideways" IsChecked="{Binding PdfSideways}" />
      <CheckBox Content="Backgrounds" ToolTip.Tip="Keeps the page's background colours and pictures, as on screen. Untick to save ink when it will be printed." IsChecked="{Binding PdfBackgrounds}" />
      <Button Content="Save as PDF" Command="{Binding SavePagePdfCommand}" CommandParameter="{Binding $self}" />
    </WrapPanel>

    <!-- Pictures -->
    <WrapPanel DockPanel.Dock="Top" Classes="choices" Margin="0,2,0,0">
      <TextBlock Classes="grouphead" Text="Pictures" Width="64" />
      <ItemsControl ItemsSource="{Binding CaptureScreens}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenChoice">
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <CheckBox Content="Whole page" ToolTip.Tip="From the top of the page to the bottom, not only what fits on the screen" IsChecked="{Binding CaptureWholePage}" />
      <Button Content="Save pictures" Command="{Binding SavePagePicturesCommand}" CommandParameter="{Binding $self}" />
      <Button Classes="quiet" Content="Open in Mark-up" Click="OpenInMarkup" IsEnabled="{Binding CaptureReady}"
              ToolTip.Tip="Takes a picture at the first ticked screen and opens it in Mark-up to draw on" />
    </WrapPanel>

    <!-- The page -->
    <Border Classes="pagepane" Margin="0,8,0,0">
      <Panel>
        <ContentControl Content="{Binding CaptureView}" IsVisible="{Binding HasCaptureView}" />
        <StackPanel Spacing="12" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsVisible="{Binding CaptureWithout, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding CaptureWithout}" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Classes="primary" Content="Get WebView2 from Microsoft" HorizontalAlignment="Center"
                  Command="{Binding GetWebView2Command}" IsVisible="{Binding CaptureNeedsWebView2}" />
        </StackPanel>
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
