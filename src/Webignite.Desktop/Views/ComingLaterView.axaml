<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.ComingLaterView"
             x:DataType="vm:ComingLaterViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{Binding Title}" />
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="Not built yet" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
