<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:core="using:Webignite.Core.Mail"
             xmlns:html="using:TheArtOfDev.HtmlRenderer.Avalonia"
             x:Class="Webignite.Desktop.Views.ComposeView"
             x:DataType="vm:ComposeViewModel">
  <Panel x:Name="Root" DragDrop.AllowDrop="True" Background="Transparent">
  <DockPanel>
    <!-- Header and address fields -->
    <StackPanel DockPanel.Dock="Top" Margin="24,18,24,8" Spacing="8">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding CloseCommand}" />
        <TextBlock Classes="h2" Text="{Binding Heading}" />
      </DockPanel>

      <DockPanel IsVisible="{Binding ManyAccounts}">
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="From" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding From}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:MailAccount">
              <TextBlock><Run Text="{Binding DisplayName}" /><Run Text="  " /><Run Text="{Binding Address}" Foreground="{DynamicResource Muted}" /></TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="To" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Classes="link" Content="Cc, Bcc, Reply-To" Command="{Binding ToggleCcCommand}" IsVisible="{Binding !ShowCc}" />
        <Button x:Name="PeopleButton" DockPanel.Dock="Right" Classes="quiet icon" Margin="6,0,4,0" ToolTip.Tip="Contacts: pick people and groups">
          <c:Icon Data="{StaticResource Icon.Contacts}" Size="16" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opening="PeopleOpening">
              <StackPanel Width="380" Spacing="8">
                <TextBox x:Name="PeopleSearchBox" Text="{Binding PeopleSearch}" PlaceholderText="Search people and groups" />
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoPeopleToPick}"
                           Text="Nobody with an email address matches. Add people on the Contacts page." />
                <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding PeopleToPick}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PickPersonRow">
                        <DockPanel Margin="0,2">
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="link" Content="To" Command="{Binding AddToCommand}" />
                            <Button Classes="link" Content="Cc" Command="{Binding AddCcCommand}" />
                            <Button Classes="link" Content="Bcc" Command="{Binding AddBccCommand}" />
                          </StackPanel>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBox x:Name="ToBox" Text="{Binding To}" PlaceholderText="Type a name or address" />
      </DockPanel>
      <DockPanel IsVisible="{Binding ShowCc}">
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="Cc" VerticalAlignment="Center" />
        <TextBox x:Name="CcBox" Text="{Binding Cc}" />
      </DockPanel>
      <DockPanel IsVisible="{Binding ShowCc}">
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="Bcc" VerticalAlignment="Center" />
        <TextBox x:Name="BccBox" Text="{Binding Bcc}" PlaceholderText="Get a copy without the others seeing" />
      </DockPanel>
      <DockPanel IsVisible="{Binding ShowCc}">
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="Reply-To" VerticalAlignment="Center" />
        <TextBox x:Name="ReplyToBox" Text="{Binding ReplyTo}" PlaceholderText="Where replies go, when not to you" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Width="64" Classes="muted" Text="Subject" VerticalAlignment="Center" />
        <TextBox Text="{Binding Subject}" />
      </DockPanel>

      <DockPanel>
        <Button DockPanel.Dock="Left" Classes="quiet" Content="Attach files" Click="OnAttach" VerticalAlignment="Top" Margin="0,0,10,0" />
        <TextBlock DockPanel.Dock="Left" Classes="muted" FontSize="11" Text="or drop files here" VerticalAlignment="Top" Margin="0,9,10,0"
                   IsVisible="{Binding !HasAttachments}" />
        <ItemsControl ItemsSource="{Binding Attachments}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComposeAttachmentViewModel">
              <Border Classes="card" Padding="10,4" Margin="0,0,8,6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Size}" VerticalAlignment="Center" />
                  <Button Classes="link" Content="Remove" Command="{Binding RemoveCommand}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </StackPanel>

    <!-- Send bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel Spacing="8">
        <Border Classes="card" Padding="12,8" IsVisible="{Binding AskingAboutAttachment}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <Button Classes="quiet" Content="Send without" Command="{Binding SendAnywayCommand}" />
              <Button Classes="link" Content="I'll attach it" Command="{Binding AddAttachmentFirstCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="The mail mentions an attachment, but nothing is attached." />
          </DockPanel>
        </Border>
        <Border Classes="card" Padding="12,8" IsVisible="{Binding PickingSendTime}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Send on" VerticalAlignment="Center" />
            <CalendarDatePicker SelectedDate="{Binding SendDay}" DisplayDateStart="{x:Static sys:DateTime.Today}" Width="160"
                                SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" />
            <ComboBox ItemsSource="{x:Static vm:MailViewModel.SnoozeHours}" SelectedItem="{Binding SendHour}" Width="100">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:Int32">
                  <TextBlock Text="{Binding StringFormat='{}{0:00}:00'}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="primary" Content="Set" Command="{Binding ConfirmSendLaterCommand}" />
            <Button Classes="link" Content="Cancel" Command="{Binding CancelSendLaterCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="12,8" IsVisible="{Binding AskingToDiscard}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <Button Classes="quiet" Content="Save draft" Command="{Binding SaveAndCloseCommand}" />
              <Button Classes="quiet" Content="Throw away" Command="{Binding DiscardCommand}" />
              <Button Classes="link" Content="Keep writing" Command="{Binding KeepWritingCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Keep this as a draft?" />
          </DockPanel>
        </Border>
        <!-- Save draft on the left; Send far right with Send later beside it. -->
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="Save draft" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding !IsWorking}" />
            <c:Spinner IsVisible="{Binding IsWorking}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" IsEnabled="{Binding !IsWorking}" IsVisible="{Binding CanSendLater}" ToolTip.Tip="Send at a time you pick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Send later" />
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight" Opening="SendLaterOpening" />
              </Button.Flyout>
            </Button>
            <Button Classes="primary" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding !IsWorking}" />
          </StackPanel>
          <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                     Classes="muted" Classes.problem="{Binding MessageIsProblem}" Text="{Binding Message}" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- The earlier message, folded away until asked for -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,8" IsVisible="{Binding HasQuote}" Spacing="6">
      <Button Classes="link" Command="{Binding ToggleQuoteCommand}" HorizontalAlignment="Left">
        <Panel>
          <TextBlock Text="Show the earlier message (it goes with the mail)" IsVisible="{Binding !ShowQuote}" />
          <TextBlock Text="Hide the earlier message" IsVisible="{Binding ShowQuote}" />
        </Panel>
      </Button>
      <!-- Mail is shown on paper white in every look, as it was written to be read. -->
      <Border Classes="card" Padding="12" MaxHeight="260" Background="{DynamicResource Paper}" IsVisible="{Binding ShowQuote}">
        <ScrollViewer>
          <html:HtmlPanel Text="{Binding QuoteHtml}" Background="{DynamicResource Paper}" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <!-- What you type, on paper, with the format bar above it -->
    <DockPanel Margin="24,4,24,8">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
        <WrapPanel x:Name="FormatBar" ItemSpacing="4" LineSpacing="4">
          <ComboBox x:Name="StyleBox" Width="122" Focusable="False" ToolTip.Tip="Paragraph, heading, quote or code" SelectionChanged="StyleChosen">
            <ComboBoxItem Content="Paragraph" Tag="Paragraph" />
            <ComboBoxItem Content="Heading 1" Tag="Heading1" />
            <ComboBoxItem Content="Heading 2" Tag="Heading2" />
            <ComboBoxItem Content="Heading 3" Tag="Heading3" />
            <ComboBoxItem Content="Quote" Tag="Quote" />
            <ComboBoxItem Content="Code" Tag="Code" />
          </ComboBox>
          <ComboBox x:Name="FontBox" Width="128" Focusable="False" ToolTip.Tip="Font" SelectionChanged="FontChosen">
            <ComboBoxItem Content="Normal font" />
            <ComboBoxItem Content="Fixed width" />
          </ComboBox>
          <ComboBox x:Name="SizeBox" Width="104" Focusable="False" ToolTip.Tip="Text size" SelectionChanged="SizeChosen" />
          <Button Classes="quiet format" Focusable="False" Tag="smaller" Click="Format" ToolTip.Tip="Smaller (Ctrl+[)" Content="A−" />
          <Button Classes="quiet format" Focusable="False" Tag="larger" Click="Format" ToolTip.Tip="Larger (Ctrl+])" Content="A+" />
          <Button Classes="quiet format icon" Focusable="False" ToolTip.Tip="Text colour">
            <c:Icon Data="{StaticResource Icon.TextColour}" Size="16" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6">
                  <ItemsControl x:Name="TextColourList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="200" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Button Classes="link" Content="Normal colour" Tag="colour:" Click="Format" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="quiet format icon" Focusable="False" ToolTip.Tip="Highlight">
            <c:Icon Data="{StaticResource Icon.Highlight}" Size="16" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Spacing="6">
                  <ItemsControl x:Name="HighlightList">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="200" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Button Classes="link" Content="No highlight" Tag="highlight:" Click="Format" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="BoldButton" Classes="quiet format icon" Focusable="False" Tag="bold" Click="Format" ToolTip.Tip="Bold (Ctrl+B)">
            <c:Icon Data="{StaticResource Icon.Bold}" Size="16" />
          </Button>
          <Button x:Name="ItalicButton" Classes="quiet format icon" Focusable="False" Tag="italic" Click="Format" ToolTip.Tip="Italic (Ctrl+I)">
            <c:Icon Data="{StaticResource Icon.Italic}" Size="16" />
          </Button>
          <Button x:Name="UnderlineButton" Classes="quiet format icon" Focusable="False" Tag="underline" Click="Format" ToolTip.Tip="Underline (Ctrl+U)">
            <c:Icon Data="{StaticResource Icon.Underline}" Size="16" />
          </Button>
          <Button Classes="quiet format icon" Focusable="False" Tag="clear" Click="Format" ToolTip.Tip="Remove formatting (Ctrl+Space)">
            <c:Icon Data="{StaticResource Icon.ClearFormat}" Size="16" />
          </Button>
          <Button x:Name="BulletsButton" Classes="quiet format icon" Focusable="False" Tag="bullets" Click="Format" ToolTip.Tip="Bulleted list">
            <c:Icon Data="{StaticResource Icon.Bullets}" Size="16" />
          </Button>
          <Button x:Name="NumbersButton" Classes="quiet format icon" Focusable="False" Tag="numbers" Click="Format" ToolTip.Tip="Numbered list">
            <c:Icon Data="{StaticResource Icon.Numbers}" Size="16" />
          </Button>
          <Button Classes="quiet format icon" Focusable="False" Tag="outdent" Click="Format" ToolTip.Tip="Indent less">
            <c:Icon Data="{StaticResource Icon.IndentLess}" Size="16" />
          </Button>
          <Button Classes="quiet format icon" Focusable="False" Tag="indent" Click="Format" ToolTip.Tip="Indent more">
            <c:Icon Data="{StaticResource Icon.IndentMore}" Size="16" />
          </Button>
          <Button x:Name="LeftButton" Classes="quiet format icon" Focusable="False" Tag="left" Click="Format" ToolTip.Tip="Align left">
            <c:Icon Data="{StaticResource Icon.AlignLeft}" Size="16" />
          </Button>
          <Button x:Name="CentreButton" Classes="quiet format icon" Focusable="False" Tag="centre" Click="Format" ToolTip.Tip="Centre">
            <c:Icon Data="{StaticResource Icon.AlignCentre}" Size="16" />
          </Button>
          <Button x:Name="RightButton" Classes="quiet format icon" Focusable="False" Tag="right" Click="Format" ToolTip.Tip="Align right">
            <c:Icon Data="{StaticResource Icon.AlignRight}" Size="16" />
          </Button>
          <Button Classes="quiet format icon" Focusable="False" Click="LinkClicked" ToolTip.Tip="Link the selected words to a web page or address">
            <c:Icon Data="{StaticResource Icon.Link}" Size="16" />
          </Button>
          <Button Classes="quiet format" Focusable="False" ToolTip.Tip="A picture, table, line or emoji">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Insert" />
              <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Picture…" Click="InsertPicture">
                  <MenuItem.Icon><c:Icon Data="{StaticResource Icon.Picture}" Size="14" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Table">
                  <MenuItem.Icon><c:Icon Data="{StaticResource Icon.Table}" Size="14" /></MenuItem.Icon>
                  <MenuItem Header="2 columns, 2 rows" Tag="2x2" Click="InsertTable" />
                  <MenuItem Header="3 columns, 3 rows" Tag="3x3" Click="InsertTable" />
                  <MenuItem Header="4 columns, 3 rows" Tag="3x4" Click="InsertTable" />
                  <Separator />
                  <MenuItem Header="Add a row" Tag="row" Click="InsertTable" />
                  <MenuItem Header="Add a column" Tag="column" Click="InsertTable" />
                </MenuItem>
                <MenuItem Header="Horizontal line" Click="InsertRule">
                  <MenuItem.Icon><c:Icon Data="{StaticResource Icon.Rule}" Size="14" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="quiet format icon" Focusable="False" ToolTip.Tip="Emoji">
            <c:Icon Data="{StaticResource Icon.Emoji}" Size="16" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl x:Name="EmojiList">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="290" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="quiet format" Focusable="False" ToolTip.Tip="Text you write often, with the client's name filled in">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Saved replies" />
              <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="RepliesOpening" />
            </Button.Flyout>
          </Button>
          <Button Classes="quiet format" Focusable="False" ToolTip.Tip="Whole mails kept to start others from">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Templates" />
              <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="TemplatesOpening" />
            </Button.Flyout>
          </Button>
        </WrapPanel>
        <Border Classes="card" Padding="10,6" IsVisible="{Binding AskingTemplateName}">
          <StackPanel Spacing="4">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Classes="primary" Content="Save template" Command="{Binding SaveTemplateCommand}" />
                <Button Classes="link" Content="Cancel" Command="{Binding CancelSaveTemplateCommand}" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Classes="muted" Text="Call it" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="TemplateNameBox" Text="{Binding TemplateName}" PlaceholderText="e.g. Monthly maintenance report" />
            </DockPanel>
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Keeps To, Cc, the subject and the writing, without your signature. Type {name} or {client} where they should be filled in." />
            <TextBlock Classes="problem" FontSize="12" Text="{Binding TemplateProblem}" IsVisible="{Binding HasTemplateProblem}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="10,6" IsVisible="{Binding AskingReplyName}">
          <StackPanel Spacing="4">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Classes="primary" Content="Save reply" Command="{Binding SaveReplyCommand}" />
                <Button Classes="link" Content="Cancel" Command="{Binding CancelSaveReplyCommand}" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Classes="muted" Text="Call it" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="ReplyNameBox" Text="{Binding ReplyName}" PlaceholderText="e.g. Payment received" />
            </DockPanel>
            <TextBlock Classes="problem" FontSize="12" Text="{Binding ReplyProblem}" IsVisible="{Binding HasReplyProblem}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="10,6" IsVisible="{Binding AskingForLink}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
              <Button Classes="primary" Content="Add link" Click="AddLinkClicked" />
              <Button Classes="link" Content="Remove link" Click="RemoveLinkClicked" />
              <Button Classes="link" Content="Cancel" Click="CancelLinkClicked" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Classes="muted" Text="Link to" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="LinkBox" Text="{Binding LinkAddress}" PlaceholderText="www.example.co.za or an email address" />
          </DockPanel>
        </Border>
      </StackPanel>
      <Border Classes="paper" ClipToBounds="True">
        <ScrollViewer x:Name="BodyScroll" HorizontalScrollBarVisibility="Disabled">
          <c:RichTextEditor x:Name="Editor" Document="{Binding Document}" Revision="{Binding BodyRevision}" Placeholder="Write your mail" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </DockPanel>
  <!-- Suggestions under whichever address box is being typed in -->
  <Popup x:Name="SuggestionsPopup" IsOpen="{Binding HasSuggestions}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False">
    <Border Classes="card" Padding="4" MinWidth="320" BoxShadow="{DynamicResource PopupShadow}">
      <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding ChosenSuggestion}" Background="Transparent"
               Tapped="SuggestionTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:Contact">
            <StackPanel Margin="2,1">
              <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" FontSize="11" Text="Adds everyone in the group" IsVisible="{Binding IsGroup}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Popup>
  </Panel>
</UserControl>
