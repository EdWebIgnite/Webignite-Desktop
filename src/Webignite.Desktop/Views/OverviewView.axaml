<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <UserControl.Styles>
    <!-- Needs you stays calm: a line's action and its extra links show only while the pointer is on the line. -->
    <Style Selector="DockPanel.needsrow > Button.needsextra">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DockPanel.needsrow:pointerover > Button.needsextra">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.needsline">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="-10,0,0,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="22">
    <StackPanel Spacing="4">
      <TextBlock Classes="h1" Text="{Binding Greeting}" />
      <TextBlock Classes="muted" Text="{Binding TodayText}" />
    </StackPanel>

    <UniformGrid Columns="4">
      <Border Classes="card" Margin="0,0,9,0">
        <StackPanel Spacing="6">
          <DockPanel>
            <c:Icon DockPanel.Dock="Right" Classes="cardicon" Data="{StaticResource Icon.Reports}" />
            <TextBlock Classes="label" Text="CAME IN THIS MONTH" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="figure" Text="{Binding CameIn}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding CameInLine}" TextWrapping="Wrap" />
          <c:Sparkline Values="{Binding CameInTrend}" Stroke="{DynamicResource InvoiceTint}" Height="28" Margin="0,4,0,0"
                       ToolTip.Tip="The last six months, this one so far on the right" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="3,0,6,0">
        <StackPanel Spacing="6">
          <DockPanel>
            <c:Icon DockPanel.Dock="Right" Classes="cardicon" Data="{StaticResource Icon.Money}" />
            <TextBlock Classes="label" Text="OWED TO YOU" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="figure" Text="{Binding Owed}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding OwedLine}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding PaymentsText}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding BillsLine}" TextWrapping="Wrap" IsVisible="{Binding HasBillsLine}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding XeroConnected}">
            <Button Classes="quiet" Content="Check payments now" Command="{Binding CheckPaymentsNowCommand}"
                    IsEnabled="{Binding !CheckingPayments}" HorizontalAlignment="Left" Padding="0,2" FontSize="{DynamicResource Text12}" />
            <c:Spinner IsVisible="{Binding CheckingPayments}" Size="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0,3,0">
        <StackPanel Spacing="6">
          <DockPanel>
            <c:Icon DockPanel.Dock="Right" Classes="cardicon" Data="{StaticResource Icon.Alert}" />
            <TextBlock Classes="label" Text="OVERDUE" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="figure" Text="{Binding Overdue}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding OverdueLine}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="9,0,0,0">
        <StackPanel Spacing="6">
          <DockPanel>
            <c:Icon DockPanel.Dock="Right" Classes="cardicon" Data="{StaticResource Icon.Quotes}" />
            <TextBlock Classes="label" Text="QUOTES OUT" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="figure" Text="{Binding QuotesOut}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding QuotesLine}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- One above the other; side by side on a wide screen (see the code). -->
    <Grid x:Name="Lower" ColumnDefinitions="*" RowDefinitions="Auto,Auto">
    <Border x:Name="NeedsCard" Classes="card" IsVisible="{Binding HasSummary}" VerticalAlignment="Top">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:Icon Classes="cardicon" Data="{StaticResource Icon.Bell}" />
          <TextBlock Classes="h2" Text="Needs you" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Summary}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SummaryLineViewModel">
              <!-- The whole line opens what it's about; its action and No reply needed show while the pointer is on it. -->
              <DockPanel Classes="needsrow">
                <Button DockPanel.Dock="Right" Classes="link needsextra" Content="No reply needed" Margin="10,0,0,0" IsVisible="{Binding CanWaveOff}"
                        Command="{Binding NoReplyNeededCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Takes it off this list. It comes back if they write again." />
                <Button DockPanel.Dock="Right" Classes="link needsextra" Content="{Binding Action}" Command="{Binding OpenCommand}" IsEnabled="{Binding !Busy}"
                        FontSize="{DynamicResource Text12}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Button Classes="row needsline" Command="{Binding OpenCommand}" IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ToolTip.Tip="{Binding Action}">
                  <DockPanel>
                    <c:Spinner DockPanel.Dock="Right" IsVisible="{Binding Busy}" Size="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0" />
                    <Ellipse DockPanel.Dock="Left" Classes="dot" Classes.problem="{Binding Problem}" Margin="2,0,12,0" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.problem="{Binding Problem}" />
                  </DockPanel>
                </Button>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Classes="link" Content="{Binding MoreSummaryText}" Command="{Binding ToggleSummaryCommand}" IsVisible="{Binding HasMoreSummary}"
                HorizontalAlignment="Left" Margin="10,2,0,0" />
      </StackPanel>
    </Border>

    <Border x:Name="TodayCard" Classes="card" Grid.Row="1" VerticalAlignment="Top">
      <StackPanel Spacing="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding OverdueText}" IsVisible="{Binding HasOverdue}"
                     Foreground="{DynamicResource Attention}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Classes="cardicon" Data="{StaticResource Icon.Calendar}" />
            <TextBlock Classes="h2" Text="Today" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
        <TextBlock Classes="muted" Text="Nothing booked or due today." IsVisible="{Binding TodayIsEmpty}" />
        <ItemsControl ItemsSource="{Binding Today}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgendaItemViewModel">
              <c:AgendaChip Padding="10,7" Margin="0,0,0,6">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding KindLabel}" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="52" IsVisible="{Binding HasTime}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                </DockPanel>
              </c:AgendaChip>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    </Grid>
  </StackPanel>
</UserControl>
