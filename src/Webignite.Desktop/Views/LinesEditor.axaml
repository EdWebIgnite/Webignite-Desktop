<!-- The lines table on quotes, invoices and retainers: item, description, quantity, price, amount. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:v="using:Webignite.Desktop.Views"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.LinesEditor"
             x:DataType="v:LinesEditor"
             x:Name="Self">
  <StackPanel>
    <Border Classes="stickyhead">
      <Grid ColumnDefinitions="200,*,90,130,130,44">
        <TextBlock Grid.Column="0" Classes="label" Text="Item" Margin="20,0,0,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="label" Text="Description" Margin="8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="label" Text="Qty" Margin="8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Classes="label" Text="Price" Margin="8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="label" Text="Amount" Margin="8,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <ItemsControl ItemsSource="{Binding #Self.Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LineRowViewModel">
          <Grid ColumnDefinitions="200,*,90,130,130,44" Margin="12,8,4,0">
            <TextBox Grid.Column="0" Text="{Binding Item}" PlaceholderText="e.g. WordPress setup" MaxLength="50" Margin="0,0,8,0"
                     ToolTip.Tip="Shown in Xero's Item column. Webignite adds it to Xero's Products and Services if it isn't there yet." />
            <TextBox Grid.Column="1" Text="{Binding Description}" PlaceholderText="{Binding $parent[v:LinesEditor].Placeholder}" TextWrapping="Wrap" Margin="0,0,8,0" />
            <TextBox Grid.Column="2" Text="{Binding Quantity}" LostFocus="SettleSum" HorizontalContentAlignment="Right" Margin="0,0,8,0" />
            <TextBox Grid.Column="3" Text="{Binding Price}" PlaceholderText="0.00" LostFocus="SettleSum"
                     ToolTip.Tip="Type an amount, or a sum like 3.5 x 650" HorizontalContentAlignment="Right" Margin="0,0,8,0" />
            <TextBlock Grid.Column="4" Classes="amount" Text="{Binding AmountText}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="5" Classes="link" ToolTip.Tip="Remove line"
                    Command="{Binding $parent[v:LinesEditor].RemoveCommand}" CommandParameter="{Binding}">
              <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
            </Button>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
