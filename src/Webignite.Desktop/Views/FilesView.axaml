<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:files="using:Webignite.Core.Files"
             xmlns:filesops="using:Webignite.Desktop.Files"
             x:Class="Webignite.Desktop.Views.FilesView"
             x:DataType="vm:FilesViewModel">
  <UserControl.Resources>
    <!-- A tag's dot, as in Finder. -->
    <DataTemplate x:Key="TagDot" x:DataType="files:FileTag">
      <c:CategoryDot Colour="{Binding Colour}" Size="9" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid ColumnDefinitions="220,*">
    <!-- Side list: client folders, the usual folders, every drive -->
    <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Places}" Margin="10,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilePlaceGroup">
              <StackPanel Margin="0,0,0,14" Spacing="2">
                <TextBlock Text="{Binding Title}" Classes="label" Margin="10,0,0,4" FontSize="10.5" LetterSpacing="0.6" />
                <ItemsControl ItemsSource="{Binding Places}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilePlace">
                      <Button Classes="place" Command="{Binding GoCommand}" ToolTip.Tip="{Binding Path}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              ContextRequested="PlaceMenu">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Panel Width="16" VerticalAlignment="Center">
                            <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="16" IsVisible="{Binding !HasColour}" />
                            <c:CategoryDot Colour="{Binding Colour}" Size="10" IsVisible="{Binding HasColour}" HorizontalAlignment="Center" />
                          </Panel>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Column="1">
      <!-- Back, forward, up, the address bar, and how the folder is shown -->
      <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0">
            <Button Classes="quiet format icon" Command="{Binding BackCommand}" ToolTip.Tip="Back (Alt+Left)"><c:Icon Data="{StaticResource Icon.Back}" Size="16" /></Button>
            <Button Classes="quiet format icon" Command="{Binding ForwardCommand}" ToolTip.Tip="Forward (Alt+Right)"><c:Icon Data="{StaticResource Icon.Forward}" Size="16" /></Button>
            <Button Classes="quiet format icon" Command="{Binding UpCommand}" ToolTip.Tip="Up a folder (Alt+Up)"><c:Icon Data="{StaticResource Icon.Up}" Size="16" /></Button>
          </StackPanel>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Classes="search" Width="240" Margin="10,0,0,0" Text="{Binding SearchText}"
                   PlaceholderText="Search here and below (Ctrl+F)" KeyDown="SearchKeys" VerticalContentAlignment="Center">
            <TextBox.InnerLeftContent>
              <c:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="8,0,0,0" Opacity="0.6" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <!-- The address: each folder on the way, clickable; click the empty part to type a path. -->
          <Border Classes="address">
            <Panel>
              <DockPanel IsVisible="{Binding !EditingAddress}" Background="Transparent" PointerPressed="AddressPressed">
                <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FileCrumb">
                        <StackPanel Orientation="Horizontal">
                          <Button Classes="link crumb" Content="{Binding Name}" Command="{Binding GoCommand}" PointerReleased="CrumbReleased" />
                          <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" VerticalAlignment="Center" Opacity="0.5" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
              <TextBox x:Name="AddressBox" Text="{Binding AddressText}" IsVisible="{Binding EditingAddress}" BorderThickness="0" Padding="8,5"
                       KeyDown="AddressKeys" LostFocus="AddressLost" />
            </Panel>
          </Border>
        </DockPanel>
      </Border>

      <!-- What to do here and how the folder is shown; the details pane on the right -->
      <Border DockPanel.Dock="Top" Padding="14,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <CheckBox Content="Words inside files" IsChecked="{Binding SearchInside}" IsVisible="{Binding IsSearching}" VerticalAlignment="Center"
                      ToolTip.Tip="Also look inside PDFs, Word documents and text files. Slower." />
            <Button Classes="quiet format icon" Classes.on="{Binding ShowDetails}" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="Details pane: preview, size and dates">
              <c:Icon Data="{StaticResource Icon.PanelRight}" Size="16" />
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="quiet format icon" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder (Ctrl+Shift+N)" IsVisible="{Binding !IsGathered}"><c:Icon Data="{StaticResource Icon.FolderPlus}" Size="16" /></Button>
            <Button Classes="quiet format icon" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoText}"><c:Icon Data="{StaticResource Icon.Undo}" Size="16" /></Button>
            <Border Width="1" Background="{DynamicResource Line}" Margin="6,4" />
            <Button Classes="quiet format icon" Classes.on="{Binding IsThumbnails}" Command="{Binding ShowAsCommand}" CommandParameter="{x:Static files:FileView.Thumbnails}" ToolTip.Tip="Thumbnails"><c:Icon Data="{StaticResource Icon.Tiles}" Size="16" /></Button>
            <Button Classes="quiet format icon" Classes.on="{Binding IsList}" Command="{Binding ShowAsCommand}" CommandParameter="{x:Static files:FileView.List}" ToolTip.Tip="List"><c:Icon Data="{StaticResource Icon.Bullets}" Size="16" /></Button>
            <Button Classes="quiet format icon" Classes.on="{Binding IsDetails}" Command="{Binding ShowAsCommand}" CommandParameter="{x:Static files:FileView.Details}" ToolTip.Tip="Details"><c:Icon Data="{StaticResource Icon.Table}" Size="16" /></Button>
            <Button Classes="quiet format icon" Classes.on="{Binding IsColumns}" Command="{Binding ShowAsCommand}" CommandParameter="{x:Static files:FileView.Columns}" ToolTip.Tip="Columns, for deep folders"><c:Icon Data="{StaticResource Icon.Columns}" Size="16" /></Button>
            <Button Classes="quiet format" Classes.on="{Binding IsFiltered}" ToolTip.Tip="Show only files with a tag" IsVisible="{Binding !IsTagView}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <c:CategoryDot Colour="{Binding FilterTag.Colour, FallbackValue={x:Null}}" Size="8" IsVisible="{Binding IsFiltered}" />
                <TextBlock Text="{Binding TagFilterText}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="TagFilterOpening" />
              </Button.Flyout>
            </Button>
            <Button Classes="quiet format" Classes.on="{Binding IsShowFiltered}" ToolTip.Tip="Show only one kind of file, or files from a time">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding FilterLabel}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="ShowFilterOpening" />
              </Button.Flyout>
            </Button>
            <Button Classes="quiet format" Classes.on="{Binding ShowingSpace}" Command="{Binding ToggleSpaceCommand}" ToolTip.Tip="What's taking space: folder sizes, biggest first">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Reports}" Size="14" VerticalAlignment="Center" />
                <TextBlock Text="Space" />
              </StackPanel>
            </Button>
            <Button Classes="quiet format" ToolTip.Tip="Group by">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Group" />
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Not grouped" Command="{Binding GroupByCommand}" CommandParameter="{x:Static files:FileGrouping.None}" />
                  <MenuItem Header="By kind" Command="{Binding GroupByCommand}" CommandParameter="{x:Static files:FileGrouping.Kind}" />
                  <MenuItem Header="By date" Command="{Binding GroupByCommand}" CommandParameter="{x:Static files:FileGrouping.Date}" />
                  <MenuItem Header="By tag" Command="{Binding GroupByCommand}" CommandParameter="{x:Static files:FileGrouping.Tag}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Slider Width="90" Minimum="64" Maximum="256" Value="{Binding ThumbnailSize}" IsVisible="{Binding IsThumbnails}" VerticalAlignment="Center"
                    ToolTip.Tip="Thumbnail size" Margin="6,0,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Big copies and moves under way, from any Files tab: how far, and Pause or Stop. -->
      <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding CopyJobs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="filesops:CopyJob">
            <Border Padding="16,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Classes="quiet" Content="Pause" Command="{Binding PauseCommand}" IsVisible="{Binding !IsPaused}" />
                  <Button Classes="quiet" Content="Carry on" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}" />
                  <Button Classes="quiet" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsActive}" />
                  <Button Classes="quiet format icon" Command="{Binding DismissCommand}" IsVisible="{Binding IsOver}" ToolTip.Tip="Put this away">
                    <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                  </Button>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Value="{Binding Fraction}" Minimum="0" Maximum="1" Height="4" MinHeight="4" IsVisible="{Binding IsActive}" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- What's here, and anything to say about the last thing done -->
      <Border DockPanel.Dock="Bottom" Padding="16,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Classes="muted" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Classes.problem="{Binding MessageIsProblem}" FontSize="12" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>
      </Border>

      <Panel>
        <DockPanel IsVisible="{Binding !IsPreviewing}">
          <!-- The details pane: a preview, then size, dates, picture size or PDF pages, tags. -->
          <Border DockPanel.Dock="Right" Width="290" IsVisible="{Binding ShowDetails}" Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer>
              <Panel Margin="16">
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Pick a file or folder to see its details. Space shows it bigger."
                           IsVisible="{Binding !HasDetails}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PickSummary.Text, FallbackValue=''}" IsVisible="{Binding HasPickSummary}" Background="{DynamicResource Surface}" />
                <StackPanel Spacing="12" IsVisible="{Binding HasDetails}">
                  <Border Classes="thumb" Height="190">
                    <Panel>
                      <c:Icon Data="{Binding Details.Icon, Converter={x:Static c:IconConverter.Instance}, FallbackValue={x:Null}}" Size="44"
                              Classes.folder="{Binding Details.IsFolder, FallbackValue=False}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Details.ShowsIcon, FallbackValue=False}" />
                      <TextBlock Classes="muted" Text="Opening…" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Details.IsLoading, FallbackValue=False}" />
                      <ItemsControl ItemsSource="{Binding Details.Pictures, FallbackValue={x:Null}}" IsVisible="{Binding Details.HasPictures, FallbackValue=False}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="Bitmap">
                            <Image Source="{Binding}" Stretch="Uniform" MaxHeight="190" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding Details.Text, FallbackValue=''}" IsVisible="{Binding Details.HasText, FallbackValue=False}" TextWrapping="Wrap"
                                 FontSize="11" Margin="10" TextTrimming="CharacterEllipsis" />
                    </Panel>
                  </Border>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Details.Name, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding Details.KindText, FallbackValue=''}" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding Details.Snippet, FallbackValue=''}"
                             IsVisible="{Binding Details.HasSnippet, FallbackValue=False}" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Classes="facts">
                    <TextBlock Grid.Row="0" Classes="muted" Text="Size" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.SizeText, FallbackValue=''}" />
                    <TextBlock Grid.Row="1" Classes="muted" Text="Holds" IsVisible="{Binding Details.HasMeasure, FallbackValue=False}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.Measure, FallbackValue=''}" IsVisible="{Binding Details.HasMeasure, FallbackValue=False}" />
                    <TextBlock Grid.Row="2" Classes="muted" Text="Made" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.CreatedText, FallbackValue=''}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Classes="muted" Text="Changed" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.ModifiedText, FallbackValue=''}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Classes="muted" Text="Tags" IsVisible="{Binding Details.HasTags, FallbackValue=False}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.TagText, FallbackValue=''}" IsVisible="{Binding Details.HasTags, FallbackValue=False}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Classes="muted" Text="In" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Details.Where, FallbackValue=''}" TextWrapping="Wrap" />
                  </Grid>
                </StackPanel>
              </Panel>
            </ScrollViewer>
          </Border>
          <!-- Column headings for the details view: click to sort, again for the other way round. -->
          <Border DockPanel.Dock="Top" Classes="stickyhead" Padding="16,0,24,0" IsVisible="{Binding IsDetails}">
            <!-- Columns from the right, so Name takes what is left; Kind and Tags step aside when the list is narrow. -->
            <DockPanel>
              <Button DockPanel.Dock="Right" Width="80" Classes="link sorthead" Content="Size" Command="{Binding SortByCommand}" CommandParameter="{x:Static files:FileSort.Size}" HorizontalContentAlignment="Right" />
              <TextBlock DockPanel.Dock="Right" Width="150" Classes="label" Text="Tags" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Padding="6,0" IsVisible="{Binding !IsNarrow}" />
              <Button DockPanel.Dock="Right" Width="140" Classes="link sorthead" Content="{Binding KindHeading}" Command="{Binding SortByCommand}" CommandParameter="{x:Static files:FileSort.Kind}" IsVisible="{Binding !IsNarrow}" />
              <Button DockPanel.Dock="Right" Width="160" Classes="link sorthead" Content="Date changed" Command="{Binding SortByCommand}" CommandParameter="{x:Static files:FileSort.Modified}" />
              <Button Classes="link sorthead" Content="Name" Command="{Binding SortByCommand}" CommandParameter="{x:Static files:FileSort.Name}" />
            </DockPanel>
          </Border>
          <Panel>
            <c:EmptyState Title="{Binding EmptyTitle}" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Margin="0,60,0,0" />
            <!-- Column view: the folders on the way, then this folder's list; the other views use the list alone. -->
            <ScrollViewer x:Name="ColumnsScroller" HorizontalScrollBarVisibility="{Binding ColumnsScroll}" VerticalScrollBarVisibility="Disabled">
            <DockPanel>
            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Columns}" IsVisible="{Binding IsColumns}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileColumnViewModel">
                  <Border Width="230" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding Rows}" Margin="6">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FileColumnRow">
                            <Button Classes="columnrow" Classes.on="{Binding IsOnPath}" Command="{Binding GoCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                              <DockPanel>
                                <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronRight}" Size="12" Opacity="0.5" IsVisible="{Binding IsFolder}" VerticalAlignment="Center" />
                                <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="15" Classes.folder="{Binding IsFolder}"
                                        Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              </DockPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox x:Name="FileList" Classes="files" Classes.thumbs="{Binding IsThumbnails}" Classes.columns="{Binding IsColumns}" ItemsSource="{Binding Items}" SelectionMode="Multiple"
                     Background="Transparent" DragDrop.AllowDrop="True" Padding="8,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:FileHeaderRow">
                  <DockPanel Margin="8,12,8,4" MinWidth="{Binding $parent[ListBox].Bounds.Width, Converter={x:Static c:Widths.LessMargin}}">
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding CountText}" />
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                  </DockPanel>
                </DataTemplate>
                <DataTemplate DataType="vm:FileRowViewModel">
                  <Panel Classes.cut="{Binding IsCut}">
                    <!-- Details -->
                    <DockPanel IsVisible="{Binding Owner.IsDetails}" Height="30" ToolTip.Tip="{Binding Tip}">
                      <TextBlock DockPanel.Dock="Right" Width="80" Classes="muted" Text="{Binding SizeText}" VerticalAlignment="Center" TextAlignment="Right" />
                      <DockPanel DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="{Binding TagText}" IsVisible="{Binding !Owner.IsNarrow}">
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagDot}" VerticalAlignment="Center" Margin="0,0,6,0" IsVisible="{Binding HasTags}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="{Binding TagText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                      <Panel DockPanel.Dock="Right" Width="134" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !Owner.IsNarrow}">
                        <TextBlock Classes="muted" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Entry.Path}" IsVisible="{Binding !HasSpace}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSpace}">
                          <Border Classes="spacebar" Width="{Binding SpaceBar}" Height="8" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding SpaceText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Panel>
                      <TextBlock DockPanel.Dock="Right" Width="154" Classes="muted" Text="{Binding ModifiedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                      <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="16" Classes.folder="{Binding IsFolder}" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- List -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Owner.IsListLike}" Height="26" ToolTip.Tip="{Binding Tip}">
                      <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="16" Classes.folder="{Binding IsFolder}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center" />
                      <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagDot}" VerticalAlignment="Center" ToolTip.Tip="{Binding TagText}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                    <!-- Thumbnails -->
                    <StackPanel IsVisible="{Binding Owner.IsThumbnails}" Width="{Binding Owner.ThumbnailSize}" Spacing="6" Margin="4">
                      <Border Height="{Binding Owner.ThumbnailSize}" Classes="thumb">
                        <Panel>
                          <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="36" Classes.folder="{Binding IsFolder}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 FontSize="12" IsVisible="{Binding !IsRenaming}" />
                      <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagDot}" HorizontalAlignment="Center" IsVisible="{Binding HasTags}" ToolTip.Tip="{Binding TagText}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                    <!-- Renaming, in any view -->
                    <StackPanel IsVisible="{Binding IsRenaming}" VerticalAlignment="Center" Margin="26,0,0,0">
                      <TextBox Classes="rename" Text="{Binding RenameText}" MinWidth="220" KeyDown="RenameKeys" LostFocus="RenameLost" />
                      <TextBlock Classes="problem" FontSize="11" Text="{Binding RenameProblem}" IsVisible="{Binding RenameProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Panel>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
            </DockPanel>
            </ScrollViewer>

            <!-- Quick Look: Space shows the file big over the list; Space or Esc closes it, arrows go through the folder. -->
            <Border IsVisible="{Binding IsQuickLooking}" Background="{DynamicResource Scrim}" PointerPressed="QuickLookBackdrop">
              <Border Background="{DynamicResource Surface}" CornerRadius="10" BoxShadow="{DynamicResource OverlayShadow}" Margin="36,20" MaxWidth="1100"
                      PointerPressed="QuickLookCard">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="18,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <Button Classes="quiet" Content="Open" Command="{Binding OpenLookedCommand}" ToolTip.Tip="Open it in its usual program (Enter)" />
                        <Button Classes="quiet format icon" Command="{Binding CloseQuickLookCommand}" ToolTip.Tip="Close (Space or Esc)">
                          <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
                        </Button>
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding QuickLook.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding QuickLook.KindText, FallbackValue=''}" />
                          <Run Text="  " />
                          <Run Text="{Binding QuickLook.SizeText, FallbackValue=''}" />
                          <Run Text="  " />
                          <Run Text="{Binding QuickLook.Measure, FallbackValue=''}" />
                          <Run Text="  " />
                          <Run Text="{Binding QuickLook.ModifiedText, FallbackValue=''}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Panel>
                    <TextBlock Classes="muted" Text="Opening…" Margin="20" IsVisible="{Binding QuickLook.IsLoading, FallbackValue=False}" />
                    <ScrollViewer IsVisible="{Binding QuickLook.HasPictures, FallbackValue=False}">
                      <ItemsControl ItemsSource="{Binding QuickLook.Pictures, FallbackValue={x:Null}}" Margin="20,16">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="Bitmap">
                            <Border Background="{DynamicResource Paper}" BoxShadow="{DynamicResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Center">
                              <Image Source="{Binding}" Stretch="Uniform" StretchDirection="DownOnly" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer IsVisible="{Binding QuickLook.HasText, FallbackValue=False}">
                      <SelectableTextBlock Text="{Binding QuickLook.Text, FallbackValue=''}" TextWrapping="Wrap" Margin="24,18" FontSize="13" />
                    </ScrollViewer>
                    <StackPanel IsVisible="{Binding QuickLook.ShowsIcon, FallbackValue=False}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="40">
                      <c:Icon Data="{Binding QuickLook.Icon, Converter={x:Static c:IconConverter.Instance}, FallbackValue={x:Null}}" Size="64"
                              Classes.folder="{Binding QuickLook.IsFolder, FallbackValue=False}" HorizontalAlignment="Center" />
                      <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                 Text="There's no preview for this kind of file. Press Enter to open it in its usual program." />
                    </StackPanel>
                  </Panel>
                </DockPanel>
              </Border>
            </Border>

            <!-- Renaming several at once: find and replace, or one name with numbers, checked before anything changes. -->
            <Border IsVisible="{Binding IsBulkRenaming}" Background="{DynamicResource Scrim}">
              <Border DataContext="{Binding BulkRename}" x:DataType="vm:BulkRenameViewModel" Background="{DynamicResource Surface}" CornerRadius="10"
                      BoxShadow="{DynamicResource OverlayShadow}" Margin="36,20" MaxWidth="760" Padding="22,18">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="h2" Text="{Binding Title, FallbackValue=''}" Margin="0,0,0,12" />
                  <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBox Text="{Binding Find}" Width="220" PlaceholderText="Find, e.g. IMG_" />
                      <TextBox Text="{Binding Replace}" Width="220" PlaceholderText="Replace with" />
                      <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel ItemSpacing="10" LineSpacing="8">
                      <CheckBox Content="Name and number them" IsChecked="{Binding Numbered}" VerticalAlignment="Center" />
                      <TextBox Text="{Binding NumberedName}" Width="200" PlaceholderText="e.g. Site visit" IsEnabled="{Binding Numbered}" />
                      <TextBlock Classes="muted" Text="from" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding StartAt}" Minimum="0" Maximum="100000" Increment="1" FormatString="0" Width="110" IsEnabled="{Binding Numbered}" />
                      <TextBlock Classes="muted" Text="digits" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding Digits}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="110" IsEnabled="{Binding Numbered}" />
                    </WrapPanel>
                  </StackPanel>
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCommand}" />
                      <Button Classes="primary" Content="Rename them" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                    <TextBlock Classes="problem" FontSize="12" Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </DockPanel>
                  <Border Margin="0,14,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="files:BulkRename+Change">
                            <Grid ColumnDefinitions="*,24,*" Margin="0,3">
                              <TextBlock Classes="muted" Text="{Binding From}" TextTrimming="CharacterEllipsis" />
                              <c:Icon Grid.Column="1" Data="{StaticResource Icon.ChevronRight}" Size="12" Opacity="0.5" HorizontalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding To}" Classes.problem="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </DockPanel>
              </Border>
            </Border>
          </Panel>
        </DockPanel>

        <!-- A PDF or picture shown here, page by page, as in Mail. -->
        <DockPanel IsVisible="{Binding IsPreviewing}">
          <DockPanel DataContext="{Binding Preview}" x:DataType="vm:AttachmentPreviewViewModel">
            <Border DockPanel.Dock="Top" Padding="20,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="link" Content="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open it in its usual program" />
                  <Button Classes="quiet" Content="Back to the folder" Command="{Binding CloseCommand}" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="20,8,20,0" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
            <Panel>
              <TextBlock Classes="muted" Margin="20" Text="Opening…" IsVisible="{Binding IsLoading}" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Pages}" Margin="20,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="Bitmap">
                      <Border Background="{DynamicResource Paper}" BoxShadow="{DynamicResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <Image Source="{Binding}" Stretch="Uniform" StretchDirection="DownOnly" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
        </DockPanel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
