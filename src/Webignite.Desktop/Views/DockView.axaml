<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.DockView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- The dock and the panels beside it are glass, dark or light as picked in Settings: their colour let through
         a little (DockGlass and the other Dock colours, made in Looks.ApplyColours), so the page under a floating
         dock shows faintly. -->
    <Style Selector="Border.dock">
      <Setter Property="Background" Value="{DynamicResource DockGlass}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <!-- The dock's full text colour, not a grey: on glass, with the page showing faintly behind, grey words are hard to read. -->
    <Style Selector="Button.dockitem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DockText}" />
      <Setter Property="Width" Value="70" />
      <Setter Property="Padding" Value="4,8,4,7" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.dockitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
      <Setter Property="Foreground" Value="{DynamicResource DockText}" />
    </Style>
    <!-- The page on screen is the lit one: the dock's own colours the other way round. -->
    <Style Selector="Button.dockitem.current">
      <Setter Property="Background" Value="{DynamicResource DockText}" />
      <Setter Property="Foreground" Value="{DynamicResource DockSolid}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Its count turns round with it, so it still shows. -->
    <Style Selector="Button.dockitem.current Border.badge">
      <Setter Property="Background" Value="{DynamicResource DockSolid}" />
    </Style>
    <Style Selector="Button.dockitem.current Border.badge > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DockText}" />
    </Style>
    <Style Selector="Button.dockitem Border.badge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dockitem.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DockText}" />
      <Setter Property="Foreground" Value="{DynamicResource DockSolid}" />
    </Style>
    <!-- Beside the dock: a glass panel each side, like the dock itself, holding the small things the person picked. With a strip of
         its own the panel fills its side; floating, it is only as wide as what is in it, so little of the page is covered. -->
    <Style Selector="Border.glass">
      <Setter Property="Background" Value="{DynamicResource DockGlass}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.glass.floating">
      <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
    </Style>
    <Style Selector="Border.glass.left.floating">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.glass.right.floating">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.baritem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DockText}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.baritem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DockHover}" />
      <Setter Property="Foreground" Value="{DynamicResource DockText}" />
    </Style>
    <Style Selector="Border.barcount">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style Selector="Border.barcount > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- The small things beside the dock: one way of drawing each, picked by what it is (Controls/BarTemplates). -->
    <c:BarTemplates x:Key="BarItemTemplate">
      <DataTemplate x:Key="Today" x:DataType="vm:BarItem">
        <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.OpenTodayCommand}" ToolTip.Tip="Today. Click to open Planner.">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.Calendar}" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.TodayText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="Clock" x:DataType="vm:BarItem">
        <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.OpenTodayCommand}" ToolTip.Tip="The time on this PC">
          <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.ClockText}" FontFeatures="+tnum" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="Timer" x:DataType="vm:BarItem">
        <StackPanel Orientation="Horizontal">
          <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenTimeCommand}" ToolTip.Tip="The timer. Click to open Time.">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{StaticResource Icon.Time}" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Timer.Clock}" FontFeatures="+tnum" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="baritem" Padding="9,8" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.ToggleTimerCommand}" ToolTip.Tip="Start the timer, or stop it and keep the time">
            <Panel>
              <c:Icon Data="{StaticResource Icon.Play}" Size="13" IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).Timer.IsRunning}" />
              <c:Icon Data="{StaticResource Icon.Stop}" Size="13" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Timer.IsRunning}" />
            </Panel>
          </Button>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Chat" x:DataType="vm:BarItem">
        <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenChatCommand}" ToolTip.Tip="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChatPartnerTip}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.Chat}" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Chat" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChatPartnerShown, Converter={x:Static c:PresenceColours.Brush}}" />
            <Border Classes="barcount" VerticalAlignment="Center" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).HasChatUnread}">
              <TextBlock Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ChatUnread}" FontSize="{DynamicResource Text10}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="Search" x:DataType="vm:BarItem">
        <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Search.ShowCommand}" ToolTip.Tip="Search everything (Ctrl+K)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.Search}" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Search" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="QuickNote" x:DataType="vm:BarItem">
        <Button Classes="baritem" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DockBarPart.QuickNoteCommand}" ToolTip.Tip="Jot down a quick note">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Data="{StaticResource Icon.Notes}" Size="15" VerticalAlignment="Center" />
            <TextBlock Text="Note" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DataTemplate>
    </c:BarTemplates>
  </UserControl.Resources>
  <!-- Right-clicking anything here opens one menu, made as it is asked for (DockView.axaml.cs). -->
  <Grid ColumnDefinitions="*,Auto,*" Margin="12,6,12,12" ContextRequested="Asked">
    <Border Grid.Column="0" Classes="glass left" Classes.floating="{Binding DockBarPart.DockFloats}" Margin="0,0,10,0" IsVisible="{Binding DockBarPart.HasBarLeft}">
      <ItemsControl ItemsSource="{Binding DockBarPart.BarLeft}" ItemTemplate="{StaticResource BarItemTemplate}" HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:FitRowPanel Spacing="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>
    <Border Grid.Column="1" Classes="dock">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ItemsControl x:Name="DockItems" ItemsSource="{Binding MenuPart.Dock}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MenuEntry">
              <!-- A page or a tool: a click goes there. A whole group: a click opens a short list of what is in it, just above the dock. -->
              <Button Classes="dockitem" Classes.current="{Binding IsCurrent}" ToolTip.Tip="{Binding Title}" Click="DockClicked">
                <Panel>
                  <StackPanel Spacing="4">
                    <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="20" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text11}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" MinWidth="18" Padding="5,1" IsVisible="{Binding Module.HasBadge, FallbackValue=False}">
                    <TextBlock Text="{Binding Module.Badge, FallbackValue=''}" FontSize="{DynamicResource Text10}" FontWeight="SemiBold" />
                  </Border>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Width="1" Margin="4,10" Background="{DynamicResource DockLine}" />
        <Button Classes="dockitem" Command="{Binding MenuPart.ToggleMenuCommand}" ToolTip.Tip="Every page, tool and project (Ctrl+M)">
          <StackPanel Spacing="4">
            <c:Icon Data="{StaticResource Icon.Tiles}" Size="20" HorizontalAlignment="Center" />
            <TextBlock Text="More" FontSize="{DynamicResource Text11}" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Border Grid.Column="2" Classes="glass right" Classes.floating="{Binding DockBarPart.DockFloats}" Margin="10,0,0,0" IsVisible="{Binding DockBarPart.HasBarRight}">
      <ItemsControl ItemsSource="{Binding DockBarPart.BarRight}" ItemTemplate="{StaticResource BarItemTemplate}" HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><c:FitRowPanel Spacing="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
