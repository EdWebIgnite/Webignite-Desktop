<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.CalculatorView"
             x:DataType="vm:ToolsViewModel">
  <UserControl.Styles>
    <!-- The keys: big enough to click, and the same height so the pad lines up. -->
    <Style Selector="Button.key">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Height" Value="50" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.key.op">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.key.equals">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.key.equals:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <Style Selector="TextBox#SumBox /template/ Border#PART_BorderElement, TextBox#SumBox:pointerover /template/ Border#PART_BorderElement, TextBox#SumBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="12">
    <!-- What is typed, and the answer as it goes -->
    <Border Classes="card" Padding="14,10">
      <StackPanel Spacing="2">
        <TextBox x:Name="SumBox" Text="{Binding Sum}" FontSize="20" Padding="4,6" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Right" PlaceholderText="0" />
        <TextBlock Classes="figure" Text="{Binding AnswerText}" HorizontalAlignment="Right" MinHeight="34" />
      </StackPanel>
    </Border>

    <!-- The pad. The keyboard and the number pad work too. -->
    <Grid x:Name="Pad" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <Button Grid.Row="0" Grid.Column="0" Classes="key op" Tag="clear" Content="C" ToolTip.Tip="Clear (Esc)" />
      <Button Grid.Row="0" Grid.Column="1" Classes="key op" Tag="back" Content="⌫" ToolTip.Tip="Rub out (Backspace)" />
      <Button Grid.Row="0" Grid.Column="2" Classes="key op" Tag="%" Content="%" ToolTip.Tip="Per cent: + 15% adds 15% of what's before it" />
      <Button Grid.Row="0" Grid.Column="3" Classes="key op" Tag="÷" Content="÷" ToolTip.Tip="Divide (/)" />
      <Button Grid.Row="1" Grid.Column="0" Classes="key" Tag="7" Content="7" />
      <Button Grid.Row="1" Grid.Column="1" Classes="key" Tag="8" Content="8" />
      <Button Grid.Row="1" Grid.Column="2" Classes="key" Tag="9" Content="9" />
      <Button Grid.Row="1" Grid.Column="3" Classes="key op" Tag="×" Content="×" ToolTip.Tip="Times (*)" />
      <Button Grid.Row="2" Grid.Column="0" Classes="key" Tag="4" Content="4" />
      <Button Grid.Row="2" Grid.Column="1" Classes="key" Tag="5" Content="5" />
      <Button Grid.Row="2" Grid.Column="2" Classes="key" Tag="6" Content="6" />
      <Button Grid.Row="2" Grid.Column="3" Classes="key op" Tag="-" Content="−" ToolTip.Tip="Minus" />
      <Button Grid.Row="3" Grid.Column="0" Classes="key" Tag="1" Content="1" />
      <Button Grid.Row="3" Grid.Column="1" Classes="key" Tag="2" Content="2" />
      <Button Grid.Row="3" Grid.Column="2" Classes="key" Tag="3" Content="3" />
      <Button Grid.Row="3" Grid.Column="3" Classes="key op" Tag="+" Content="+" ToolTip.Tip="Plus" />
      <Button Grid.Row="4" Grid.Column="0" Classes="key" Tag="00" Content="00" />
      <Button Grid.Row="4" Grid.Column="1" Classes="key" Tag="0" Content="0" />
      <Button Grid.Row="4" Grid.Column="2" Classes="key" Tag="." Content="." ToolTip.Tip="Decimal point" />
      <Button Grid.Row="4" Grid.Column="3" Classes="key equals" Tag="=" Content="=" ToolTip.Tip="Work it out (Enter)" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="quiet" Content="Copy answer" Command="{Binding CopyAnswerCommand}"
              CommandParameter="{Binding $parent[TopLevel]}" IsEnabled="{Binding HasAnswer}" />
      <TextBlock Classes="muted" Classes.problem="{Binding CalcProblem}" Text="{Binding CalcMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                 IsVisible="{Binding CalcMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Earlier sums, to pick one up again -->
    <StackPanel Spacing="4" IsVisible="{Binding Tape.Count}">
      <TextBlock Classes="label" Text="EARLIER" />
      <ItemsControl ItemsSource="{Binding Tape}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CalcTapeRow">
            <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,3"
                    Command="{Binding $parent[ItemsControl].((vm:ToolsViewModel)DataContext).UseTapeCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="Use this answer">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AnswerText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                <TextBlock Classes="muted" Text="{Binding Sum}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- The answer on an invoice -->
    <Border Classes="card" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Put it on an invoice" />
        <TextBox Text="{Binding LineDescription}" PlaceholderText="What the line is for, e.g. Content updates, 3.5 hours" />
        <Button Classes="primary" Content="Add to invoice" Command="{Binding AddToInvoiceCommand}" IsEnabled="{Binding HasAnswer}" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Goes on the invoice you have open, or a new one. Price boxes on quotes and invoices take sums too." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
