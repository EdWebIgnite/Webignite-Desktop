<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:fin="using:Webignite.Core.Finance"
             xmlns:xero="using:Webignite.Core.Xero"
             x:Class="Webignite.Desktop.Views.MoneyView"
             x:DataType="vm:MoneyViewModel">
  <UserControl.Styles>
    <!-- Rows in this page's cards start where the card's heading and boxes do. -->
    <Style Selector="Border.taskrow">
      <Setter Property="Padding" Value="20,8,16,8" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="18">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="quiet" Content="This month" Command="{Binding ThisMonthCommand}" IsVisible="{Binding !IsThisMonth}" />
        <Button Classes="quiet" Content="‹" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month" />
        <TextBlock Text="{Binding MonthTitle}" FontWeight="SemiBold" MinWidth="130" TextAlignment="Center" VerticalAlignment="Center" />
        <Button Classes="quiet" Content="›" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Money" />
        <TextBlock Classes="muted" Text="What came in and what went out, kept on this PC, and the bills you owe, read from Xero." />
      </StackPanel>
    </DockPanel>

    <UniformGrid Columns="3">
      <Border Classes="card" Margin="0,0,12,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="RECEIVED" />
          <TextBlock Classes="figure" Text="{Binding Received}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Before expenses." />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="6,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="EXPENSES" />
          <TextBlock Classes="figure" Text="{Binding Expenses}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Including monthly ones." />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="12,0,0,0">
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="LEFT OVER" />
          <TextBlock Classes="figure" Classes.short="{Binding IsShort}" Text="{Binding LeftOver}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Received less expenses." />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Bills to pay, from Xero -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding XeroConnected}" VerticalAlignment="Top">
            <c:Spinner IsVisible="{Binding ReadingBills}" Size="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
<Button Classes="quiet" Content="Draft a bill from a PDF" Click="PickBillPdf" IsEnabled="{Binding !DraftingBill}"
                    ToolTip.Tip="Reads a supplier's PDF bill, lets you check it, then puts it in Xero as a draft with the PDF attached." />
            <Button Classes="quiet" Content="Read Xero now" Command="{Binding ReadBillsNowCommand}" IsEnabled="{Binding !ReadingBills}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="BILLS TO PAY" />
            <TextBlock Text="{Binding BillsSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
        <Border Classes="pending" IsVisible="{Binding DraftingBill}">
          <StackPanel Spacing="10">
            <DockPanel>
              <c:Spinner DockPanel.Dock="Right" IsVisible="{Binding BillBusy}" Size="14" Foreground="{DynamicResource Muted}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding BillFileName, StringFormat='Bill from {0}'}" />
            </DockPanel>
            <Grid ColumnDefinitions="2*,12,*,12,150,12,150" RowDefinitions="Auto,Auto,8,Auto,Auto">
              <TextBlock Classes="label" Text="FROM" />
              <TextBox Grid.Row="1" Text="{Binding BillSupplier}" Watermark="Supplier" />
              <TextBlock Grid.Column="2" Classes="label" Text="THEIR NUMBER" />
              <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding BillNumber}" />
              <TextBlock Grid.Column="4" Classes="label" Text="DATE" />
              <CalendarDatePicker Grid.Row="1" Grid.Column="4" SelectedDate="{Binding BillDate}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Column="6" Classes="label" Text="DUE" />
              <CalendarDatePicker Grid.Row="1" Grid.Column="6" SelectedDate="{Binding BillDue}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="label" Text="WHAT IT'S FOR" />
              <TextBox Grid.Row="4" Text="{Binding BillDescription}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="label" Text="EXPENSE ACCOUNT" />
              <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ExpenseAccounts}" SelectedItem="{Binding BillAccount}"
                        PlaceholderText="Pick one" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="xero:XeroSalesAccount">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="3" Grid.Column="4" Classes="label" Text="AMOUNT (R)" />
              <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding BillTotal}" />
            </Grid>
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Text12}" Text="{Binding BillMessage}" Classes.problem="{Binding BillMessageIsProblem}"
                       Classes.muted="{Binding !BillMessageIsProblem}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Draft bill in Xero" Command="{Binding DraftBillCommand}" IsEnabled="{Binding !BillBusy}"
                      IsVisible="{Binding !AskAddSupplier}" />
              <Button Classes="primary" Content="Add supplier and draft" Command="{Binding AddSupplierAndDraftCommand}" IsEnabled="{Binding !BillBusy}"
                      IsVisible="{Binding AskAddSupplier}" />
              <Button Classes="quiet" Content="Cancel" Command="{Binding CancelBillCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Text="It goes in as a draft with the PDF attached. Approving and paying stay with you in Xero." />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding BillRows}" IsVisible="{Binding HasBills}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BillRowViewModel">
              <Button Classes="cell" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}"
                      ToolTip.Tip="Open the bill in Xero">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Classes="amount" Text="{Binding Amount}" VerticalAlignment="Center"
                             Classes.problem="{Binding IsOverdue}" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Supplier}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Details}" Classes.problem="{Binding IsOverdue}" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding BillsRead}" IsVisible="{Binding XeroConnected}" />
      </StackPanel>
    </Border>

    <!-- Income projection -->
    <Border Classes="card">
      <StackPanel Spacing="14">
        <DockPanel>
          <!-- Where the figures come from: set once, so out of the way -->
          <Button DockPanel.Dock="Right" Classes="quiet" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip.Tip="Where expected and came-in figures come from">
            <TextBlock Text="···" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Expected amounts">
                  <MenuItem Header="Work them out" ToggleType="Radio" IsChecked="{Binding IsAuto, Mode=OneWay}" Command="{Binding UseAutoCommand}"
                            ToolTip.Tip="Invoices due each month, plus retainers and charged renewals still to be invoiced." />
                  <MenuItem Header="Type them in" ToggleType="Radio" IsChecked="{Binding IsManual, Mode=OneWay}" Command="{Binding UseManualCommand}"
                            ToolTip.Tip="Type what you expect each month in the table below." />
                </MenuItem>
                <MenuItem Header="Came in from">
                  <MenuItem Header="Money received" ToggleType="Radio" IsChecked="{Binding FromMoney, Mode=OneWay}" Command="{Binding CameInFromMoneyCommand}"
                            ToolTip.Tip="What you add under Money received on this page." />
                  <MenuItem Header="Xero payments" ToggleType="Radio" IsChecked="{Binding FromXero, Mode=OneWay}" Command="{Binding CameInFromXeroCommand}"
                            ToolTip.Tip="Invoices Xero says were paid, on the day they were paid." />
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Border DockPanel.Dock="Right" Classes="segments" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Classes.on="{Binding ChartBars}" Content="Bars"
                      Command="{Binding ShowChartCommand}" CommandParameter="{x:Static fin:ChartStyle.Bars}" />
              <Button Classes="segment" Classes.on="{Binding ChartFilled}" Content="Filled"
                      Command="{Binding ShowChartCommand}" CommandParameter="{x:Static fin:ChartStyle.Filled}" />
              <Button Classes="segment" Classes.on="{Binding ChartLines}" Content="Lines"
                      Command="{Binding ShowChartCommand}" CommandParameter="{x:Static fin:ChartStyle.Lines}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Income: expected and came in" />
            <TextBlock Classes="muted" Text="{Binding IncomeSummary}" />
          </StackPanel>
        </DockPanel>

        <c:IncomeChart Months="{Binding ProjectionMonths}" ChartStyle="{Binding ChartStyle}" Height="220" />

        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" Margin="0,0,20,8" VerticalAlignment="Center">
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Primary}" Opacity="0.25" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Expected" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Primary}" Margin="10,0,0,0" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Came in" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="3*,24,2*">
      <Border Grid.Column="0" Classes="card" Padding="0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Classes="h2" Text="Month by month" Margin="20,16,20,10" />
          <!-- Each column has a faint line on its left and the same padding in the heading and the rows, so a figure
               sits under its heading and the last column doesn't drift off on a wide window. -->
          <Border Classes="stickyhead">
            <Grid ColumnDefinitions="130,*,*,1.2*">
              <TextBlock Grid.Column="0" Classes="label" Text="Month" Margin="20,0,12,0" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="colline"><TextBlock Classes="label" Text="Expected" HorizontalAlignment="Right" VerticalAlignment="Center" /></Border>
              <Border Grid.Column="2" Classes="colline"><TextBlock Classes="label" Text="Came in" HorizontalAlignment="Right" VerticalAlignment="Center" /></Border>
              <Border Grid.Column="3" Classes="colline"><TextBlock Classes="label" Text="Difference" HorizontalAlignment="Right" VerticalAlignment="Center" /></Border>
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding IncomeRows}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IncomeMonthRow">
                <Border Classes="taskrow" Padding="0" MinHeight="38">
                  <Grid ColumnDefinitions="130,*,*,1.2*">
                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:MoneyViewModel.BoldIf}}"
                               Classes.muted="{Binding IsFuture}" Margin="20,0,12,0" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="colline">
                      <Panel>
                        <TextBlock Classes="amount" Text="{Binding Expected}" IsVisible="{Binding IsAuto}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ManualText}" IsVisible="{Binding IsManual}" PlaceholderText="Amount"
                                 HorizontalAlignment="Right" Width="120" TextAlignment="Right" Padding="8,2" MinHeight="26" VerticalAlignment="Center" />
                      </Panel>
                    </Border>
                    <Border Grid.Column="2" Classes="colline">
                      <TextBlock Classes="amount" Text="{Binding CameIn}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="3" Classes="colline">
                      <TextBlock Classes="muted" Classes.short="{Binding IsShort}" FontSize="{DynamicResource Text12}" Text="{Binding Gap}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="0" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Margin="20,16,20,10" Spacing="4">
            <TextBlock Classes="h2" Text="{Binding ExpectedTitle}" />
            <TextBlock Classes="muted" Text="{Binding ExpectedNote}" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ExpectedItems}" Margin="0,0,0,8" IsVisible="{Binding HasExpectedItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExpectedItemRow">
                <Border Classes="taskrow">
                  <Grid ColumnDefinitions="56,*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Date}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding What}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="amount" Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="*,24,*">
      <!-- Received -->
      <Border Grid.Column="0" Classes="card" Padding="0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Classes="h2" Text="Money received" Margin="20,16,20,12" />
          <Grid ColumnDefinitions="140,8,*" RowDefinitions="Auto,8,Auto,8,Auto" Margin="20,0,20,12">
            <CalendarDatePicker Grid.Row="0" Grid.Column="0" SelectedDate="{Binding InDate}" HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding InAmount}" PlaceholderText="Amount, e.g. 2800" />
            <AutoCompleteBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding InFrom}" ItemsSource="{Binding ClientNames}"
                             FilterMode="ContainsOrdinal" PlaceholderText="From which client" />
            <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
              <Button DockPanel.Dock="Right" Classes="primary" Content="Add" Command="{Binding AddReceivedCommand}" Margin="8,0,0,0" />
              <TextBox Text="{Binding InNote}" PlaceholderText="Note, e.g. INV-0107" />
            </DockPanel>
          </Grid>
          <TextBlock Classes="label problem" Text="{Binding InMessage}" Margin="20,0,20,8" IsVisible="{Binding InMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="muted" Text="Nothing received this month yet." Margin="20,4,20,16" IsVisible="{Binding !HasReceived}" />
          <ItemsControl ItemsSource="{Binding ReceivedRows}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntryRowViewModel">
                <Border Classes="taskrow" Classes.leaving="{Binding IsLeaving}">
                  <Grid ColumnDefinitions="56,*,Auto,32">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Date}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Party}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="amount" Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0" />
                    <Button Grid.Column="3" Classes="link" ToolTip.Tip="Remove" Command="{Binding DeleteCommand}">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Expenses -->
      <Border Grid.Column="2" Classes="card" Padding="0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Classes="h2" Text="Expenses" Margin="20,16,20,12" />
          <Grid ColumnDefinitions="140,8,*" RowDefinitions="Auto,8,Auto,8,Auto" Margin="20,0,20,12">
            <CalendarDatePicker Grid.Row="0" Grid.Column="0" SelectedDate="{Binding OutDate}" HorizontalAlignment="Stretch"
                                SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding OutAmount}" PlaceholderText="Amount, e.g. 349.99" />
            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding OutTo}" PlaceholderText="Paid to, e.g. Takealot" />
            <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
              <Button DockPanel.Dock="Right" Classes="primary" Content="Add" Command="{Binding AddExpenseCommand}" Margin="8,0,0,0" />
              <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding OutCategory}" HorizontalAlignment="Stretch" />
            </DockPanel>
          </Grid>
          <TextBlock Classes="label problem" Text="{Binding OutMessage}" Margin="20,0,20,8" IsVisible="{Binding OutMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="muted" Text="No expenses this month yet." Margin="20,4,20,16" IsVisible="{Binding !HasExpenses}" />
          <ItemsControl ItemsSource="{Binding ExpenseRows}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntryRowViewModel">
                <Border Classes="taskrow" Classes.leaving="{Binding IsLeaving}">
                  <Grid ColumnDefinitions="56,*,Auto,32">
                    <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Date}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Party}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="amount" Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0" />
                    <Button Grid.Column="3" Classes="link" ToolTip.Tip="Remove" Command="{Binding DeleteCommand}">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Monthly expenses -->
    <Border Classes="card" Padding="0">
      <StackPanel>
        <StackPanel Margin="20,16,20,12" Spacing="4">
          <TextBlock Classes="h2" Text="Monthly expenses" />
          <TextBlock Classes="muted" Text="{Binding RecurringSummary}" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding RecurringRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecurringRowViewModel">
              <Border Classes="taskrow">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Classes.muted="{Binding IsPaused}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Detail}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="amount" Classes.muted="{Binding IsPaused}" Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0,16,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Stop goes at once; the note in the corner undoes it. -->
                    <Button Classes="link" Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" />
                    <Button Classes="link" Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stops it. Past months stay. You can undo it for a few seconds." />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*,8,130,8,Auto,12,200,8,Auto" Margin="20,12,20,8">
          <TextBox Grid.Column="0" Text="{Binding RecName}" PlaceholderText="What it is, e.g. xneelo server" />
          <TextBox Grid.Column="2" Text="{Binding RecAmount}" PlaceholderText="Amount" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
            <TextBox Text="{Binding RecDay}" Width="48" ToolTip.Tip="Day of the month. 31 means the last day." />
            <TextBlock Classes="muted" Text="day" VerticalAlignment="Center" />
          </StackPanel>
          <ComboBox Grid.Column="6" ItemsSource="{Binding Categories}" SelectedItem="{Binding RecCategory}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="8" Classes="quiet" Content="Add" Command="{Binding AddRecurringCommand}" />
        </Grid>
        <TextBlock Classes="label problem" Text="{Binding RecMessage}" Margin="20,0,20,8" IsVisible="{Binding RecMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Height="8" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
