<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:clients="using:Webignite.Core.Clients"
             x:Class="Webignite.Desktop.Views.MarkupView"
             x:DataType="vm:MarkupViewModel">
  <StackPanel Spacing="18">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button x:Name="SnipButton" Classes="primary" Content="Take a screenshot" Click="TakeScreenshot"
                ToolTip.Tip="The screen freezes: drag over a part, click a window, or press Enter for all of it. Your shortcut does the same from any program." />
        <Button x:Name="RecordButton" Classes="quiet" Content="Record the screen" Click="RecordScreen"
                ToolTip.Tip="Pick a part of the screen to record as an MP4, with your microphone. Your recording shortcut starts and stops it from any program." />
        <Button Classes="quiet" Content="Paste" Click="PasteImage" ToolTip.Tip="Ctrl+V. Paste a screenshot you've already copied" />
        <Button Classes="quiet" Content="Open an image" Click="OpenImage" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Mark-up" />
        <TextBlock Classes="muted" Text="Mark up a screenshot with notes, arrows, text and blur, then save it, copy it or mail it." />
      </StackPanel>
    </DockPanel>

    <!-- A recording just made: a frame to see, the start and end to keep, and where it goes. -->
    <Panel IsVisible="{Binding HasRecording}">
    <Grid ColumnDefinitions="*,18,300" DataContext="{Binding Recording}" x:DataType="vm:RecordingViewModel">
      <Border Grid.Column="0" Classes="card" Padding="16">
        <StackPanel Spacing="14">
          <Border Background="{DynamicResource Ink}" CornerRadius="6" Height="420" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding Frame}" Stretch="Uniform" />
              <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,3" CornerRadius="4" Background="{DynamicResource Nav}">
                <TextBlock Text="{Binding FrameText}" Foreground="{DynamicResource NavText}" FontSize="12" />
              </Border>
            </Panel>
          </Border>
          <Grid ColumnDefinitions="60,*,60" RowDefinitions="Auto,Auto" Classes="trim">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Start" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="{Binding Seconds}" Value="{Binding Start}" SmallChange="0.1" LargeChange="1" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StartText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="End" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding Seconds}" Value="{Binding End}" SmallChange="0.1" LargeChange="1" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EndText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding KeptText}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="2" Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="RECORDING" />
            <TextBlock>
              <Run Text="{Binding LengthText}" FontWeight="SemiBold" />
              <Run Text="  " />
              <Run Text="{Binding SizeText}" Foreground="{DynamicResource Muted}" />
            </TextBlock>
            <TextBlock Classes="problem" FontSize="12" TextWrapping="Wrap" Text="{Binding SoundProblem}" IsVisible="{Binding HasSoundProblem}" />
            <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:MarkupViewModel)DataContext).Clients}"
                      SelectedItem="{Binding $parent[UserControl].((vm:MarkupViewModel)DataContext).Client, Mode=OneWay}" SelectionChanged="ClientPicked"
                      PlaceholderText="Which client" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="clients:Client">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="primary" Content="{Binding $parent[UserControl].((vm:MarkupViewModel)DataContext).SaveToText}" Command="{Binding SaveCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !Working}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="quiet" Content="Email it" Command="{Binding EmailCommand}" IsEnabled="{Binding !Working}" />
              <Button Classes="link" Content="Save as…" Click="SaveRecordingAs" IsEnabled="{Binding !Working}" />
              <Button Classes="link" Content="Show in Files" Command="{Binding ShowSavedCommand}" IsVisible="{Binding HasSaved}" />
            </WrapPanel>
            <TextBlock Classes="muted" Text="Saving…" IsVisible="{Binding Working}" />
            <Button Classes="link" Content="Done with this recording" Command="{Binding CloseCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="Back to screenshots. A recording that wasn't saved is thrown away." />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" Classes.problem="{Binding $parent[UserControl].((vm:MarkupViewModel)DataContext).MessageProblem}"
                   Text="{Binding $parent[UserControl].((vm:MarkupViewModel)DataContext).Message}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    </Panel>

    <Grid ColumnDefinitions="*,18,300" IsVisible="{Binding ShowsPicture}">
      <Border Grid.Column="0" Classes="card" Padding="8" Height="620">
        <Panel>
          <c:MarkupCanvas x:Name="Canvas" Image="{Binding Image}" Marks="{Binding Marks}" Tool="{Binding Tool}" Pen="{Binding Pen}" />
          <!-- The Text tool: words typed where the picture was clicked. Enter keeps them, Esc drops them. -->
          <Canvas x:Name="TextLayer" IsHitTestVisible="True" Background="{x:Null}">
            <TextBox x:Name="TextEntry" IsVisible="False" MinWidth="200" PlaceholderText="Type, then Enter" KeyDown="TextEntryKeys" LostFocus="TextEntryLost" />
          </Canvas>
          <StackPanel IsVisible="{Binding !HasImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420">
            <TextBlock Classes="h2" Text="No screenshot yet" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Click Take a screenshot, or press your shortcut (Ctrl+Alt+S unless you changed it in Settings) from any program. You can also paste a picture or drop an image file on this box." />
          </StackPanel>
        </Panel>
      </Border>

      <StackPanel Grid.Column="2" Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="DRAW" />
            <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding ChosenTool}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox ItemsSource="{Binding Pens}" SelectedItem="{Binding ChosenPen}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PenChoice">
                  <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Brush}" ToolTip.Tip="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet" Content="Undo" Command="{Binding UndoCommand}" />
              <Button Classes="link" Content="Clear all" Command="{Binding ClearMarksCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasImage}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="NOTES" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasPins}"
                       Text="Click on the picture with Numbered note chosen, then write what each number means here." />
            <ItemsControl ItemsSource="{Binding Pins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PinRow">
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontWeight="Bold" Width="22" Margin="0,6,0,0" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Classes="link" Padding="6,4" VerticalAlignment="Top" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this note">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                    </Button>
                    <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="What needs changing here" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasImage}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="SEND IT" />
            <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client, Mode=OneWay}" SelectionChanged="ClientPicked" PlaceholderText="Which client" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="clients:Client">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding Page}" PlaceholderText="Which page, e.g. the home page" />
            <Button Classes="primary" Content="Email it" Command="{Binding EmailCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="quiet" Content="Copy picture" Command="{Binding CopyImageCommand}" CommandParameter="{Binding $parent[TopLevel]}" />
              <Button Classes="quiet" Content="{Binding SaveToText}" Command="{Binding SaveToFolderCommand}"
                      ToolTip.Tip="Saves it as a PNG in the client's folder when they have one, else in your Screenshots folder" />
              <Button Classes="quiet" Content="Add to my to-do list" Command="{Binding AddToTodoCommand}" ToolTip.Tip="Saves it and adds a to-do that says where it is" />
              <Button Classes="link" Content="Save as…" Click="SavePng" />
              <Button Classes="link" Content="Show in Files" Command="{Binding ShowSavedCommand}" IsVisible="{Binding HasSaved}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <TextBlock Classes="muted" Classes.problem="{Binding MessageProblem}" Text="{Binding Message}" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
