<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.ClientsView"
             x:DataType="vm:ClientsViewModel"
             x:Name="Root">
  <Panel>
    <ContentControl Content="{Binding Detail}" IsVisible="{Binding !IsListing}" />

    <StackPanel Spacing="18" IsVisible="{Binding IsListing}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="New client" Command="{Binding NewCommand}" VerticalAlignment="Center" />
        <TextBlock Classes="h1" Text="Clients" />
      </DockPanel>

      <Border Classes="pending" IsVisible="{Binding HasSuggestions}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="On your quotes and invoices but not saved as clients" />
          <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="quiet" Margin="0,0,8,8" Content="{Binding StringFormat='+ {0}'}"
                        Command="{Binding #Root.((vm:ClientsViewModel)DataContext).AddSuggestedCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Clients}" Title="No clients yet"
                    Text="Add one here, or pick a name above from your existing quotes and invoices."
                    ActionText="New client" Command="{Binding NewCommand}" />

      <StackPanel Spacing="12" IsVisible="{Binding !IsEmpty}">
        <TextBox Text="{Binding Search}" PlaceholderText="Search by name, person, email or phone" MaxWidth="420" HorizontalAlignment="Left" Width="420" />

        <c:EmptyState IsVisible="{Binding NoMatches}" Icon="{StaticResource Icon.Search}" Title="No client matches that search"
                      Text="Try part of the name, the contact person, an email address or a phone number." />

        <Border Classes="card" Padding="0" IsVisible="{Binding !NoMatches}">
          <StackPanel>
            <Border Background="{DynamicResource TableHead}" Height="36" Padding="12,0">
              <Grid ColumnDefinitions="*,280,140">
                <TextBlock Grid.Column="0" Classes="label tablehead" Text="Client" />
                <TextBlock Grid.Column="1" Classes="label tablehead" Text="Work" />
                <TextBlock Grid.Column="2" Classes="label tablehead" Text="Owed" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientRow">
                  <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding #Root.((vm:ClientsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,280,140">
                      <StackPanel Grid.Column="0" Margin="8,0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Contact}" IsVisible="{Binding HasContact}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Work}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Work}" />
                      <TextBlock Grid.Column="2" Classes="amount" Text="{Binding Owed}" Margin="8,0" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </Panel>
</UserControl>
