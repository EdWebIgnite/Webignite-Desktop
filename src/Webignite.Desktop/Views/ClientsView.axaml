<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.ClientsView"
             x:DataType="vm:ClientsViewModel"
             x:Name="Root">
  <!-- The client list and the open client side by side. The panes move, resize and hide as on Mail. -->
  <c:PanelGrid Layout="{Binding Panels.Layout}" Panels="{Binding Panels}" Resized="PaneResized">
    <Border c:PanelGrid.Pane="list" c:PanelGrid.DefaultWidth="400" Background="{DynamicResource Canvas}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <!-- Down and Up move between clients, Enter opens one. Esc closing it is in MainViewModel.GoBack. -->
        <StackPanel Spacing="16" Margin="24,30,24,30" c:ListKeys.IsEnabled="True">
          <!-- The buttons sit under the title so a narrow list pane never squeezes the title into a column. -->
          <StackPanel Spacing="8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Classes="quiet" Padding="8,6" Command="{Binding Panels[list].MinimiseCommand}"
                        ToolTip.Tip="Minimise the client list. Bring it back from the strip at the edge or the sidebar.">
                  <c:Icon Data="{StaticResource Icon.SidebarHide}" Size="16" />
                </Button>
              </StackPanel>
              <TextBlock Classes="h1" Text="Clients" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="headline" Text="{Binding Headline}" TextWrapping="Wrap" IsVisible="{Binding !IsEmpty}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding XeroMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding XeroMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="quiet" Content="Bring in from Xero" Command="{Binding BringInFromXeroCommand}" IsEnabled="{Binding !BringingIn}"
                      ToolTip.Tip="Xero's customers become clients here, and blank details are filled in. Xero isn't changed. This also happens every few hours." />
              <Button Classes="primary" Command="{Binding NewCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="16" VerticalAlignment="Center" />
                  <TextBlock Text="New client" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <Border Classes="pending" IsVisible="{Binding HasSuggestions}">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="On your quotes and invoices but not saved as clients" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="quiet" Margin="0,0,8,8" Content="{Binding StringFormat='+ {0}'}"
                            Command="{Binding #Root.((vm:ClientsViewModel)DataContext).AddSuggestedCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Clients}" Title="No clients yet"
                        Text="Add one here, or pick a name above from your existing quotes and invoices."
                        ActionText="New client" Command="{Binding NewCommand}" />

          <StackPanel Spacing="12" IsVisible="{Binding !IsEmpty}">
            <TextBox Text="{Binding Search}" PlaceholderText="Search by name, person, email or phone" />

            <c:EmptyState IsVisible="{Binding NoMatches}" Icon="{StaticResource Icon.Search}" Title="No client matches that search"
                          Text="Try part of the name, the contact person, an email address or a phone number." />

            <Border Classes="card" Padding="0" IsVisible="{Binding !NoMatches}">
              <StackPanel>
                <Border Classes="stickyhead" Padding="12,0">
                  <Grid ColumnDefinitions="*,Auto,28">
                    <TextBlock Grid.Column="0" Classes="label tablehead" Text="Client" />
                    <TextBlock Grid.Column="1" Classes="label tablehead" Text="Owed" HorizontalAlignment="Right" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientRow">
                      <Button Classes="row" Classes.open="{Binding IsOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding #Root.((vm:ClientsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in a new tab" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).OpenInNewTabCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in a new window" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).OpenInNewWindowCommand}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Write a mail" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).WriteToCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasEmail}" />
                            <MenuItem Header="New quote for them" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).NewQuoteForCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="New invoice for them" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).NewInvoiceForCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Notes about them" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).NotesForCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Their folder" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).FolderForCommand}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Copy email address" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).CopyEmailCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasEmail}" />
                            <MenuItem Header="Copy phone number" Command="{Binding #Root.((vm:ClientsViewModel)DataContext).CopyPhoneCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasPhone}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="*,Auto,28">
                          <Border Grid.ColumnSpan="3" Classes="edge" IsVisible="{Binding HasOverdue}" Margin="-12,-11,0,-11" />
                          <Grid Grid.Column="0" ColumnDefinitions="Auto,12,*" Margin="8,0">
                            <c:Monogram Text="{Binding Name}" Size="34" />
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding Contact}" IsVisible="{Binding HasContact}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" FontSize="12" Text="{Binding Work}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Work}" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Grid.Column="1" Classes="amount" Classes.problem="{Binding HasOverdue}" Text="{Binding Owed}" Margin="8,0" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding OverdueTip}" />
                          <c:Icon Grid.Column="2" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <c:ListHint IsVisible="{Binding HasHint}" Text="{Binding Hint.Text, FallbackValue=''}"
                        ActionText="{Binding Hint.ActionText, FallbackValue=''}" Command="{Binding FollowHintCommand}" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The open client, or a word on what goes here -->
    <ScrollViewer c:PanelGrid.Pane="detail" c:PanelGrid.DefaultWidth="640">
      <Panel Margin="36,30" MaxWidth="1040" HorizontalAlignment="Stretch">
        <ContentControl Content="{Binding Detail}" IsVisible="{Binding HasDetail}" />
        <c:EmptyState IsVisible="{Binding !HasDetail}" Icon="{StaticResource Icon.Clients}" Title="Pick a client"
                      Text="Their quotes, invoices, to-dos, mail and notes show here." VerticalAlignment="Top" />
      </Panel>
    </ScrollViewer>
  </c:PanelGrid>
</UserControl>
