<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.RulerView"
             x:DataType="vm:ToolsViewModel">
  <StackPanel Spacing="12">
    <TextBlock TextWrapping="Wrap"
               Text="The screen freezes. Point at a gap or a block and its width and height show; drag to measure a box. A click copies the size." />
    <DockPanel>
      <Button DockPanel.Dock="Left" Margin="0,0,12,0" Classes="primary" Content="Measure the screen" Command="{Binding MeasureScreenCommand}" IsEnabled="{Binding CanMeasureScreen}" />
      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding RulerHint}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Measuring the screen needs Windows." IsVisible="{Binding !CanMeasureScreen}" />
    <ItemsControl ItemsSource="{Binding Measurements}" IsVisible="{Binding HasMeasurements}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="quiet" Content="Copy" Padding="10,3" Click="CopyRow" Tag="{Binding}" />
              <SelectableTextBlock Text="{Binding}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
