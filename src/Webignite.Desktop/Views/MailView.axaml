<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:v="using:Webignite.Desktop.Views"
             xmlns:html="using:TheArtOfDev.HtmlRenderer.Avalonia"
             xmlns:core="using:Webignite.Core.Mail"
             x:Class="Webignite.Desktop.Views.MailView"
             x:DataType="vm:MailViewModel">
  <UserControl.Styles>
    <Style Selector="Button.folder">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Palette hover and press, not Fluent's own grey, which doesn't match the dark looks. -->
    <Style Selector="Button.folder:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.folder:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
    </Style>
    <Style Selector="Button.folder.current">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
    </Style>
    <Style Selector="Button.folder.current TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.folder.drop">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    </Style>
    <Style Selector="Button.folder c|Icon.foldericon">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Button.folder.important c|Icon.foldericon">
      <Setter Property="Foreground" Value="{DynamicResource Important}" />
    </Style>
    <Style Selector="Button.newfolder">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <!-- The message list: rows edge to edge with a line between, like a mail app. -->
    <Style Selector="ListBox.messages">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:selected /template/ ContentPresenter, ListBox.messages ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:selected:focus-within /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    </Style>
    <!-- The open message sits a little above the rows round it. -->
    <Style Selector="ListBox.messages ListBoxItem:selected">
      <Setter Property="ZIndex" Value="1" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <!-- Conversations: the count beside the sender, and the stack of mails above the open one -->
    <Style Selector="Border.threadcount">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.threadstack">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.underbar">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="20,8" />
    </Style>
    <Style Selector="Button.attachchip">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4,4,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.threadhead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8,12,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.threadline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.threadline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
    </Style>
    <Style Selector="Button.threadline.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    </Style>
    <Style Selector="Button.threadline.open">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="TextBlock.who.unread">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.mailcard">
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <!-- Unread mail gets a bold left edge as well as the dot, so it stands out down a long list. -->
    <Style Selector="Border.mailcard.unread">
      <Setter Property="BorderBrush" Value="{DynamicResource InvoiceTint}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="13,10,16,10" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:selected Border.mailcard">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadowRaised}" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:selected:focus-within Border.mailcard">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    </Style>
    <Style Selector="Grid.mailrow.unread TextBlock.who, Grid.mailrow.unread TextBlock.subject">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- Quick filters above the list -->
    <Style Selector="Button.filterchip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Button.filterchip.chosen">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <Style Selector="Button.filterchip.chosen:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <!-- The icon buttons above the open message -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Rectangle.toolgap">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{DynamicResource Line}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch.chosen">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Border.categorytag">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.editor">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.unreaddot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource InvoiceTint}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.mailtag">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Mail rules, and adding or changing a mailbox, each on a page of its own -->
    <Panel IsVisible="{Binding ShowRules}">
      <v:MailRulesView DataContext="{Binding RulesPage}" />
    </Panel>
    <Panel IsVisible="{Binding ShowSetup}">
      <v:MailSetupView DataContext="{Binding Setup}" />
    </Panel>

    <!-- The mail itself: folders, messages, the open message -->
    <c:PanelGrid Layout="{Binding Panels.Layout}" Panels="{Binding Panels}" Resized="PaneResized" IsVisible="{Binding ShowMail}">
      <!-- Folders and categories -->
      <Border c:PanelGrid.Pane="folders" c:PanelGrid.DefaultWidth="240" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12" Spacing="10">
            <!-- A new or renamed folder -->
            <Border Classes="card editor" IsVisible="{Binding HasFolderEditor}">
              <StackPanel Spacing="8" DataContext="{Binding FolderEditor}" x:DataType="vm:FolderEditorViewModel">
                <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Name}" PlaceholderText="Folder name" IsVisible="{Binding AsksName}" x:Name="FolderName" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding Note}" TextWrapping="Wrap" />
                <TextBlock Classes="problem" FontSize="12" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True" />
                  <Button Classes="link" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                </StackPanel>
              </StackPanel>
            </Border>
            <!-- A new or changed category -->
            <Border Classes="card editor" IsVisible="{Binding HasCategoryEditor}">
              <StackPanel Spacing="8" DataContext="{Binding CategoryEditor}" x:DataType="vm:CategoryEditorViewModel">
                <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Name}" PlaceholderText="e.g. Waiting on client" x:Name="CategoryName" />
                <ItemsControl ItemsSource="{Binding Colours}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="2" LineSpacing="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColourChoiceViewModel">
                      <Button Classes="swatch" Classes.chosen="{Binding IsChosen}" Command="{Binding PickCommand}" ToolTip.Tip="{Binding Tip}">
                        <c:CategoryDot Colour="{Binding Colour}" Size="13" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="problem" FontSize="12" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !ConfirmingRemove}">
                  <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
                  <Button Classes="link" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                  <Button Classes="link" Content="Remove" Command="{Binding AskRemoveCommand}" IsVisible="{Binding IsEditing}" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding ConfirmingRemove}">
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="The category goes from this list. Mail keeps it on the server, so making it again brings the mail back." />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="quiet" Content="Remove it" Command="{Binding RemoveCommand}" />
                    <Button Classes="link" Content="Keep" Command="{Binding KeepItCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Button Classes="link" Content="Manage mailboxes" Command="{Binding ManageMailboxesCommand}" />
              <Button Classes="link" Content="Rules" Command="{Binding ManageRulesCommand}" ToolTip.Tip="Sort new mail by sender, domain or subject" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Margin="8,16,8,8">
              <ItemsControl ItemsSource="{Binding Mailboxes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MailboxNodeViewModel">
                    <StackPanel Margin="0,0,0,14">
                      <DockPanel Margin="10,0,4,4" IsVisible="{Binding HasTitle}">
                        <Button DockPanel.Dock="Right" Classes="link" FontSize="12" Content="Edit" Command="{Binding EditCommand}" />
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FolderNodeViewModel">
                            <Button Classes="folder" Classes.current="{Binding IsCurrent}" Classes.drop="{Binding IsDropTarget}" Classes.important="{Binding IsImportant}"
                                    Padding="{Binding Indent}" Command="{Binding OpenCommand}"
                                    DragDrop.AllowDrop="True" DragDrop.DragOver="FolderDragOver" DragDrop.DragLeave="FolderDragLeave" DragDrop.Drop="FolderDrop">
                              <Button.ContextMenu>
                                <ContextMenu IsVisible="{Binding IsRealFolder}">
                                  <MenuItem Header="Mark all as read" Command="{Binding MarkAllReadCommand}" IsEnabled="{Binding IsRealFolder}" />
                                  <Separator />
                                  <MenuItem Header="New folder inside" Command="{Binding NewFolderCommand}" IsEnabled="{Binding IsRealFolder}" />
                                  <MenuItem Header="Rename" Command="{Binding RenameCommand}" IsEnabled="{Binding CanChange}" />
                                  <MenuItem Header="Remove" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanChange}" />
                                </ContextMenu>
                              </Button.ContextMenu>
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding UnreadText}" />
                                <c:Icon Classes="foldericon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="15" Margin="0,0,8,0" />
                                <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="folder newfolder" Padding="10,5" Command="{Binding NewFolderCommand}" IsVisible="{Binding HasTitle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Data="{StaticResource Icon.FolderPlus}" Size="15" />
                          <TextBlock Text="New folder" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Categories: your own, each with its colour dot -->
              <DockPanel Margin="10,0,4,4">
                <Button DockPanel.Dock="Right" Classes="link" FontSize="12" Content="New" Command="{Binding NewCategoryCommand}" ToolTip.Tip="Make a category" />
                <TextBlock FontWeight="SemiBold" Text="Categories" />
              </DockPanel>
              <TextBlock Classes="muted" FontSize="12" Margin="10,0,8,6" TextWrapping="Wrap" IsVisible="{Binding !HasCategories}"
                         Text="Make your own, like Waiting or Accounts, each with a colour. They show as dots on the mail." />
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryNodeViewModel">
                    <Button Classes="folder" Classes.current="{Binding IsCurrent}" Classes.drop="{Binding IsDropTarget}" Padding="10,6" Command="{Binding OpenCommand}"
                            DragDrop.AllowDrop="True" DragDrop.DragOver="CategoryDragOver" DragDrop.DragLeave="CategoryDragLeave" DragDrop.Drop="CategoryDrop">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Rename or change colour" Command="{Binding EditCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:CategoryDot Colour="{Binding Colour}" Size="10" Margin="2,0,1,0" />
                        <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Message list -->
      <Border c:PanelGrid.Pane="messages" c:PanelGrid.DefaultWidth="380" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <c:Spinner IsVisible="{Binding IsBusy}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip.Tip="Talking to the mail server" />
                <Button Classes="quiet" Content="Check for mail" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Classes="quiet" Padding="8,6" ToolTip.Tip="Panes: show, hide and move them">
                  <c:Icon Data="{StaticResource Icon.Panels}" Size="16" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Folders" DataContext="{Binding Panels[folders]}" x:DataType="vm:PaneViewModel">
                        <MenuItem Header="Show" ToggleType="CheckBox" IsChecked="{Binding IsShown}" IsEnabled="{Binding CanHide}" />
                        <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" />
                        <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" />
                      </MenuItem>
                      <MenuItem Header="Messages" DataContext="{Binding Panels[messages]}" x:DataType="vm:PaneViewModel">
                        <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" />
                        <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" />
                      </MenuItem>
                      <MenuItem Header="Reading pane" DataContext="{Binding Panels[reader]}" x:DataType="vm:PaneViewModel">
                        <MenuItem Header="Show" ToggleType="CheckBox" IsChecked="{Binding IsShown}" IsEnabled="{Binding CanHide}" />
                        <MenuItem Header="Move left" Command="{Binding MoveLeftCommand}" />
                        <MenuItem Header="Move right" Command="{Binding MoveRightCommand}" />
                      </MenuItem>
                      <Separator />
                      <MenuItem Header="Put the panes back" Command="{Binding Panels.ResetCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button Classes="primary" Content="Write" Command="{Binding WriteCommand}" />
              </StackPanel>
              <TextBlock Classes="h2" Text="{Binding ListTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox Text="{Binding Search}" PlaceholderText="Search all mail by sender, subject or words" />
            <ItemsControl ItemsSource="{Binding Filters}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <Button Classes="filterchip" Classes.chosen="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- A mail just sent, still waiting a few seconds so it can be taken back -->
            <Border Classes="pending" IsVisible="{Binding HasPendingSend}" Padding="10,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="quiet" Content="Undo" Command="{Binding UndoSendCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding PendingSendText}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <!-- Snooze until a picked day and hour -->
            <Border Classes="pending" IsVisible="{Binding PickingSnooze}" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Snooze until" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CalendarDatePicker SelectedDate="{Binding SnoozeDay}" DisplayDateStart="{x:Static sys:DateTime.Today}" Width="160"
                                      SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" />
                  <ComboBox ItemsSource="{x:Static vm:MailViewModel.SnoozeHours}" SelectedItem="{Binding SnoozeHour}" Width="100">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="x:Int32">
                        <TextBlock Text="{Binding StringFormat='{}{0:00}:00'}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Snooze" Command="{Binding ConfirmSnoozePickCommand}" />
                  <Button Classes="link" Content="Cancel" Command="{Binding CancelSnoozePickCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <ComboBox ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding ClientFilter}" IsVisible="{Binding HasClientChoices}"
                      HorizontalAlignment="Stretch" ToolTip.Tip="Show only one client's mail in this list" />
            <CheckBox Content="Group into conversations" IsChecked="{Binding Conversations, Mode=OneWay}" Command="{Binding ToggleConversationsCommand}"
                      IsVisible="{Binding CanGroup}" FontSize="12" ToolTip.Tip="Replies sit under the first mail. Switched on or off for this list only." />
            <TextBlock FontSize="12" Classes="muted" Classes.problem="{Binding StatusIsProblem}" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,8" IsVisible="{Binding CanLoadOlder}">
            <Button Classes="link" Content="Load older mail" Command="{Binding LoadOlderCommand}" HorizontalAlignment="Center" />
          </Border>
          <Grid>
            <TextBlock Classes="muted" Margin="16" Text="{Binding EmptyText}" IsVisible="{Binding NoMessages}" TextWrapping="Wrap" />
            <!-- A ListBox builds only the rows on screen and reuses them while scrolling. -->
            <ListBox x:Name="MessageList" Classes="messages" ItemsSource="{Binding Messages}" Selection="{Binding Selection}" SelectionMode="Multiple"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsTextSearchEnabled="False" KeyDown="MessageKeyDown">
              <ListBox.ContextMenu>
                <ContextMenu Opening="MessageMenuOpening" />
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MailRowViewModel">
                  <Border Classes="mailcard" Classes.unread="{Binding IsUnread}">
                    <Grid ColumnDefinitions="14,*" Classes="mailrow" Classes.unread="{Binding IsUnread}" Background="Transparent">
                      <Border Grid.Column="0" Classes="unreaddot" IsVisible="{Binding IsUnread}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Margin="8,0,0,0" Text="{Binding When}" />
                          <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.Paperclip}" Size="13" Margin="6,0,0,0" Foreground="{DynamicResource Muted}"
                                  IsVisible="{Binding HasAttachments}" ToolTip.Tip="Has attachments" />
                          <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.Flag}" Size="13" Margin="6,0,0,0" Foreground="{DynamicResource Important}"
                                  IsVisible="{Binding IsImportant}" ToolTip.Tip="Important" />
                          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Dots}" IsVisible="{Binding HasDots}" Margin="6,0,0,0"
                                        VerticalAlignment="Center" ToolTip.Tip="{Binding DotsTip}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="core:MailCategory">
                                <c:CategoryDot Colour="{Binding Colour}" Size="8" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border DockPanel.Dock="Right" Classes="threadcount" IsVisible="{Binding IsConversation}" Margin="6,0,0,0"
                                  ToolTip.Tip="Mails in this conversation">
                            <TextBlock Text="{Binding Count}" FontSize="11" />
                          </Border>
                          <c:Monogram DockPanel.Dock="Left" Text="{Binding ClientName}" Size="18" Margin="0,0,6,0" IsVisible="{Binding HasClient}"
                                      ToolTip.Tip="{Binding ClientName}" VerticalAlignment="Center" />
                          <TextBlock Classes="who" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel>
                          <Border DockPanel.Dock="Right" Classes="mailtag" Margin="6,0,0,0" IsVisible="{Binding ShowMailbox}">
                            <TextBlock FontSize="11" Text="{Binding MailboxTag}" Foreground="{DynamicResource InvoiceTint}" />
                          </Border>
                          <TextBlock Classes="subject" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </Border>

      <!-- The open message, or what to do with several -->
      <DockPanel c:PanelGrid.Pane="reader" c:PanelGrid.DefaultWidth="560" Background="{DynamicResource Surface}">
        <!-- What you can do to the picked mail. The same buttons work for one message or many. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,8" IsVisible="{Binding ShowActions}">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="tool" Command="{Binding ArchiveCommand}" ToolTip.Tip="Archive (E)">
              <c:Icon Data="{StaticResource Icon.Archive}" Size="17" />
            </Button>
            <Button Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete (Delete key)">
              <c:Icon Data="{StaticResource Icon.Trash}" Size="17" />
            </Button>
            <Rectangle Classes="toolgap" />
            <Button Classes="tool" Command="{Binding ToggleImportantCommand}" ToolTip.Tip="Important on or off (I)">
              <c:Icon Data="{StaticResource Icon.Flag}" Size="17" />
            </Button>
            <Button Classes="tool" Command="{Binding ToggleReadCommand}" ToolTip.Tip="Read or unread (U)">
              <c:Icon Data="{StaticResource Icon.MailOpen}" Size="17" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Categories">
              <c:Icon Data="{StaticResource Icon.Tag}" Size="17" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="CategoryFlyoutOpening" />
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Snooze until later">
              <c:Icon Data="{StaticResource Icon.Snooze}" Size="17" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="SnoozeFlyoutOpening" />
              </Button.Flyout>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Move to a folder">
              <c:Icon Data="{StaticResource Icon.FolderMove}" Size="17" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="MoveFlyoutOpening" />
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
        <Grid>
          <TextBlock Classes="muted" Text="Pick a message to read it." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowNothing}" />
          <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowMany}">
            <c:Icon Data="{StaticResource Icon.Mail}" Size="32" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" Text="{Binding ManyText}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="Use the buttons above, right-click, or drag them onto a folder or category." HorizontalAlignment="Center" />
          </StackPanel>
          <Panel IsVisible="{Binding HasComposer}">
            <v:ComposeView DataContext="{Binding Composer}" />
          </Panel>
          <Panel IsVisible="{Binding ShowReader}">
          <DockPanel DataContext="{Binding Reader}" x:DataType="vm:MailReaderViewModel">
            <!-- At the top, kept short so the mail itself has the room: subject, sender, date, what to do. -->
            <StackPanel DockPanel.Dock="Top" Margin="24,14,24,8" Spacing="8" Background="Transparent">
              <StackPanel.ContextMenu>
                <ContextMenu Opening="MessageMenuOpening" />
              </StackPanel.ContextMenu>
              <DockPanel>
                <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.Flag}" Size="18" Margin="10,4,0,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource Important}" IsVisible="{Binding IsImportant}" ToolTip.Tip="Important" />
                <TextBlock Classes="h2" Text="{Binding Subject}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Margin="12,0,0,0" Text="{Binding Date}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Classes="link" FontSize="12" Padding="8,0" Content="{Binding RecipientsToggleText}" Command="{Binding ToggleRecipientsCommand}"
                        ToolTip.Tip="Who else it went to" VerticalAlignment="Center" />
                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding From}">
                  <Run Text="{Binding FromName}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding FromAddress}" Foreground="{DynamicResource Muted}" FontSize="12" />
                </TextBlock>
              </DockPanel>
              <StackPanel Spacing="2" IsVisible="{Binding ShowRecipients}">
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap">
                  <Run Text="To " /><Run Text="{Binding To}" />
                </TextBlock>
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasCc}">
                  <Run Text="Cc " /><Run Text="{Binding Cc}" />
                </TextBlock>
              </StackPanel>
              <DockPanel>
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}" VerticalAlignment="Center" Margin="8,0,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:MailCategory">
                      <Border Classes="categorytag">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:CategoryDot Colour="{Binding Colour}" Size="8" />
                          <TextBlock FontSize="12" Text="{Binding Name}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel ItemSpacing="6" LineSpacing="6">
                  <Button Classes="primary" Content="Reply" Command="{Binding ReplyCommand}" IsVisible="{Binding IsNotDraft}" IsEnabled="{Binding CanWrite}" />
                  <Button Classes="quiet" Content="Reply all" Command="{Binding ReplyAllCommand}" IsVisible="{Binding IsNotDraft}" IsEnabled="{Binding CanWrite}" />
                  <Button Classes="quiet" Content="Forward" Command="{Binding ForwardCommand}" IsVisible="{Binding IsNotDraft}" IsEnabled="{Binding CanWrite}" />
                  <Button Classes="primary" Content="Edit draft" Command="{Binding EditDraftCommand}" IsVisible="{Binding IsDraft}" IsEnabled="{Binding CanWrite}" />
                </WrapPanel>
              </DockPanel>
              <Border Classes="card" Padding="12,8" IsVisible="{Binding IsScheduled}" Background="{DynamicResource InvoiceSoft}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="link" Content="Don't send it" Command="{Binding DontSendCommand}" Margin="8,0,0,0" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding ScheduledText}" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <Border Classes="card" Padding="12,8" IsVisible="{Binding HasDraftedBy}" Background="{DynamicResource InvoiceSoft}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DraftedBy}" />
              </Border>

              <Border Classes="card" Padding="12,8" IsVisible="{Binding CanShowImages}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="link" Content="Show pictures" Command="{Binding ShowImagesCommand}" />
                  <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="Pictures from the internet are hidden so the sender can't tell you opened this." />
                </DockPanel>
              </Border>

            </StackPanel>

            <!-- Under the mail: its attachments, then the rest of the conversation. Each folds up to a line. -->
            <StackPanel DockPanel.Dock="Bottom">
              <Border Classes="underbar" IsVisible="{Binding HasAttachments}">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="link" FontSize="12" Content="Save all to Downloads" Command="{Binding SaveAllCommand}" />
                    <Button Classes="threadhead" Command="{Binding ToggleAttachmentsCommand}" HorizontalAlignment="Left" Padding="0,2"
                            ToolTip.Tip="Fold the attachments up or open them out">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" IsVisible="{Binding AttachmentsOpen}" VerticalAlignment="Center" />
                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" IsVisible="{Binding !AttachmentsOpen}" VerticalAlignment="Center" />
                        <c:Icon Data="{StaticResource Icon.Paperclip}" Size="13" VerticalAlignment="Center" />
                        <TextBlock Classes="label" Text="{Binding AttachmentsTitle}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DockPanel>
                  <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding AttachmentsOpen}">
                    <ItemsControl ItemsSource="{Binding Attachments}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                          <Button Classes="attachchip" Command="{Binding ActivateCommand}" ToolTip.Tip="Click to show it. Right-click for more">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Show it here" Command="{Binding PreviewCommand}" IsVisible="{Binding CanPreview}" />
                                <MenuItem Header="Open in its program" Command="{Binding OpenCommand}" />
                                <MenuItem Header="Open in the PDF tools" Command="{Binding OpenInPdfToolsCommand}" IsVisible="{Binding IsPdf}" />
                                <Separator />
                                <MenuItem Header="Save to Downloads" Command="{Binding SaveCommand}" />
                                <MenuItem Header="Save as…" Command="{Binding SaveAsCommand}" />
                                <MenuItem Header="Save in the client's folder" Command="{Binding SaveToClientCommand}" IsVisible="{Binding CanSaveToClient}" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <c:Icon Data="{StaticResource Icon.Paperclip}" Size="13" VerticalAlignment="Center" Opacity="0.7" />
                              <TextBlock Text="{Binding Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <TextBlock Classes="muted" FontSize="11" Text="{Binding Size}" VerticalAlignment="Center" />
                              <Button Classes="sidebutton" Command="{Binding SaveCommand}" ToolTip.Tip="Save to Downloads" Padding="3">
                                <c:Icon Data="{StaticResource Icon.Download}" Size="13" />
                              </Button>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding AttachmentMessage}" TextWrapping="Wrap" IsVisible="{Binding HasAttachmentMessage}" />
                </StackPanel>
              </Border>
              <Border Classes="underbar" IsVisible="{Binding HasThread}">
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                  <!-- The rest of the conversation, stacked: click a line to open that mail. -->
              <Border Classes="threadstack" IsVisible="{Binding HasThread}">
                <StackPanel>
                  <Button Classes="threadhead" Command="{Binding ToggleThreadCommand}" ToolTip.Tip="{Binding ThreadToggleTip}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" IsVisible="{Binding ThreadOpen}" VerticalAlignment="Center" />
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" IsVisible="{Binding !ThreadOpen}" VerticalAlignment="Center" />
                      <TextBlock Classes="label" Text="{Binding ThreadTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <ItemsControl ItemsSource="{Binding ThreadLines}" IsVisible="{Binding ThreadOpen}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThreadLineViewModel">
                        <Button Classes="threadline" Classes.open="{Binding IsOpen}" Command="{Binding OpenCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding When}" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Classes="who" Classes.unread="{Binding IsUnread}" Text="{Binding Who}" Width="150"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
              <Grid>
                <TextBlock Classes="muted" Margin="24" Text="Opening…" IsVisible="{Binding IsLoading}" />
                <TextBlock Classes="problem" Margin="24" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
                <!-- Mail is shown on paper white in every look: senders colour their text for a white page. -->
                <Border Background="{DynamicResource Paper}" CornerRadius="6" Margin="12,8" Padding="12,8" IsVisible="{Binding IsNotPreviewing}">
                  <html:HtmlPanel x:Name="Body" Text="{Binding Html}" Background="{DynamicResource Paper}" />
                </Border>
                <!-- A PDF or picture shown here in place of the mail, page by page. -->
                <Panel IsVisible="{Binding IsPreviewing}">
                  <DockPanel DataContext="{Binding Preview}" x:DataType="vm:AttachmentPreviewViewModel">
                    <Border DockPanel.Dock="Top" Padding="24,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                          <Button Classes="link" Content="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open it in another program" />
                          <Button Classes="link" Content="Save" Command="{Binding SaveCommand}" />
                          <Button Classes="link" Content="PDF tools" Command="{Binding EditPdfCommand}" IsVisible="{Binding CanEditPdf}"
                                  ToolTip.Tip="Open it in the PDF tools to sign it, fill it in or take pages out" />
                          <Button Classes="quiet" Content="Back to the mail" Command="{Binding CloseCommand}" />
                        </StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="24,8,24,0" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                    <Panel>
                      <TextBlock Classes="muted" Margin="24" Text="Opening…" IsVisible="{Binding IsLoading}" />
                      <ScrollViewer Background="{DynamicResource Canvas}">
                        <ItemsControl ItemsSource="{Binding Pages}" Margin="24,16">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="Bitmap">
                              <!-- White behind each page, as on paper, in light and dark alike. -->
                              <Border Background="{DynamicResource Paper}" BoxShadow="{DynamicResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <Image Source="{Binding}" Stretch="Uniform" StretchDirection="DownOnly" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Panel>
                  </DockPanel>
                </Panel>
              </Grid>
            </Border>
          </DockPanel>
          </Panel>
        </Grid>
      </DockPanel>
    </c:PanelGrid>
  </Grid>
</UserControl>
