<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Webignite.Desktop.ViewModels"
        x:Class="Webignite.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.png"
        Title="Webignite"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="232,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource Nav}" Padding="14,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,22" Spacing="2">
          <TextBlock Text="Webignite" FontSize="20" FontWeight="Bold" Foreground="{StaticResource NavText}" />
          <TextBlock Text="Quotes, invoices and more" FontSize="12" Foreground="{StaticResource NavMuted}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,0" Spacing="6">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="{StaticResource NavSelected}" IsVisible="{Binding Updates.IsReady}"
                  Command="{Binding Updates.RestartCommand}"
                  Content="{Binding Updates.ReadyVersion, StringFormat='Update to {0}: restart'}" />
          <TextBlock FontSize="11" Foreground="{StaticResource NavMuted}" Text="Runs on this PC. Your data stays here." TextWrapping="Wrap" />
          <TextBlock FontSize="11" Foreground="{StaticResource NavMuted}" Text="{Binding Updates.VersionText}" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Modules}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:Module">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="tag" IsVisible="{Binding IsLater}">
                  <TextBlock Text="Later" FontSize="11" Foreground="{StaticResource NavMuted}" />
                </Border>
                <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Column="1" IsVisible="{Binding Selected.Scrolls}">
      <ContentControl Content="{Binding Selected.ScrollingPage}" Margin="36,30" MaxWidth="1040" HorizontalAlignment="Stretch" />
    </ScrollViewer>
    <ContentControl Grid.Column="1" Content="{Binding Selected.FullPage}" IsVisible="{Binding Selected.FullBleed}" />
  </Grid>
</Window>
