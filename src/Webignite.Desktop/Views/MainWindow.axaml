<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Webignite.Desktop.ViewModels"
        xmlns:search="using:Webignite.Core.Search"
        xmlns:c="using:Webignite.Desktop.Controls"
        x:Class="Webignite.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.png"
        Title="Webignite"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!-- Ctrl+K and Ctrl+B are not here: writing uses them too (a link, bold), so the window only takes them when
       nothing on the page did. See OnKeyDown. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshPageCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ToggleShortcutsCommand}" />
    <KeyBinding Gesture="Ctrl+M" Command="{Binding MenuPart.ToggleMenuCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseThisTabCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding NextTabCommand}" CommandParameter="-1" />
    <KeyBinding Gesture="Ctrl+Shift+D1" Command="{Binding TogglePaneCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+Shift+D2" Command="{Binding TogglePaneCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+Shift+D3" Command="{Binding TogglePaneCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+Shift+D4" Command="{Binding TogglePaneCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding GoToCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding GoToCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding GoToCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding GoToCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding GoToCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding GoToCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding GoToCommand}" CommandParameter="7" />
    <KeyBinding Gesture="Ctrl+D8" Command="{Binding GoToCommand}" CommandParameter="8" />
    <KeyBinding Gesture="Ctrl+D9" Command="{Binding GoToCommand}" CommandParameter="9" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="Auto,*">

    <!-- The sidebar, in its three widths. Not shown at all when the menu is the Menu button or the dock. -->
    <Panel Grid.Column="0" IsVisible="{Binding MenuPart.IsSidebarMenu}">
    <!-- The sidebar tucked away: a thin strip with the button that brings it back (or Ctrl+B). -->
    <Border Grid.Column="0" Width="44" Background="{DynamicResource Nav}" Padding="6,18" IsVisible="{Binding Sidebar.IsHidden}">
      <Button Classes="navtoggle" VerticalAlignment="Top" HorizontalAlignment="Center" Command="{Binding Sidebar.ToggleCommand}"
              ToolTip.Tip="Show the sidebar (Ctrl+B)">
        <c:Icon Data="{StaticResource Icon.SidebarShow}" Size="18" />
      </Button>
    </Border>

    <!-- The sidebar folded to icons: each page's icon, its name on hover, the Mail badge as a dot with the count. -->
    <Border Grid.Column="0" Width="64" Background="{DynamicResource Nav}" Padding="8,18" IsVisible="{Binding Sidebar.IsIcons}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
          <Button Classes="navtoggle" HorizontalAlignment="Center" Command="{Binding Sidebar.ToggleCommand}" ToolTip.Tip="{Binding Sidebar.ToggleTip}">
            <c:Icon Data="{StaticResource Icon.SidebarHide}" Size="18" />
          </Button>
          <Button Classes="navtoggle" HorizontalAlignment="Center" Command="{Binding Search.ShowCommand}" ToolTip.Tip="Search (Ctrl+K)">
            <c:Icon Data="{StaticResource Icon.Search}" Size="18" />
          </Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
          <Button Classes="navtoggle" HorizontalAlignment="Center" Command="{Binding OpenChatCommand}" ToolTip.Tip="{Binding ChatPartnerTip}">
            <Panel>
              <c:Icon Data="{StaticResource Icon.Chat}" Size="18" Foreground="{DynamicResource NavText}" />
              <Ellipse Width="8" Height="8" Fill="{Binding ChatPartnerShown, Converter={x:Static c:PresenceColours.Brush}}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-3" />
              <Border Classes="badge" IsVisible="{Binding HasChatUnread}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0">
                <TextBlock Text="{Binding ChatUnread}" FontSize="{DynamicResource Text10}" FontWeight="SemiBold" />
              </Border>
            </Panel>
          </Button>
          <Button Classes="navtoggle" HorizontalAlignment="Center" IsVisible="{Binding Timer.IsRunning}" Command="{Binding OpenTimeCommand}"
                  ToolTip.Tip="{Binding Timer.Clock, StringFormat='Timer running, {0}. Click to open Time.'}">
            <c:Icon Data="{StaticResource Icon.Time}" Size="18" Foreground="{DynamicResource NavText}" />
          </Button>
          <c:Spinner Size="12" Foreground="{DynamicResource NavText}" HorizontalAlignment="Center" IsVisible="{Binding Work.IsWorking}"
                     ToolTip.Tip="{Binding Work.Text}" />
        </StackPanel>
        <ListBox Classes="nav icons" ItemsSource="{Binding Sidebar.IconPages}" SelectedItem="{Binding SelectedIcon}"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:SidebarBack">
              <Panel Background="Transparent" ToolTip.Tip="Back to the main sidebar" ToolTip.Placement="Right">
                <c:Icon Classes="navicon" Data="{StaticResource Icon.Back}" Size="20" HorizontalAlignment="Center" />
              </Panel>
            </DataTemplate>
            <!-- A group as one icon: its pages open in a list beside it when the pointer is on it, or on a click. -->
            <DataTemplate DataType="vm:NavGroup">
              <Panel Background="Transparent" PointerEntered="ShowGroupList" Tapped="ShowGroupList">
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="RightEdgeAlignedTop" ShowMode="TransientWithDismissOnPointerMoveAway" HorizontalOffset="6">
                    <StackPanel MinWidth="210" Spacing="2" Margin="-6">
                      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" FontWeight="SemiBold" Text="{Binding Name}" Margin="12,6,12,4" />
                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:GroupEntry">
                            <Button Classes="quiet" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Click="OpenGroupEntry">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <c:Icon Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="16" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="20" HorizontalAlignment="Center" />
              </Panel>
            </DataTemplate>
            <DataTemplate DataType="vm:SectionLink">
              <Panel Background="Transparent" ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right">
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="20" HorizontalAlignment="Center" />
              </Panel>
            </DataTemplate>
            <DataTemplate DataType="vm:ToolLink">
              <Panel Background="Transparent" ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right">
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="20" HorizontalAlignment="Center" />
              </Panel>
            </DataTemplate>
            <DataTemplate DataType="vm:Module">
              <Panel Background="Transparent" ToolTip.Tip="{Binding Title}" ToolTip.Placement="Right">
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="20" HorizontalAlignment="Center" />
                <Border Classes="badge" IsVisible="{Binding HasBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
                  <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource Text10}" FontWeight="SemiBold" />
                </Border>
              </Panel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Sidebar -->
    <Border Grid.Column="0" Width="232" Background="{DynamicResource Nav}" Padding="14,18" IsVisible="{Binding Sidebar.IsFull}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,0,6,12" Spacing="2">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="navtoggle" VerticalAlignment="Top" Margin="0,-2,-6,0" Command="{Binding Sidebar.ToggleCommand}"
                    ToolTip.Tip="{Binding Sidebar.ToggleTip}">
              <c:Icon Data="{StaticResource Icon.SidebarHide}" Size="18" />
            </Button>
            <TextBlock Text="Webignite" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource NavText}" />
          </DockPanel>
          <TextBlock Text="Quotes, invoices and more" FontSize="{DynamicResource Text12}" Foreground="{DynamicResource NavMuted}" />
          <Button Classes="navsearch" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding Search.ShowCommand}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="{DynamicResource Text11}" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
              <c:Icon Classes="navicon" Data="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource NavMuted}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Text="Search" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
            </DockPanel>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="6,8,6,0" Spacing="6">
          <!-- Chat with your partner, in a small window; the count is messages not read yet. -->
          <Button Classes="navsearch" HorizontalAlignment="Stretch" Command="{Binding OpenChatCommand}" ToolTip.Tip="{Binding ChatPartnerTip}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasChatUnread}" VerticalAlignment="Center">
                <TextBlock Text="{Binding ChatUnread}" FontSize="{DynamicResource Text10}" FontWeight="SemiBold" />
              </Border>
              <!-- My partner's status: teal available, yellow away, busy, grey offline. -->
              <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                       Fill="{Binding ChatPartnerShown, Converter={x:Static c:PresenceColours.Brush}}" />
              <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Chat}" Size="16" Foreground="{DynamicResource NavText}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock Text="Chat" Foreground="{DynamicResource NavText}" VerticalAlignment="Center" />
            </DockPanel>
          </Button>
          <!-- The running timer, from any page. Clicking it opens Time. -->
          <Button Classes="navsearch" HorizontalAlignment="Stretch" IsVisible="{Binding Timer.IsRunning}" Command="{Binding OpenTimeCommand}"
                  ToolTip.Tip="Timer running. Click to open Time.">
            <DockPanel>
              <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Time}" Size="16" Foreground="{DynamicResource NavText}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding Timer.Clock}" Foreground="{DynamicResource NavText}" FontFeatures="+tnum" VerticalAlignment="Center" Margin="8,0,0,0" />
              <TextBlock Text="{Binding Timer.RunningFor}" Foreground="{DynamicResource NavMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="{DynamicResource Text12}" />
            </DockPanel>
          </Button>
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="{DynamicResource NavSelected}" IsVisible="{Binding Updates.IsReady}"
                  Command="{Binding Updates.RestartCommand}"
                  Content="{Binding Updates.ReadyVersion, StringFormat='Update to {0}: restart'}" />
          <!-- Background work, e.g. checking mail, so it's clear something is happening. -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0" IsVisible="{Binding Work.IsWorking}">
            <c:Spinner Size="12" Foreground="{DynamicResource NavText}" VerticalAlignment="Center" />
            <TextBlock FontSize="{DynamicResource Text12}" Foreground="{DynamicResource NavText}" Text="{Binding Work.Text}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock FontSize="{DynamicResource Text11}" Foreground="{DynamicResource NavMuted}" TextWrapping="Wrap"
                     Text="{Binding Updates.VersionText, StringFormat='{}{0} · Data stays on this PC'}" />
          <!-- Looks for a new version now rather than waiting for the hourly look -->
          <Button Classes="link" FontSize="{DynamicResource Text11}" Padding="0" HorizontalAlignment="Left" Foreground="{DynamicResource NavText}"
                  Content="Check for updates" Command="{Binding Updates.CheckNowCommand}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Updates.CanUpdate" />
                <Binding Path="!Updates.IsReady" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <TextBlock FontSize="{DynamicResource Text11}" Foreground="{DynamicResource NavMuted}" TextWrapping="Wrap" Text="{Binding Updates.CheckNote}"
                     IsVisible="{Binding Updates.CheckNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- The main list, and the Planner one that takes its place while a Planner page is open -->
        <Panel>
          <Panel.DataTemplates>
            <DataTemplate DataType="vm:NavGroup">
              <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                  <ContextMenu IsVisible="{Binding CanFold}">
                    <MenuItem Header="{Binding FoldText}" Command="{Binding ToggleFoldCommand}" />
                    <MenuItem Header="Move group up" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="Move group down" Command="{Binding MoveDownCommand}" />
                    <Separator />
                    <MenuItem Header="Choose what is on the menu…" Command="{Binding EditMenuCommand}" />
                    <MenuItem Header="Put the sidebar's order back" Command="{Binding ResetSidebarCommand}" />
                  </ContextMenu>
                </DockPanel.ContextMenu>
                <Panel DockPanel.Dock="Right" IsVisible="{Binding CanFold}" VerticalAlignment="Center">
                  <c:Icon Classes="fold" Size="14" Foreground="{DynamicResource NavMuted}" IsVisible="{Binding IsOpen}" Data="{StaticResource Icon.ChevronDown}" />
                  <c:Icon Classes="fold" Size="14" Foreground="{DynamicResource NavMuted}" IsVisible="{Binding IsFolded}" Data="{StaticResource Icon.ChevronRight}" />
                </Panel>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text10x5}" FontWeight="SemiBold" LetterSpacing="0.6" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
            <!-- The top of the Planner sidebar: back to the main one -->
            <DataTemplate DataType="vm:SidebarBack">
              <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent" ToolTip.Tip="Back to the main sidebar">
                <c:Icon Classes="navicon" Data="{StaticResource Icon.Back}" Size="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
            <!-- A heading in the Planner sidebar, with + when something can be added under it -->
            <DataTemplate DataType="vm:NavHeading">
              <DockPanel Background="Transparent" IsVisible="{Binding !IsGap}">
                <Button DockPanel.Dock="Right" Classes="navtoggle" Padding="3" Margin="0,0,-4,0" IsVisible="{Binding HasAdd}"
                        Command="{Binding AddCommand}" ToolTip.Tip="{Binding AddTip}" VerticalAlignment="Center">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="13" Foreground="{DynamicResource NavMuted}" />
                </Button>
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text10x5}" FontWeight="SemiBold" LetterSpacing="0.6" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
            <!-- A section with a sidebar of its own (Planner): the arrow says it opens one -->
            <DataTemplate DataType="vm:SectionLink">
              <DockPanel Background="Transparent" ToolTip.Tip="Home, My tasks, projects, Calendar, Week and Time">
                <DockPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                    <Separator />
                    <MenuItem Header="Take off the menu" Command="{Binding TakeOffMenuCommand}" />
                    <MenuItem Header="Choose what is on the menu…" Command="{Binding EditMenuCommand}" />
                    <MenuItem Header="Put the sidebar's order back" Command="{Binding ResetSidebarCommand}" />
                  </ContextMenu>
                </DockPanel.ContextMenu>
                <c:Icon DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronRight}" Size="14" Foreground="{DynamicResource NavMuted}" VerticalAlignment="Center" />
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="18"
                        Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:ToolLink">
              <DockPanel Background="Transparent" ToolTip.Tip="Opens in a small window">
                <DockPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                    <Separator />
                    <MenuItem Header="Take off the menu" Command="{Binding TakeOffMenuCommand}" />
                    <MenuItem Header="Choose what is on the menu…" Command="{Binding EditMenuCommand}" />
                    <MenuItem Header="Put the sidebar's order back" Command="{Binding ResetSidebarCommand}" />
                  </ContextMenu>
                </DockPanel.ContextMenu>
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="18"
                        Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:SubLink">
              <DockPanel Background="Transparent">
                <!-- The Projects page's minimised panes, under the entry on screen: click one to bring it back. -->
                <ItemsControl DockPanel.Dock="Bottom" Margin="30,4,0,0" ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).HiddenPanes}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaneViewModel">
                      <Button Classes="panechip" Command="{Binding RestoreCommand}" ToolTip.Tip="{Binding Title, StringFormat='Show {0} again'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Data="{StaticResource Icon.SidebarShow}" Size="12" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text12}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="18"
                        Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                <!-- A project is a small dot, set in a little under the pages, as in Asana's list of projects. -->
                <Ellipse Classes="projectdot" Width="7" Height="7" Margin="16,0,13,0" VerticalAlignment="Center" IsVisible="{Binding IsDot}" />
                <!-- A project: its coloured square with a small picture, as in Asana's sidebar -->
                <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding HasTile}"
                        Background="{Binding TileColour, Converter={x:Static c:ProjectColours.Brush}}">
                  <c:Icon Data="{Binding TileIcon, Converter={x:Static c:ProjectColours.Icon}}" Size="12" Foreground="{DynamicResource OnProject}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
              </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="vm:Module">
              <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open in new tab (Ctrl+click)"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NewTabForCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" />
                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" />
                    <Separator />
                    <MenuItem Header="Take off the menu" Command="{Binding TakeOffMenuCommand}" />
                    <MenuItem Header="Choose what is on the menu…" Command="{Binding EditMenuCommand}" />
                    <MenuItem Header="Put the sidebar's order back" Command="{Binding ResetSidebarCommand}" />
                  </ContextMenu>
                </DockPanel.ContextMenu>
                <!-- The page's minimised panes, under its name while it's on screen: click one to bring it back. -->
                <ItemsControl DockPanel.Dock="Bottom" Margin="30,4,0,0" ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).HiddenPanes}"
                              IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaneViewModel">
                      <Button Classes="panechip" Command="{Binding RestoreCommand}" ToolTip.Tip="{Binding Title, StringFormat='Show {0} again'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Data="{StaticResource Icon.SidebarShow}" Size="12" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text12}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasBadge}">
                  <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource Text11}" FontWeight="SemiBold" />
                </Border>
                <c:Icon Classes="navicon" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="18"
                        Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </Panel.DataTemplates>
          <ListBox x:Name="Nav" Classes="nav" ItemsSource="{Binding Sidebar.Items}" SelectedItem="{Binding SelectedNav}" IsVisible="{Binding !Sidebar.IsPlanner}"
                   ContainerPrepared="PrepareNavItem" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
          <ListBox x:Name="PlannerNav" Classes="nav" ItemsSource="{Binding Sidebar.PlannerItems}" SelectedItem="{Binding SelectedNav}" IsVisible="{Binding Sidebar.IsPlanner}"
                   ContainerPrepared="PrepareNavItem" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
        </Panel>
      </DockPanel>
    </Border>

    </Panel>

    <!-- Tabs, once there are two, then the page on screen -->
    <DockPanel Grid.Column="1">
      <!-- Without the sidebar: a bar along the top (Views/MenuBarView), and the dock along the bottom (Views/DockView).
           Both are made only while their menu is the one picked (MainWindow.Menu.cs). -->
      <ContentControl x:Name="MenuBarHost" DockPanel.Dock="Top" />
      <ContentControl x:Name="DockHost" DockPanel.Dock="Bottom" ZIndex="5" />
      <Border DockPanel.Dock="Top" Classes="tabstrip" IsVisible="{Binding ShowTabs}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="tabplus" Command="{Binding NewTabCommand}" ToolTip.Tip="New tab (Ctrl+T)" VerticalAlignment="Center">
            <c:Icon Data="{StaticResource Icon.Plus}" Size="14" />
          </Button>
          <ListBox x:Name="TabStrip" Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Current, Mode=OneWay}" SelectionChanged="TabPicked"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageHost">
                <DockPanel Background="Transparent" PointerReleased="TabReleased">
                  <DockPanel.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Close tab" InputGesture="Ctrl+W"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseThisTabCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Show on the right"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowOnRightCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Show on the left"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowOnLeftCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Open in new window"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PopOutTabCommand}" CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem Header="Close the other tabs"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseOtherTabsCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                  </DockPanel.ContextMenu>
                  <Button DockPanel.Dock="Right" Classes="tabclose" ToolTip.Tip="Close tab (Ctrl+W)" Margin="6,0,0,0"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseThisTabCommand}" CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Close}" Size="10" />
                  </Button>
                  <c:Icon Data="{Binding Module.Icon, Converter={x:Static c:IconConverter.Instance}}" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <!-- The setup guide: which step, what to do, Back and Next. The real page is beneath it, so nothing is set up twice. -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding WelcomePart.ShowingGuide}" Background="{DynamicResource InvoiceSoft}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
            <Button Classes="link" Content="Close the guide" Command="{Binding WelcomePart.EndGuideCommand}" VerticalAlignment="Center" />
            <Button Classes="quiet" Content="Back" Command="{Binding WelcomePart.GuideBackCommand}" IsVisible="{Binding WelcomePart.GuideCanGoBack}" />
            <Button Classes="primary" Content="{Binding WelcomePart.GuideNextLabel}" Command="{Binding WelcomePart.GuideNextCommand}" />
          </StackPanel>
          <StackPanel Spacing="6" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding WelcomePart.GuideProgress}" VerticalAlignment="Center" />
              <ProgressBar Value="{Binding WelcomePart.GuideFraction}" Minimum="0" Maximum="100" Width="140" Height="4" MinHeight="4" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="h2" Text="{Binding WelcomePart.GuideStep.Title}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding WelcomePart.GuideStep.Text}" />
            <Border Classes="ready" IsVisible="{Binding WelcomePart.GuideStepDone}" HorizontalAlignment="Left">
              <TextBlock TextWrapping="Wrap" Text="{Binding WelcomePart.GuideStep.DoneText}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <!-- The page on screen, and when the window is split, a second page beside it (arranged in MainWindow.Split.cs). -->
      <Grid x:Name="PageArea" ColumnDefinitions="*,0,0">
        <!-- A page narrower than it can be laid out in (one side of a split) scrolls sideways rather than squash. -->
        <DockPanel x:Name="MainPane" Grid.Column="0">
          <!-- When split, each side has a header: drag it to the other side to swap, or out of the window to pop it out. -->
          <Border x:Name="MainHeader" DockPanel.Dock="Top" Classes="sidehead" IsVisible="{Binding IsSplit}"
                  ToolTip.Tip="Drag to the other side to swap, or out of the window to open it in a window of its own">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="sidebutton" Command="{Binding SwapSidesCommand}" ToolTip.Tip="Swap sides">
                  <c:Icon Data="{StaticResource Icon.Swap}" Size="14" />
                </Button>
                <Button Classes="sidebutton" Command="{Binding PopOutMainSideCommand}" ToolTip.Tip="Open in a window of its own">
                  <c:Icon Data="{StaticResource Icon.NewWindow}" Size="14" />
                </Button>
                <Button Classes="sidebutton" Command="{Binding CloseMainSideCommand}" ToolTip.Tip="Close this side">
                  <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <c:Icon Data="{Binding Current.Module.Icon, Converter={x:Static c:IconConverter.Instance}, FallbackValue={x:Null}}" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Current.Title, FallbackValue=''}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Panel>
            <ScrollViewer IsVisible="{Binding Current.Scrolls}" HorizontalScrollBarVisibility="Auto">
              <c:FitWidth MinWidth="672">
                <TransitioningContentControl x:Name="ScrollingHost" Content="{Binding Current.ScrollingPage}" Margin="36,30" MaxWidth="{Binding Current.MaxContentWidth}" MinWidth="600" HorizontalAlignment="Stretch" />
              </c:FitWidth>
            </ScrollViewer>
            <ScrollViewer IsVisible="{Binding Current.FullBleed}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <TransitioningContentControl x:Name="FullHost" Content="{Binding Current.FullPage}" MinWidth="760" />
            </ScrollViewer>
          </Panel>
        </DockPanel>
        <GridSplitter x:Name="Divider" Grid.Column="1" Classes="divider" IsVisible="{Binding IsSplit}" ResizeDirection="Columns" />
        <DockPanel x:Name="BesidePane" Grid.Column="2" IsVisible="{Binding IsSplit}">
          <Border x:Name="BesideHeader" DockPanel.Dock="Top" Classes="sidehead"
                  ToolTip.Tip="Drag to the other side to swap, onto the tabs to make it a tab again, or out of the window to open it in a window of its own">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="sidebutton" Command="{Binding SwapSidesCommand}" ToolTip.Tip="Swap sides">
                  <c:Icon Data="{StaticResource Icon.Swap}" Size="14" />
                </Button>
                <Button Classes="sidebutton" Command="{Binding PutBesideBackCommand}" ToolTip.Tip="Back to a tab">
                  <c:Icon Data="{StaticResource Icon.Tiles}" Size="14" />
                </Button>
                <Button Classes="sidebutton" Command="{Binding PopOutBesideCommand}" ToolTip.Tip="Open in a window of its own">
                  <c:Icon Data="{StaticResource Icon.NewWindow}" Size="14" />
                </Button>
                <Button Classes="sidebutton" Command="{Binding CloseBesideCommand}" ToolTip.Tip="Close this side">
                  <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <c:Icon Data="{Binding Beside.Module.Icon, Converter={x:Static c:IconConverter.Instance}, FallbackValue={x:Null}}" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Beside.Title, FallbackValue=''}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Panel>
            <ScrollViewer IsVisible="{Binding Beside.Scrolls, FallbackValue=False}" HorizontalScrollBarVisibility="Auto">
              <c:FitWidth MinWidth="656">
                <ContentControl Content="{Binding Beside.ScrollingPage, FallbackValue={x:Null}}" Margin="28,24" MaxWidth="{Binding Beside.MaxContentWidth, FallbackValue=1040}" MinWidth="600" HorizontalAlignment="Stretch" />
              </c:FitWidth>
            </ScrollViewer>
            <ScrollViewer IsVisible="{Binding Beside.FullBleed, FallbackValue=False}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ContentControl Content="{Binding Beside.FullPage, FallbackValue={x:Null}}" MinWidth="760" />
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Grid>
    </DockPanel>

    <!-- The whole menu, over the page (Views/MenuOverlayView), made the first time it is opened. -->
    <ContentControl x:Name="MenuHost" Grid.ColumnSpan="2" IsVisible="{Binding MenuPart.IsMenuOpen}" />

    <!-- Ctrl+K search, over everything -->
    <Grid Grid.ColumnSpan="2" IsVisible="{Binding Search.IsOpen}" Background="{DynamicResource Scrim}" PointerPressed="CloseSearch">
      <Border Classes="card searchbox" Width="640" VerticalAlignment="Top" Margin="0,90,0,0" Padding="0" PointerPressed="KeepSearchOpen"
              BoxShadow="{DynamicResource OverlayShadow}">
        <DockPanel>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Classes="search" Text="{Binding Search.Query}" KeyDown="SearchKeys"
                   PlaceholderText="Find a client, person, quote, invoice, mail, to-do, note, login, file or domain" BorderThickness="0" Padding="18,14" FontSize="16" />
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="18,12" IsVisible="{Binding Search.ShowHint}"
                     Text="Type a name, an invoice number, a subject, a file name or a site. Enter opens, Esc closes." TextWrapping="Wrap" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="18,12" IsVisible="{Binding Search.NothingFound}" Text="Nothing found." />
          <ListBox ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Chosen}" MaxHeight="440"
                   Background="Transparent" Margin="6" DoubleTapped="OpenSearchHit" Tapped="OpenSearchHit">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="search:SearchHit">
                <DockPanel Margin="4,2">
                  <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding KindLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
    <!-- The welcome screen: sign in, a new account or an invite, when nobody is signed in (switched off while testing). -->
    <Grid Grid.ColumnSpan="2" IsVisible="{Binding WelcomePart.ShowingWelcome}" Background="{DynamicResource Scrim}">
      <Border Classes="card" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" BoxShadow="{DynamicResource OverlayShadow}">
        <StackPanel Spacing="14">
          <Image Source="/Assets/icon.png" Height="48" HorizontalAlignment="Left" />
          <TextBlock Classes="h1" Text="Welcome to Webignite" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="A short guide takes you through joining, Xero and ChatGPT, then shows you round. Your password never leaves this PC, and what's shared is locked here first." />
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Join with an invite code" Command="{Binding WelcomePart.WelcomeJoinCommand}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Sign in" Command="{Binding WelcomePart.WelcomeSignInCommand}" />
          <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Create an account" Command="{Binding WelcomePart.WelcomeCreateCommand}" />
          <Button Classes="link" HorizontalAlignment="Center" Content="Not now: use it on this PC only" Command="{Binding WelcomePart.WelcomeNotNowCommand}" />
        </StackPanel>
      </Border>
    </Grid>
    <!-- F1: the keyboard shortcuts. Click outside the box or press Esc to close. -->
    <Grid Grid.ColumnSpan="2" IsVisible="{Binding ShowingShortcuts}" Background="{DynamicResource Scrim}" PointerPressed="CloseShortcuts">
      <Border Classes="card searchbox" Width="640" MaxHeight="620" VerticalAlignment="Top" Margin="0,70,0,0" BoxShadow="{DynamicResource OverlayShadow}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Classes="link" Content="Close" Command="{Binding HideShortcutsCommand}" />
            <Button DockPanel.Dock="Right" Classes="link" Content="Change shortcuts" Command="{Binding ShortcutSettingsCommand}" Margin="0,0,14,0"
                    ToolTip.Tip="Settings, Shortcuts: the list, and where the ones that work from any program are picked" />
            <TextBlock Classes="h2" Text="Keyboard shortcuts" />
          </DockPanel>
          <ContentControl x:Name="ShortcutHost" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
