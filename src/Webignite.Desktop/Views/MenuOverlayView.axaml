<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.MenuOverlayView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.megamenu">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22,22,22,24" />
      <Setter Property="BoxShadow" Value="{DynamicResource OverlayShadow}" />
    </Style>
    <Style Selector="Button.menuentry">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.menuentry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <!-- While editing: what has been taken off is drawn fainter, in a dashed box, waiting to be put back. -->
    <Style Selector="Button.menuentry.off">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.available">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style Selector="Border.editmark">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0,0,0" />
    </Style>
    <Style Selector="Button.menuentry.current">
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
<Grid Background="{DynamicResource Scrim}" PointerPressed="CloseMenu">
  <Border Classes="megamenu" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,58,24,24" PointerPressed="KeepMenuOpen">
    <DockPanel>
      <!-- Edit, or while editing: what to do, and Done -->
      <DockPanel DockPanel.Dock="Top" Margin="10,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Classes="quiet" Content="Edit the menu" Command="{Binding EditMenuCommand}" IsVisible="{Binding IsMenuBrowsing}"
                  ToolTip.Tip="Choose what is on the menu, and in what order" />
          <Button Classes="link" Content="Put everything back" Command="{Binding PutAllBackOnMenuCommand}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsMenuEditing" />
                <Binding Path="HasMenuTakenOff" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <Button Classes="primary" Content="Done" Command="{Binding DoneEditingMenuCommand}" IsVisible="{Binding IsMenuEditing}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsMenuEditing}" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Classes="h2" Text="Choose what is on the menu" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                     Text="Click one to take it off; click one under Available to put it back. Drag to change the order. What is off can still be found with search (Ctrl+K), and shortcuts still work." />
        </StackPanel>
      </DockPanel>
      <!-- What has been taken off, always in view while editing, to put back with a click or a drag -->
      <Border DockPanel.Dock="Bottom" Classes="available" IsVisible="{Binding IsMenuEditing}">
        <StackPanel Spacing="4">
          <TextBlock Classes="label caps" Text="Available" Margin="10,0,0,2" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Margin="10,0,10,4" IsVisible="{Binding NothingAvailable}"
                     Text="Nothing has been taken off. Click anything above to move it here." />
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Available" ItemsSource="{Binding MenuAvailable}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MenuEntry">
                  <Button Classes="menuentry off" Width="250" ToolTip.Tip="{Binding EditTip}"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PickFromMenuCommand}" CommandParameter="{Binding}">
                    <DockPanel>
                      <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="17"
                              Foreground="{DynamicResource Muted}" Margin="0,0,11,0" VerticalAlignment="Center" />
                      <Border DockPanel.Dock="Right" Classes="editmark">
                        <c:Icon Data="{StaticResource Icon.Plus}" Size="12" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Columns" ItemsSource="{Binding MenuColumns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="18" LineSpacing="20" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MenuColumn">
            <StackPanel Width="250">
              <DockPanel Margin="10,0,6,6">
                <!-- A whole group can go on the dock, where a click opens a short list of what is in it. -->
                <Button DockPanel.Dock="Right" Classes="link" FontSize="{DynamicResource Text11}" Content="Add to the dock" IsVisible="{Binding Heading.CanAdd, FallbackValue=False}"
                        ToolTip.Tip="Puts the whole group on the dock; a click there opens a short list of what is in it"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToDockCommand}" CommandParameter="{Binding Heading}" />
                <Button DockPanel.Dock="Right" Classes="link" FontSize="{DynamicResource Text11}" Content="Take off the dock" IsVisible="{Binding Heading.OnDock, FallbackValue=False}"
                        IsEnabled="{Binding Heading.CanTakeOff, FallbackValue=False}"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).TakeOffDockCommand}" CommandParameter="{Binding Heading}" />
                <TextBlock Classes="label caps" Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuEntry">
                    <Button Classes="menuentry" Classes.current="{Binding IsCurrent}" Classes.off="{Binding IsOff}" ToolTip.Tip="{Binding EditTip}"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PickFromMenuCommand}" CommandParameter="{Binding}">
                      <Button.ContextMenu>
                        <ContextMenu IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDockMenu}">
                          <MenuItem Header="Add to the dock" IsEnabled="{Binding CanAdd}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).AddToDockCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Take off the dock" IsEnabled="{Binding CanTakeOff}"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).TakeOffDockCommand}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <DockPanel>
                        <c:Icon DockPanel.Dock="Left" Data="{Binding Icon, Converter={x:Static c:IconConverter.Instance}}" Size="17"
                                Foreground="{DynamicResource Muted}" Margin="0,0,11,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Classes="muted" Classes.short="{Binding Late}" FontSize="{DynamicResource Text12}" Text="{Binding Figure}"
                                   IsVisible="{Binding ShowsFigure}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Border DockPanel.Dock="Right" Classes="editmark" IsVisible="{Binding ShowsMinus}">
                          <c:Icon Data="{StaticResource Icon.Minus}" Size="12" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border DockPanel.Dock="Right" Classes="editmark" IsVisible="{Binding ShowsPlus}">
                          <c:Icon Data="{StaticResource Icon.Plus}" Size="12" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    </DockPanel>
  </Border>
</Grid>
</UserControl>
