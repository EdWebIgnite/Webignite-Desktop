<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.NoteWidgetView"
             x:DataType="vm:NoteBody">
  <!-- A note on a page of your own: the Notes page's editor, with the formatting it is used for most along the top. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="-6,0,0,4">
      <Button Classes="quiet format" Focusable="False" Click="Bold" ToolTip.Tip="Bold (Ctrl+B)"><c:Icon Data="{StaticResource Icon.Bold}" Size="13" /></Button>
      <Button Classes="quiet format" Focusable="False" Click="Italic" ToolTip.Tip="Italic (Ctrl+I)"><c:Icon Data="{StaticResource Icon.Italic}" Size="13" /></Button>
      <Button Classes="quiet format" Focusable="False" Click="Underline" ToolTip.Tip="Underline (Ctrl+U)"><c:Icon Data="{StaticResource Icon.Underline}" Size="13" /></Button>
      <Button Classes="quiet format" Focusable="False" Click="Bullets" ToolTip.Tip="Bullets"><c:Icon Data="{StaticResource Icon.Bullets}" Size="13" /></Button>
      <Button Classes="quiet format" Focusable="False" Click="Numbers" ToolTip.Tip="Numbered list"><c:Icon Data="{StaticResource Icon.Numbers}" Size="13" /></Button>
      <Button Classes="quiet format" Focusable="False" Click="Checklist" ToolTip.Tip="Checklist (Ctrl+Shift+C)"><c:Icon Data="{StaticResource Icon.Checklist}" Size="13" /></Button>
    </StackPanel>
    <c:RichTextEditor x:Name="Editor" Document="{Binding Document}" Revision="{Binding Revision}" PageColours="True"
                      Placeholder="Type anything. It's kept as you go." Padding="0,2" />
  </DockPanel>
</UserControl>
