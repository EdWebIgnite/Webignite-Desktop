<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel"
             x:Name="Root">
  <Panel>
    <ContentControl Content="{Binding Editor}" IsVisible="{Binding !IsListing}" />

    <!-- Down and Up move between rows, Enter opens one. Esc going back is in MainViewModel.GoBack. -->
    <StackPanel Spacing="18" IsVisible="{Binding IsListing}" c:ListKeys.IsEnabled="True">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding NewCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Data="{StaticResource Icon.Plus}" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding NewLabel}" />
          </StackPanel>
        </Button>
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="headline" Text="{Binding Headline}" IsVisible="{Binding HasAny}" />
        </StackPanel>
      </DockPanel>

      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{Binding EmptyIcon, Converter={x:Static c:IconConverter.Instance}}"
                    Title="{Binding EmptyTitle}" Text="{Binding EmptyText}" ActionText="{Binding NewLabel}" Command="{Binding NewCommand}" />

      <!-- Search and filters -->
      <StackPanel Spacing="12" IsVisible="{Binding HasAny}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" />
          <Button DockPanel.Dock="Right" Classes="link" Content="Clear" Command="{Binding ClearFiltersCommand}"
                  IsVisible="{Binding IsFiltered}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding Search}" Width="300" PlaceholderText="Search by customer, number, line or amount" />
            <ComboBox ItemsSource="{x:Static vm:DocumentsViewModel.PeriodChoices}" SelectedItem="{Binding PeriodChoice}" Width="150" />
          </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ShowChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FilterChip">
              <Button Classes="filter" Classes.on="{Binding IsOn}" Content="{Binding Label}" Command="{Binding PickCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <c:EmptyState IsVisible="{Binding NoMatches}" Icon="{StaticResource Icon.Search}" Title="Nothing matches"
                    Text="Try fewer words, or pick Everything and Any date." ActionText="Clear the filters" Command="{Binding ClearFiltersCommand}" />

      <Border Classes="card" Padding="0" IsVisible="{Binding ShowTable}">
        <StackPanel>
          <!-- The heading row is padded like the rows below it, so each title sits over its column. -->
          <Border Classes="stickyhead" Padding="12,0">
            <Grid ColumnDefinitions="150,*,130,130,140,28">
              <TextBlock Grid.Column="0" Classes="label tablehead" Text="Number" />
              <TextBlock Grid.Column="1" Classes="label tablehead" Text="Customer" />
              <TextBlock Grid.Column="2" Classes="label tablehead" Text="Date" />
              <TextBlock Grid.Column="3" Classes="label tablehead" Text="Status" />
              <TextBlock Grid.Column="4" Classes="label tablehead" Text="Total" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentRow">
                <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Open" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Make a copy" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).MakeCopyOfCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Make an invoice from it" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).MakeInvoiceFromCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsQuote}" />
                      <MenuItem Header="Email it" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).EmailFromCommand}" CommandParameter="{Binding}" IsVisible="{Binding InXero}" />
                      <MenuItem Header="Open in Xero" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).OpenInXeroForCommand}" CommandParameter="{Binding}" IsVisible="{Binding InXero}" />
                      <Separator />
                      <MenuItem Header="Open the client" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).OpenClientOfCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Copy the number" Command="{Binding #Root.((vm:DocumentsViewModel)DataContext).CopyNumberCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasNumber}" />
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid ColumnDefinitions="150,*,130,130,140,28">
                    <Border Grid.ColumnSpan="6" Classes="edge" IsVisible="{Binding IsOverdue}" Margin="-12,-11,0,-11" />
                    <TextBlock Grid.Column="0" Text="{Binding Number}" Classes.muted="{Binding !IsInXero}" Margin="8,0" VerticalAlignment="Center" />
                    <!-- A grid, so a long second line ends in an ellipsis instead of running into the date. -->
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,10,*" Margin="8,0">
                      <c:Monogram Text="{Binding CustomerName}" Size="28" />
                      <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Customer}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Detail}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding Date}" Margin="8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Owing}">
                      <Ellipse Classes="dot" Classes.done="{Binding IsDone}" Classes.problem="{Binding IsOverdue}" Classes.waiting="{Binding IsWaiting}" />
                      <TextBlock Classes="status" Classes.problem="{Binding IsOverdue}" Text="{Binding Status}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Classes="amount" Text="{Binding Total}" Margin="8,0" VerticalAlignment="Center" />
                    <c:Icon Grid.Column="5" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <c:ListHint IsVisible="{Binding HasHint}" Text="{Binding Hint.Text, FallbackValue=''}"
                  ActionText="{Binding Hint.ActionText, FallbackValue=''}" Command="{Binding FollowHintCommand}" />
    </StackPanel>
  </Panel>
</UserControl>
