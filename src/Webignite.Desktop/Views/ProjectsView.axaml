<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:core="using:Webignite.Core.Projects"
             x:Class="Webignite.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             x:Name="Root">
  <UserControl.Styles>
    <!-- The list, as Asana's: a heading row for the columns, cells with thin lines between them, round ticks. -->
    <Style Selector="Border.listhead">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.listhead > Grid > TextBlock, Border.listhead > Grid > Border > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style Selector="Border.cellline">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.whocell"><Setter Property="Width" Value="160" /></Style>
    <Style Selector="Border.duecell"><Setter Property="Width" Value="120" /></Style>
    <Style Selector="Border.prioritycell"><Setter Property="Width" Value="100" /></Style>
    <!-- A narrow list (a task open beside it): Priority hides and the cells close up, so names keep their room. -->
    <Style Selector="StackPanel.narrowlist Border.whocell"><Setter Property="Width" Value="120" /></Style>
    <Style Selector="StackPanel.narrowlist Border.duecell"><Setter Property="Width" Value="96" /></Style>
    <Style Selector="StackPanel.narrowlist Border.prioritycell"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.taskrow">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Border.taskrow.subtask > Grid > DockPanel">
      <Setter Property="Margin" Value="26,0,0,0" />
    </Style>
    <!-- A subtask in the list moves with its task; it's dragged in the task pane. -->
    <Style Selector="Border.taskrow.subtask > Grid > Border.grip">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.listsection">
      <Setter Property="Margin" Value="0,16,0,0" />
      <Setter Property="Padding" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.fold, Button.expand">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.subcount">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="6,0,8,0" />
    </Style>
    <Style Selector="Button.addtask">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.addtaskmore">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.listtool">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <!-- A round tick that fills green when the task is done, as in Asana -->
    <Style Selector="CheckBox.tick">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="CheckBox.tick /template/ Border#NormalRectangle">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="CheckBox.tick:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource Ok}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ok}" />
    </Style>
    <!-- The task pane, as Asana's -->
    <Style Selector="ToggleButton.markdone">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ToggleButton.markdone:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OkSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OkLine}" />
      <Setter Property="Foreground" Value="{DynamicResource Ok}" />
    </Style>
    <Style Selector="Button.panetool">
      <Setter Property="Padding" Value="7" />
    </Style>
    <Style Selector="Grid.fields > TextBlock.field">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.projectchip">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.description">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.description:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    </Style>
    <Style Selector="Button.feedtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.feedtab.on">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
    </Style>
    <Style Selector="Button.feedtab.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPicked}" />
    </Style>
    <Style Selector="Button.filetile">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.filethumb">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.coverbadge">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Border.subtaskrow">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The board, as Asana's: soft columns, cards with a line round them and a cover across the top. -->
    <Style Selector="Border.boardcolumn">
      <Setter Property="Width" Value="280" />
      <Setter Property="Background" Value="{DynamicResource TableHead}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,6,8,8" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="DockPanel.columnhead">
      <Setter Property="Margin" Value="2,0,0,2" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBlock.columntitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="7,0" />
    </Style>
    <Style Selector="Button.coltool">
      <Setter Property="Padding" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.columncount">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style Selector="Border.boardcard">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.boardcard:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.boardcard.open">
      <Setter Property="BorderBrush" Value="{DynamicResource DropMark}" />
    </Style>
    <Style Selector="Border.boardcard.picked">
      <Setter Property="BorderBrush" Value="{DynamicResource DropMark}" />
      <Setter Property="Background" Value="{DynamicResource Picked}" />
    </Style>
    <Style Selector="Border.cardcover">
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="CornerRadius" Value="7,7,0,0" />
    </Style>
    <Style Selector="StackPanel.cardcount">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="3" />
    </Style>
    <Style Selector="StackPanel.cardcount > TextBlock, TextBlock.carddue">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.cardcount > c|Icon">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.carddue.late">
      <Setter Property="Foreground" Value="{DynamicResource Attention}" />
    </Style>
    <Style Selector="Button.addcard">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Border.addcolumn">
      <Setter Property="Width" Value="280" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0,4,0,0" />
    </Style>
    <!-- The Overview tab, as Asana's -->
    <Style Selector="TextBlock.overviewhead">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.overviewcard">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Button.healthpick">
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style Selector="Button.healthpick.on">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropMark}" />
    </Style>
    <Style Selector="Border.updaterow">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,10,0,0" />
    </Style>
    <Style Selector="Button.linktile">
      <Setter Property="Width" Value="260" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.linkicon">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Border.linkicon > c|Icon">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.latetext">
      <Setter Property="Foreground" Value="{DynamicResource Attention}" />
    </Style>
    <!-- The Timeline and Calendar tabs, as Asana's -->
    <Style Selector="Border.timelineframe">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>
    <Style Selector="TextBlock.timelinemonth">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="6,4,0,0" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.timelineday">
      <Setter Property="Padding" Value="0,2,0,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.timelineday.weekend, Border.timelinecolumn.weekend">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Border.timelineday.today">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
    </Style>
    <Style Selector="Border.timelinecolumn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.todayline">
      <Setter Property="Width" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource DropMark}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.timelinelane">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.pinnedmonth">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Padding" Value="8,4,10,0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.timelinebar">
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.timelinebar.done">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.barname">
      <Setter Property="Foreground" Value="{DynamicResource OnProject}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.baredge">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.unscheduled">
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.unscheduled:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Border.calendarday">
      <Setter Property="MinHeight" Value="112" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>
    <Style Selector="Border.calendarday.outside">
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Border.calendarday.outside TextBlock">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Border.daynumber">
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.daynumber.today">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="Border.daynumber.today > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    </Style>
    <Style Selector="Button.dayadd">
      <Setter Property="Padding" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.calendarday:pointerover Button.dayadd">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.calendartask">
      <Setter Property="Background" Value="{DynamicResource Picked}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.calendartask.done">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>
  <!-- Projects on the left, the open one on the right. The panes move, resize and hide as on Mail. -->
  <c:PanelGrid Layout="{Binding Panels.Layout}" Panels="{Binding Panels}" Resized="PaneResized">
    <Border c:PanelGrid.Pane="list" c:PanelGrid.DefaultWidth="340" Background="{DynamicResource Canvas}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <StackPanel Spacing="16" Margin="24,30,24,30">
          <TextBlock Classes="h1" Text="Projects" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="quiet" Margin="6,0,0,0" ToolTip.Tip="Start a project from a template">
              <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="14" />
              <Button.Flyout>
                <c:FreshMenu Placement="BottomEdgeAlignedRight" Filling="TemplatesOpening" />
              </Button.Flyout>
            </Button>
            <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding NewProjectCommand}" ToolTip.Tip="Start a project">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="16" />
            </Button>
            <TextBox x:Name="NewProjectBox" Text="{Binding NewProjectName}" PlaceholderText="New project name" />
          </DockPanel>
          <TextBlock Classes="problem" FontSize="12" Text="{Binding ListMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding ListMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Classes="card" Padding="0">
            <Button Classes="row" Classes.open="{Binding IsMyTasks}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding ShowMineCommand}" ToolTip.Tip="Everything given to you, across your projects">
              <Grid ColumnDefinitions="Auto,10,*,Auto" Margin="8,0">
                <c:Icon Data="{StaticResource Icon.Check}" Size="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="My tasks" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="muted" Text="{Binding MyCount}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>

          <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Projects}" Title="No projects yet"
                        Text="Type a name above to start one: a website build, an SEO month, anything with steps." />

          <StackPanel Spacing="6" IsVisible="{Binding HasShared}">
            <TextBlock Classes="section" Text="{Binding SharedHeading}" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding SharedProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasPersonal}">
            <TextBlock Classes="section" Text="Just mine" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding PersonalProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <CheckBox IsChecked="{Binding ShowDone}" Content="Show done projects" IsVisible="{Binding !IsEmpty}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The open project -->
    <ScrollViewer c:PanelGrid.Pane="project" c:PanelGrid.DefaultWidth="660" x:Name="ProjectScroll">
      <Panel Margin="32,30" HorizontalAlignment="Stretch">
        <c:EmptyState IsVisible="{Binding IsClosed}" Icon="{StaticResource Icon.Projects}" Title="Pick a project"
                      Text="Its headings and tasks show here. Give tasks to yourself or your partner and set when they're due." VerticalAlignment="Top" />
        <!-- The template gallery, as Asana's: categories along the top, a card per template, a blank project -->
        <StackPanel Spacing="18" IsVisible="{Binding IsGallery}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Command="{Binding BlankProjectCommand}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Plus}" Size="14" VerticalAlignment="Center" />
                <TextBlock Text="Blank project" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Spacing="2">
              <TextBlock Classes="h1" Text="Template gallery" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Start a project with headings and tasks already in place, or a blank one." />
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding GalleryChips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryChip">
                <Button Classes="gallerychip" Classes.on="{Binding IsOn}" Content="{Binding Name}" Command="{Binding ShowCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:EmptyState IsVisible="{Binding GalleryEmpty}" Icon="{StaticResource Icon.Tiles}" Title="No templates of your own yet"
                        Text="Open a project and click Save as template in the menu next to its name. It shows here, ready to start the next one from." />
          <ItemsControl ItemsSource="{Binding GalleryCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryCard">
                <Button Classes="gallerycard" Command="{Binding OpenCommand}" Width="300" ToolTip.Tip="See what's in it">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="9" VerticalAlignment="Top" Margin="0,0,12,0"
                            Background="{Binding TileColour, Converter={x:Static c:ProjectColours.Brush}}">
                      <c:Icon Data="{Binding TileIcon, Converter={x:Static c:ProjectColours.Icon}}" Size="20" Foreground="{DynamicResource OnProject}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- A template opened: what's in it, and a name and start date to use it -->
        <StackPanel Spacing="16" IsVisible="{Binding IsPreviewing}">
          <Button Classes="link" Command="{Binding BackToGalleryCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.ChevronLeft}" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Template gallery" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="48" Height="48" CornerRadius="10" Background="{Binding Previewing.TileColour, Converter={x:Static c:ProjectColours.Brush}, FallbackValue={x:Null}}">
              <c:Icon Data="{Binding Previewing.TileIcon, Converter={x:Static c:ProjectColours.Icon}, FallbackValue={x:Null}}" Size="24" Foreground="{DynamicResource OnProject}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="h1" Text="{Binding Previewing.Name, FallbackValue=''}" />
              <TextBlock Classes="muted" Text="{Binding Previewing.About, FallbackValue=''}" />
            </StackPanel>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Text="{Binding Previewing.Description, FallbackValue=''}" MaxWidth="640" HorizontalAlignment="Left" />
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Use this template" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox Text="{Binding PreviewName}" PlaceholderText="Project name" Width="320" />
                <CalendarDatePicker SelectedDate="{Binding PreviewStart}" Watermark="Starts on" Width="160" ToolTip.Tip="Its tasks' dates count from this day" />
                <Button Classes="primary" Content="Use template" Command="{Binding UseTemplateCommand}" />
                <Button Classes="link" Content="Remove the template" Command="{Binding RemovePreviewedCommand}" IsVisible="{Binding Previewing.IsMine, FallbackValue=False}"
                        VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding PreviewHeadings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryHeading">
                <StackPanel Spacing="4" Margin="0,0,0,14">
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                    <TextBlock Classes="section" Text="{Binding Name}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,3">
                          <c:Icon Data="{StaticResource Icon.Check}" Size="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- My tasks: everything given to me, by when it's due -->
        <StackPanel Spacing="12" IsVisible="{Binding IsMyTasks}">
          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="My tasks" />
            <TextBlock Classes="muted" Text="{Binding MySummary}" />
          </StackPanel>
          <c:EmptyState IsVisible="{Binding MyTasksEmpty}" Icon="{StaticResource Icon.Check}" Title="All clear"
                        Text="Tasks given to you in any project show here, soonest first. Ones with a due date show in Planner and Calendar too." />
          <ItemsControl ItemsSource="{Binding MyRows}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:MyGroupRow">
                <DockPanel Margin="0,14,0,2">
                  <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Count}" VerticalAlignment="Center" />
                  <TextBlock Classes="section" Classes.overdue="{Binding Overdue}" Text="{Binding Title}" />
                </DockPanel>
              </DataTemplate>
              <DataTemplate DataType="vm:TaskRow">
                <Border Background="Transparent" Padding="0,1" Opacity="{Binding Fade}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="30,*,Auto,32">
                    <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Done" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                      <TextBox Classes="inline" Text="{Binding Title}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,2">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding ProjectName}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Subtasks, StringFormat='{}{0} subtasks'}" IsVisible="{Binding HasSubtasks}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskMarks}" IsVisible="{Binding HasMarks}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Content="{Binding DueText}"
                            Click="DueClicked" MinWidth="90" VerticalAlignment="Center" ToolTip.Tip="When it's due" />
                    <Button Grid.Column="3" Classes="quiet" Classes.open="{Binding IsOpen}" Padding="6" Margin="4,0,0,0" VerticalAlignment="Center"
                            Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}" ToolTip.Tip="Open the task">
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="16" IsVisible="{Binding IsOpen}">
          <!-- The header, as Asana's: the project's square, its name, a menu, a star and its status; who's on it on the right -->
          <DockPanel>
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Members}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="-6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <c:Monogram Text="{Binding}" Size="28" ToolTip.Tip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="projecthead" ToolTip.Tip="Set colour and icon">
                <Border Classes="projecttile" Width="34" Height="34" CornerRadius="8" Background="{Binding EditColour, Converter={x:Static c:ProjectColours.Brush}}">
                  <c:Icon Data="{Binding EditIcon, Converter={x:Static c:ProjectColours.Icon}}" Size="18" Foreground="{DynamicResource OnProject}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button.Flyout>
                  <!-- As Asana's "Set colour & icon": the square as it will look, then its 16 colours and 32 icons -->
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Spacing="10" Width="292">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="10" Background="{Binding EditColour, Converter={x:Static c:ProjectColours.Brush}}">
                          <c:Icon Data="{Binding EditIcon, Converter={x:Static c:ProjectColours.Icon}}" Size="24" Foreground="{DynamicResource OnProject}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Set colour and icon" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="label" Text="Colour" />
                      <ItemsControl ItemsSource="{x:Static vm:ProjectsViewModel.ColourChoices}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="swatch" Margin="0,0,6,6" ToolTip.Tip="{Binding Converter={x:Static c:ProjectColours.ColourLabel}}"
                                    Background="{Binding Converter={x:Static c:ProjectColours.Brush}}"
                                    Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).PickColourCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="label" Text="Icon" />
                      <ItemsControl ItemsSource="{x:Static vm:ProjectsViewModel.IconChoices}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="quiet" Padding="7" Margin="0,0,2,2" ToolTip.Tip="{Binding Converter={x:Static c:ProjectColours.IconLabel}}"
                                    Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).PickIconCommand}" CommandParameter="{Binding}">
                              <c:Icon Data="{Binding Converter={x:Static c:ProjectColours.Icon}}" Size="18" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <TextBox Classes="inline heading" FontSize="22" Text="{Binding EditName}" PlaceholderText="Project name" MinWidth="120" MaxWidth="520" VerticalAlignment="Center" />
              <Button Classes="quiet" Padding="6" VerticalAlignment="Center" ToolTip.Tip="More">
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="14" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Save as template" Command="{Binding SaveAsTemplateCommand}"
                              ToolTip.Tip="Keep its headings, tasks and subtasks to start other projects from" />
                    <MenuItem Header="Delete the project" Command="{Binding DeleteProjectCommand}" />
                    <Separator />
                    <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="quiet" Padding="6" VerticalAlignment="Center" Command="{Binding ToggleFavouriteCommand}"
                      ToolTip.Tip="Star it: starred projects come first in the sidebar">
                <c:Icon Data="{StaticResource Icon.Star}" Size="15" Classes.starred="{Binding EditFavourite}" />
              </Button>
              <Button Classes="quiet" VerticalAlignment="Center" Padding="8,4" ToolTip.Tip="How it's going">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="9" Height="9" Fill="{Binding EditHealth, Converter={x:Static c:ProjectColours.Health}}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding HealthText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="On track" Command="{Binding SetHealthCommand}" CommandParameter="{x:Static core:ProjectHealth.OnTrack}" />
                    <MenuItem Header="At risk" Command="{Binding SetHealthCommand}" CommandParameter="{x:Static core:ProjectHealth.AtRisk}" />
                    <MenuItem Header="Off track" Command="{Binding SetHealthCommand}" CommandParameter="{x:Static core:ProjectHealth.OffTrack}" />
                    <Separator />
                    <MenuItem Header="Clear the status" Command="{Binding SetHealthCommand}" CommandParameter="{x:Static core:ProjectHealth.None}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </DockPanel>

          <!-- The views, as Asana's tabs -->
          <DockPanel Margin="0,-6,0,0">
            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Summary}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
              <Button Classes="viewtab" Classes.on="{Binding IsOverview}" Content="Overview" Command="{Binding OverviewViewCommand}"
                      ToolTip.Tip="What the project is about, its key links and milestones, and how it's going" />
              <Button Classes="viewtab" Classes.on="{Binding IsList}" Content="List" Command="{Binding ListViewCommand}" />
              <Button Classes="viewtab" Classes.on="{Binding IsBoard}" Content="Board" Command="{Binding BoardViewCommand}"
                      ToolTip.Tip="Headings as columns; drag cards across and up and down" />
              <Button Classes="viewtab" Classes.on="{Binding IsTimeline}" Content="Timeline" Command="{Binding TimelineViewCommand}"
                      ToolTip.Tip="Tasks as bars from start to due date; drag to move them" />
              <Button Classes="viewtab" Classes.on="{Binding IsCalendar}" Content="Calendar" Command="{Binding CalendarViewCommand}"
                      ToolTip.Tip="A month with each task on its due date" />
              <Button Classes="viewtab" Classes.on="{Binding IsFiles}" Content="Files" Command="{Binding FilesViewCommand}"
                      ToolTip.Tip="Every file attached to the project's tasks" />
            </StackPanel>
          </DockPanel>
          <Border Height="1" Background="{DynamicResource Line}" Margin="0,-17,0,0" />

          <!-- Under the tabs, as Asana's: Add task on the left; filter, sort and group on the right -->
          <DockPanel IsVisible="{Binding ShowsTaskTools}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="1">
              <Button x:Name="AddTaskButton" Classes="primary addtask" Click="AddTaskClicked" ToolTip.Tip="Add a task at the top of the first heading">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="13" VerticalAlignment="Center" />
                  <TextBlock Text="Add task" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="primary addtaskmore" ToolTip.Tip="More to add">
                <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Add task" Click="AddTaskClicked" />
                    <MenuItem Header="Add heading" Click="AddHeadingClicked" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <Button Classes="quiet listtool" Classes.chosen="{Binding HasFilter}" ToolTip.Tip="Show tasks of one priority or with one tag">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Search}" Size="13" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FilterText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="8" Width="220">
                      <TextBlock Classes="label" Text="Priority" />
                      <ComboBox x:Name="PriorityFilterBox" ItemsSource="{x:Static vm:ProjectsViewModel.PriorityFilters}" SelectedItem="{Binding FilterPriority, Mode=OneWay}"
                                SelectionChanged="PriorityFilterPicked" HorizontalAlignment="Stretch" />
                      <TextBlock Classes="label" Text="Tag" />
                      <ComboBox x:Name="TagFilterBox" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding FilterTag, Mode=OneWay}"
                                SelectionChanged="TagFilterPicked" HorizontalAlignment="Stretch" />
                      <Button Classes="link" Content="Show all" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasFilter}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Classes="quiet listtool" Classes.chosen="{Binding IsSorted}" IsVisible="{Binding ShowsSortGroup}" ToolTip.Tip="Sort the tasks in each heading">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Swap}" Size="13" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SortText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="None (the order you dragged)" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.None}" />
                    <MenuItem Header="Due date" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.DueDate}" />
                    <MenuItem Header="Assignee" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.Assignee}" />
                    <MenuItem Header="Priority" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.Priority}" />
                    <MenuItem Header="Alphabetical" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.Alphabetical}" />
                    <MenuItem Header="Created on" Command="{Binding SortByCommand}" CommandParameter="{x:Static core:TaskSort.Created}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="quiet listtool" Classes.chosen="{Binding IsGrouped}" IsVisible="{Binding ShowsSortGroup}" ToolTip.Tip="Group the list by headings, when it's due, who it's for or priority">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Tiles}" Size="13" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding GroupText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Headings" Command="{Binding GroupByCommand}" CommandParameter="{x:Static core:TaskGroup.Sections}" />
                    <MenuItem Header="Due date" Command="{Binding GroupByCommand}" CommandParameter="{x:Static core:TaskGroup.DueDate}" />
                    <MenuItem Header="Assignee" Command="{Binding GroupByCommand}" CommandParameter="{x:Static core:TaskGroup.Assignee}" />
                    <MenuItem Header="Priority" Command="{Binding GroupByCommand}" CommandParameter="{x:Static core:TaskGroup.Priority}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" Margin="12,0" VerticalAlignment="Center" Text="Sorted or grouped: drag to reorder is off until Sort is None and Group is Headings."
                       IsVisible="{Binding !CanReorder}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock Classes="problem" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- The Overview tab, as Asana's: the description, roles, key resources and milestones on the left; how it's
               going, how far it has come and its details on the right. -->
          <Grid ColumnDefinitions="*,28,320" IsVisible="{Binding IsOverview}" Margin="0,4,0,0">
            <StackPanel Spacing="28">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <Button Classes="quiet format" Focusable="False" Click="ProjectBold" ToolTip.Tip="Bold (Ctrl+B)"><c:Icon Data="{StaticResource Icon.Bold}" Size="13" /></Button>
                    <Button Classes="quiet format" Focusable="False" Click="ProjectItalic" ToolTip.Tip="Italic (Ctrl+I)"><c:Icon Data="{StaticResource Icon.Italic}" Size="13" /></Button>
                    <Button Classes="quiet format" Focusable="False" Click="ProjectUnderline" ToolTip.Tip="Underline (Ctrl+U)"><c:Icon Data="{StaticResource Icon.Underline}" Size="13" /></Button>
                    <Button Classes="quiet format" Focusable="False" Click="ProjectBullets" ToolTip.Tip="Bullets"><c:Icon Data="{StaticResource Icon.Bullets}" Size="13" /></Button>
                    <Button Classes="quiet format" Focusable="False" Click="ProjectNumbers" ToolTip.Tip="Numbered list"><c:Icon Data="{StaticResource Icon.Numbers}" Size="13" /></Button>
                  </StackPanel>
                  <TextBlock Classes="overviewhead" Text="Project description" VerticalAlignment="Center" />
                </DockPanel>
                <Border Classes="description">
                  <c:RichTextEditor x:Name="ProjectDescriptionEditor" Document="{Binding ProjectDescription}" Revision="{Binding ProjectDescriptionRevision}" PageColours="True"
                                    Placeholder="What's this project about? The goal, what's in and out, who to talk to…" Padding="14,12" MinHeight="120" />
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock Classes="overviewhead" Text="Project roles" />
                <ItemsControl ItemsSource="{Binding Roles}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="24" LineSpacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleRow">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:Monogram Text="{Binding Name}" Size="34" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding Role}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="12" Text="Tick Shared under Details to add your partner. They see it once sync is set up."
                           IsVisible="{Binding !EditShared}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="quiet coltool" Click="StartLinkClicked" ToolTip.Tip="Add a link">
                    <c:Icon Data="{StaticResource Icon.Plus}" Size="14" />
                  </Button>
                  <TextBlock Classes="overviewhead" Text="Key resources" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Classes="muted" Text="Links to the brief, the staging site or a shared folder, kept in one place."
                           IsVisible="{Binding NoLinks}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Links}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LinkRow">
                      <Button Classes="linktile" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Url}">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="quiet coltool" Command="{Binding RemoveCommand}" ToolTip.Tip="Take the link off" VerticalAlignment="Center" Margin="6,0,0,0">
                            <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                          </Button>
                          <Border DockPanel.Dock="Left" Classes="linkicon">
                            <c:Icon Data="{StaticResource Icon.Link}" Size="15" />
                          </Border>
                          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="description" Padding="12" IsVisible="{Binding IsAddingLink}">
                  <StackPanel Spacing="8">
                    <TextBox x:Name="LinkUrlBox" Text="{Binding NewLinkUrl}" PlaceholderText="Web address, e.g. staging.bosveld.co.za" KeyDown="LinkKey" />
                    <TextBox Text="{Binding NewLinkTitle}" PlaceholderText="Name (optional), e.g. Staging site" KeyDown="LinkKey" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="Add link" Command="{Binding AddLinkCommand}" />
                      <Button Classes="quiet" Content="Cancel" Command="{Binding CancelLinkCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Classes="overviewhead" Text="Milestones" />
                <TextBlock Classes="muted" Text="The moments that matter, like sign-off or going live. Right-click any task to make it one."
                           IsVisible="{Binding NoMilestones}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Milestones}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRow">
                      <Border Classes="taskrow" Opacity="{Binding Fade}" ContextRequested="TaskMenu">
                        <Grid ColumnDefinitions="28,*,Auto,36">
                          <CheckBox Classes="tick" IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Mark complete" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <c:Icon Data="{StaticResource Icon.Milestone}" Size="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Content="{Binding DueText}"
                                  Click="DueClicked" MinWidth="90" VerticalAlignment="Center" ToolTip.Tip="When it's due" />
                          <Button Grid.Column="3" Classes="quiet" Padding="6" Margin="4,0,0,0" VerticalAlignment="Center"
                                  Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}" ToolTip.Tip="Open it">
                            <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Classes="inline addtaskbox" Text="{Binding NewMilestone}" PlaceholderText="Add a milestone, then Enter" KeyDown="MilestoneKey" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding MadeText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="16">
              <!-- How it's going, as Asana's status updates -->
              <Border Classes="overviewcard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="overviewhead" Text="What's the status?" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="quiet healthpick" Classes.on="{Binding UpdateOnTrack}" Command="{Binding StartUpdateCommand}" CommandParameter="{x:Static core:ProjectHealth.OnTrack}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static core:ProjectHealth.OnTrack}, Converter={x:Static c:ProjectColours.Health}}" VerticalAlignment="Center" />
                        <TextBlock Text="On track" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="quiet healthpick" Classes.on="{Binding UpdateAtRisk}" Command="{Binding StartUpdateCommand}" CommandParameter="{x:Static core:ProjectHealth.AtRisk}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static core:ProjectHealth.AtRisk}, Converter={x:Static c:ProjectColours.Health}}" VerticalAlignment="Center" />
                        <TextBlock Text="At risk" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="quiet healthpick" Classes.on="{Binding UpdateOffTrack}" Command="{Binding StartUpdateCommand}" CommandParameter="{x:Static core:ProjectHealth.OffTrack}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="9" Height="9" Fill="{Binding Source={x:Static core:ProjectHealth.OffTrack}, Converter={x:Static c:ProjectColours.Health}}" VerticalAlignment="Center" />
                        <TextBlock Text="Off track" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding IsWritingUpdate}">
                    <TextBox Text="{Binding UpdateText}" PlaceholderText="What's happened, what's next, anything in the way?" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="80" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="Post update" Command="{Binding PostUpdateCommand}" />
                      <Button Classes="quiet" Content="Cancel" Command="{Binding CancelUpdateCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="12" Text="Pick one to write an update. The newest sets the status in the header."
                             IsVisible="{Binding NoUpdates}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Updates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:UpdateRow">
                        <Border Classes="updaterow">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Ellipse Width="9" Height="9" Fill="{Binding Health, Converter={x:Static c:ProjectColours.Health}}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding HealthText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Byline}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="overviewcard">
                <StackPanel Spacing="8">
                  <TextBlock Classes="overviewhead" Text="Progress" />
                  <ProgressBar Value="{Binding ProgressShare}" Minimum="0" Maximum="100" Height="6" />
                  <TextBlock Text="{Binding ProgressText}" />
                  <TextBlock Classes="latetext" Text="{Binding LateText}" IsVisible="{Binding HasLate}" />
                </StackPanel>
              </Border>

              <Border Classes="overviewcard">
                <StackPanel Spacing="10">
                  <TextBlock Classes="overviewhead" Text="Details" />
                  <CheckBox IsChecked="{Binding EditShared}" Content="{Binding SharedLabel}"
                            ToolTip.Tip="Shared projects reach your partner once sync is set up. Until then they stay on this PC." />
                  <TextBlock Classes="label" Text="Client" />
                  <ComboBox x:Name="ClientBox" ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding EditClient, Mode=OneWay}"
                            SelectionChanged="ClientPicked" HorizontalAlignment="Stretch" ToolTip.Tip="The client it's for" />
                  <TextBlock Classes="label" Text="Status" />
                  <ComboBox x:Name="StatusBox" ItemsSource="{x:Static vm:ProjectsViewModel.Statuses}" SelectedItem="{Binding EditStatus, Mode=OneWay}"
                            SelectionChanged="StatusPicked" HorizontalAlignment="Stretch" />
                  <TextBlock Classes="label" Text="Due date" />
                  <CalendarDatePicker SelectedDate="{Binding EditDue}" PlaceholderText="Due date" HorizontalAlignment="Stretch" ToolTip.Tip="When the whole project is due" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- The list, as Asana's: column headings, then each heading (folding) with its tasks in cells -->
          <StackPanel x:Name="ListArea" IsVisible="{Binding IsList}">
            <Border Classes="listhead">
              <Grid ColumnDefinitions="22,28,*,Auto,Auto,Auto,36">
                <TextBlock Grid.Column="2" Text="Task name" />
                <Border Grid.Column="3" Classes="cellline whocell"><TextBlock Text="Assignee" /></Border>
                <Border Grid.Column="4" Classes="cellline duecell"><TextBlock Text="Due date" /></Border>
                <Border Grid.Column="5" Classes="cellline prioritycell"><TextBlock Text="Priority" /></Border>
              </Grid>
            </Border>
          <ItemsControl x:Name="TaskList" ItemsSource="{Binding Rows}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:SectionRow">
                <Border Classes="listsection" Background="Transparent">
                  <DockPanel>
                    <Button DockPanel.Dock="Left" Classes="quiet fold" Command="{Binding FoldCommand}" ToolTip.Tip="Fold up or open out">
                      <Panel>
                        <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="14" IsVisible="{Binding IsOpenOut}" />
                        <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" IsVisible="{Binding IsFolded}" />
                      </Panel>
                    </Button>
                    <Button DockPanel.Dock="Right" Classes="quiet" Padding="6" IsVisible="{Binding IsHeading}" Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete the heading; its tasks stay, under no heading">
                      <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Count}" VerticalAlignment="Center" Margin="8,0" />
                    <Panel>
                      <TextBox Classes="inline heading" Text="{Binding Name}" IsVisible="{Binding IsHeading}" HorizontalAlignment="Left" MinWidth="200" />
                      <TextBlock Classes="section" Text="{Binding Title}" IsVisible="{Binding !IsHeading}" Margin="7,6" />
                    </Panel>
                  </DockPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:TaskRow">
                <Border Classes="taskrow" Classes.picked="{Binding IsPicked}" Classes.subtask="{Binding IsSubtask}" Opacity="{Binding Fade}" ContextRequested="TaskMenu">
                  <Grid ColumnDefinitions="22,28,*,Auto,Auto,Auto,36">
                    <Border Classes="grip" Background="Transparent" ToolTip.Tip="Drag the row to move it">
                      <c:Icon Data="{StaticResource Icon.Grip}" Size="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <CheckBox Grid.Column="1" Classes="tick" IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Mark complete" />
                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                      <!-- Opens out its subtasks under it, as Asana's arrow -->
                      <Button DockPanel.Dock="Left" Classes="quiet expand" Command="{Binding ExpandCommand}" IsVisible="{Binding HasSubtasks}"
                              ToolTip.Tip="Show its subtasks here">
                        <Panel>
                          <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="12" IsVisible="{Binding !IsExpanded}" />
                          <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="12" IsVisible="{Binding IsExpanded}" />
                        </Panel>
                      </Button>
                      <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Milestone}" Size="12" Foreground="{DynamicResource Muted}" IsVisible="{Binding IsMilestone}"
                              VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Milestone" />
                      <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Blocked}" Size="12" Foreground="{DynamicResource Muted}" IsVisible="{Binding IsWaiting}"
                              VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="{Binding WaitingText}" />
                      <Border DockPanel.Dock="Right" Classes="subcount" IsVisible="{Binding HasComments}" ToolTip.Tip="Comments" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="{Binding CommentText}" FontSize="11" VerticalAlignment="Center" />
                          <c:Icon Data="{StaticResource Project.ChatBubbles}" Size="11" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border DockPanel.Dock="Right" Classes="subcount" IsVisible="{Binding HasAttachments}" ToolTip.Tip="Files attached" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="{Binding AttachmentCount}" FontSize="11" VerticalAlignment="Center" />
                          <c:Icon Data="{StaticResource Icon.Paperclip}" Size="11" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border DockPanel.Dock="Right" Classes="subcount" IsVisible="{Binding HasSubtasks}" ToolTip.Tip="Subtasks done" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                          <TextBlock Text="{Binding Subtasks}" FontSize="11" VerticalAlignment="Center" />
                          <c:Icon Data="{StaticResource Icon.Checklist}" Size="11" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBox Classes="inline" Text="{Binding Title}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ListMarks}" IsVisible="{Binding HasListMarks}" Margin="6,0,0,4" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Who, when and priority read as words in cells; a click changes them. Delete is on the right-click menu. -->
                    <Border Grid.Column="3" Classes="cellline whocell">
                      <Button Classes="cell" Click="WhoClicked" ToolTip.Tip="Who it's for" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Monogram Text="{Binding WhoInitials}" Size="20" IsVisible="{Binding HasWho}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding WhoText}" Classes.muted="{Binding !HasWho}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </Border>
                    <Border Grid.Column="4" Classes="cellline duecell">
                      <Button Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Content="{Binding DueText}"
                              Click="DueClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="When it's due" />
                    </Border>
                    <Border Grid.Column="5" Classes="cellline prioritycell">
                      <Button Classes="cell" Click="PriorityClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="How much it matters">
                        <Border Classes="pill" Classes.strong="{Binding IsHigh}" IsVisible="{Binding HasPriority}">
                          <TextBlock Text="{Binding PriorityText}" FontSize="11" />
                        </Border>
                      </Button>
                    </Border>
                    <Button Grid.Column="6" Classes="quiet" Classes.open="{Binding IsOpen}" Padding="6" Margin="4,0,0,0"
                            Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Open the task: notes, subtasks and what it's about">
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:AddTaskRow">
                <DockPanel Margin="50,2,0,0">
                  <Button DockPanel.Dock="Right" Classes="link" Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
                  <TextBox Classes="inline addtaskbox" Text="{Binding Title}" PlaceholderText="Add task…" KeyDown="AddTaskKey" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
          </StackPanel>

          <!-- The Timeline tab, as Asana's: days across the top, a row per dated task under its heading, today marked;
               drag a bar to move it or its ends to stretch it, and drag a task with no date from Unscheduled onto a day. -->
          <Grid ColumnDefinitions="*,16,230" IsVisible="{Binding IsTimeline}">
            <Border Classes="timelineframe">
              <Panel>
              <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Width="{Binding TimelineWidth}">
                  <!-- Month names and day numbers -->
                  <ItemsControl ItemsSource="{Binding TimelineDays}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TimelineDay">
                        <StackPanel Width="{Binding Width}" ClipToBounds="False">
                          <TextBlock Classes="timelinemonth" Text="{Binding Month}" Height="20" ClipToBounds="False" />
                          <Border Classes="timelineday" Classes.weekend="{Binding IsWeekend}" Classes.today="{Binding IsToday}">
                            <StackPanel>
                              <TextBlock Text="{Binding Initial}" FontSize="10" HorizontalAlignment="Center" Classes="muted" />
                              <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Panel MinHeight="360">
                    <!-- Day columns under the bars: weekends shaded, and where a task with no date is dropped -->
                    <ItemsControl x:Name="TimelineColumns" ItemsSource="{Binding TimelineDays}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineDay">
                          <Border Classes="timelinecolumn" Classes.weekend="{Binding IsWeekend}" Width="{Binding Width}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="todayline" Margin="{Binding TodayPlace}" />
                    <ItemsControl ItemsSource="{Binding TimelineLanes}" Margin="0,6,0,12">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineLaneRow">
                          <StackPanel>
                            <TextBlock Classes="timelinelane" Text="{Binding Title}" Margin="{Binding #Root.((vm:ProjectsViewModel)DataContext).LaneTitlePlace}" />
                            <ItemsControl ItemsSource="{Binding Bars}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineBarRow">
                                  <Panel Height="34">
                                    <StackPanel Orientation="Horizontal" Margin="{Binding Place}" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                                      <Border Classes="timelinebar" Classes.done="{Binding Row.Done}" Width="{Binding Width}" Tag="move"
                                              Background="{Binding #Root.((vm:ProjectsViewModel)DataContext).EditColour, Converter={x:Static c:ProjectColours.Brush}}"
                                              PointerPressed="BarPressed" PointerMoved="BarMoved" PointerReleased="BarReleased" PointerCaptureLost="BarLost"
                                              ContextRequested="BarMenu" ToolTip.Tip="{Binding Dates}">
                                        <Panel>
                                          <TextBlock Classes="barname" Text="{Binding Title}" IsVisible="{Binding NameInside}" />
                                          <Border Classes="baredge" Tag="start" HorizontalAlignment="Left"
                                                  PointerPressed="BarPressed" PointerMoved="BarMoved" PointerReleased="BarReleased" PointerCaptureLost="BarLost" />
                                          <Border Classes="baredge" Tag="end" HorizontalAlignment="Right"
                                                  PointerPressed="BarPressed" PointerMoved="BarMoved" PointerReleased="BarReleased" PointerCaptureLost="BarLost" />
                                        </Panel>
                                      </Border>
                                      <TextBlock Text="{Binding Title}" IsVisible="{Binding NameBeside}" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Panel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="No task has a due date yet. Drag one from Unscheduled onto a day, or give it a date in the list."
                               IsVisible="{Binding NoTimelineBars}" Margin="16,40" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                  </Panel>
                </StackPanel>
              </ScrollViewer>
              <!-- The month of the first day in view, pinned top left over the scrolling days -->
              <Border Classes="pinnedmonth" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Classes="timelinemonth" Text="{Binding VisibleMonth}" Margin="0" />
              </Border>
              </Panel>
            </Border>
            <Border Grid.Column="2" Classes="overviewcard" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Classes="overviewhead" Text="Unscheduled" />
                <TextBlock Classes="muted" FontSize="12" Text="Tasks with no due date. Drag one onto a day." TextWrapping="Wrap" IsVisible="{Binding !NoUnscheduled}" />
                <TextBlock Classes="muted" FontSize="12" Text="Every task has a date." IsVisible="{Binding NoUnscheduled}" />
                <ItemsControl x:Name="UnscheduledList" ItemsSource="{Binding Unscheduled}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRow">
                      <Border Classes="unscheduled" Background="Transparent" ContextRequested="TaskMenu">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <c:Icon Data="{StaticResource Icon.Grip}" Size="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="170" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- The Calendar tab, as Asana's: a month of weeks, each task on its due date; drag one to another day,
               or + on a day to add one due then. -->
          <StackPanel Spacing="8" IsVisible="{Binding IsCalendar}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                <Button Classes="quiet listtool" Content="Today" Command="{Binding ThisMonthCommand}" />
                <Button Classes="quiet coltool" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="The month before"><c:Icon Data="{StaticResource Icon.ChevronLeft}" Size="14" /></Button>
                <Button Classes="quiet coltool" Command="{Binding NextMonthCommand}" ToolTip.Tip="The month after"><c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" /></Button>
                <TextBlock Classes="overviewhead" Text="{Binding CalendarTitle}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding WeekdayNames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding}" Margin="8,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="CalendarGrid" ItemsSource="{Binding CalendarCells}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarCellRow">
                  <Border Classes="calendarday" Classes.outside="{Binding !InMonth}">
                    <StackPanel Spacing="3">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="quiet dayadd" ToolTip.Tip="Add a task due this day">
                          <c:Icon Data="{StaticResource Icon.Plus}" Size="11" />
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <TextBox Text="{Binding NewTitle}" PlaceholderText="Task name, then Enter" Width="220" KeyDown="DayAddKey" />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                        <Border Classes="daynumber" Classes.today="{Binding IsToday}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Number}" FontSize="12" />
                        </Border>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TaskRow">
                            <Border Padding="0,1" Background="Transparent" ContextRequested="TaskMenu" Tapped="CardTapped">
                              <Border Classes="calendartask" Classes.done="{Binding Done}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <c:Icon Data="{StaticResource Icon.Milestone}" Size="10" IsVisible="{Binding IsMilestone}" VerticalAlignment="Center" />
                                  <c:Icon Data="{StaticResource Icon.Blocked}" Size="10" IsVisible="{Binding IsWaiting}" VerticalAlignment="Center" ToolTip.Tip="{Binding WaitingText}" />
                                  <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="muted" FontSize="11" Text="{Binding More}" IsVisible="{Binding HasMore}" Margin="4,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The Files tab, as Asana's: every file attached in the project, pictures shown small -->
          <StackPanel Spacing="10" IsVisible="{Binding IsFiles}">
            <c:EmptyState IsVisible="{Binding NoProjectFiles}" Icon="{StaticResource Icon.Paperclip}" Title="No files yet"
                          Text="Open a task and attach files, or drop them on it. They show here, with the task they're on." />
            <ItemsControl ItemsSource="{Binding ProjectFiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AttachmentRow">
                  <Button Classes="filetile" Width="184" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Name}" ContextRequested="AttachmentMenu">
                    <StackPanel Spacing="6">
                      <Border Classes="filethumb" Height="112">
                        <Panel>
                          <Image Source="{Binding Picture}" Stretch="UniformToFill" IsVisible="{Binding HasPicture}" />
                          <c:Icon Data="{StaticResource Icon.Quotes}" Size="32" Foreground="{DynamicResource Muted}" IsVisible="{Binding ShowsIcon}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding TaskTitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The board, as Asana's: a column per heading with its name, how many tasks, a + and a menu; cards under it,
               "Add task" at its foot, and a column at the end to add a heading. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsBoard}">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <ItemsControl x:Name="Board" ItemsSource="{Binding Columns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BoardColumn">
                  <Border Classes="boardcolumn">
                    <StackPanel Spacing="2">
                      <DockPanel Classes="columnhead">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Classes="quiet coltool" Click="AddCardTopClicked" ToolTip.Tip="Add a task at the top">
                            <c:Icon Data="{StaticResource Icon.Plus}" Size="14" />
                          </Button>
                          <Button Classes="quiet coltool" ToolTip.Tip="More">
                            <c:Icon Data="{StaticResource Icon.More}" Size="14" />
                            <Button.Flyout>
                              <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Add task at the top" Click="AddCardTopClicked" />
                                <MenuItem Header="Add task at the bottom" Click="AddCardClicked" />
                                <MenuItem Header="Rename heading" Click="RenameColumnClicked" IsVisible="{Binding Section.IsHeading}" />
                                <MenuItem Header="Delete heading" Command="{Binding Section.DeleteCommand}" IsVisible="{Binding Section.IsHeading}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="columncount" Text="{Binding Section.Total}" />
                        <Panel VerticalAlignment="Center">
                          <TextBox Classes="inline heading columnname" Text="{Binding Section.Name}" IsVisible="{Binding Section.IsHeading}" />
                          <TextBlock Classes="columntitle" Text="{Binding Section.Title}" IsVisible="{Binding !Section.IsHeading}" />
                        </Panel>
                      </DockPanel>
                      <TextBox Classes="cardbox" Text="{Binding Add.Title}" PlaceholderText="Write a task name" IsVisible="{Binding Add.IsTypingTop}"
                               KeyDown="AddCardKey" LostFocus="CardBoxLeft" Loaded="CardBoxLoaded" Margin="0,4" />
                      <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TaskRow">
                            <Border Padding="0,4" Background="Transparent" ContextRequested="TaskMenu" Tapped="CardTapped">
                              <Border Classes="boardcard" Classes.open="{Binding IsOpen}" Classes.picked="{Binding IsPicked}" Opacity="{Binding Fade}">
                                <StackPanel>
                                  <!-- Its cover picture across the top, as Asana's -->
                                  <Border Classes="cardcover" IsVisible="{Binding HasCover}">
                                    <Image Source="{Binding Cover.Picture, FallbackValue={x:Null}}" Height="130" Stretch="UniformToFill" />
                                  </Border>
                                  <StackPanel Margin="12,10,12,11" Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                      <CheckBox Classes="tick" IsChecked="{Binding Done}" VerticalAlignment="Top" ToolTip.Tip="Mark complete" />
                                      <DockPanel Grid.Column="1" Margin="0,2,0,0">
                                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Milestone}" Size="12" Foreground="{DynamicResource Muted}"
                                                IsVisible="{Binding IsMilestone}" VerticalAlignment="Top" Margin="0,3,6,0" ToolTip.Tip="Milestone" />
                                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Blocked}" Size="12" Foreground="{DynamicResource Muted}"
                                                IsVisible="{Binding IsWaiting}" VerticalAlignment="Top" Margin="0,3,6,0" ToolTip.Tip="{Binding WaitingText}" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                      </DockPanel>
                                    </Grid>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskMarks}" IsVisible="{Binding HasMarks}" />
                                    <DockPanel IsVisible="{Binding HasCardFoot}">
                                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Classes="cardcount" IsVisible="{Binding HasSubtasks}" ToolTip.Tip="Subtasks done">
                                          <TextBlock Text="{Binding Subtasks}" />
                                          <c:Icon Data="{StaticResource Icon.Checklist}" Size="12" />
                                        </StackPanel>
                                        <StackPanel Classes="cardcount" IsVisible="{Binding HasComments}" ToolTip.Tip="Comments">
                                          <TextBlock Text="{Binding CommentText}" />
                                          <c:Icon Data="{StaticResource Project.ChatBubbles}" Size="12" />
                                        </StackPanel>
                                        <StackPanel Classes="cardcount" IsVisible="{Binding HasAttachments}" ToolTip.Tip="Files attached">
                                          <TextBlock Text="{Binding AttachmentCount}" />
                                          <c:Icon Data="{StaticResource Icon.Paperclip}" Size="12" />
                                        </StackPanel>
                                      </StackPanel>
                                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <c:Monogram Text="{Binding WhoInitials}" Size="22" IsVisible="{Binding HasWho}" ToolTip.Tip="{Binding WhoText}" />
                                        <TextBlock Classes="carddue" Classes.late="{Binding IsLate}" Text="{Binding DueText}" IsVisible="{Binding HasDue}" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </DockPanel>
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBox Classes="cardbox" Text="{Binding Add.Title}" PlaceholderText="Write a task name" IsVisible="{Binding Add.IsTypingBottom}"
                               KeyDown="AddCardKey" LostFocus="CardBoxLeft" Loaded="CardBoxLoaded" Margin="0,4" />
                      <Button Classes="quiet addcard" Click="AddCardClicked" IsVisible="{Binding Add.ShowsAddButton}" ToolTip.Tip="Add a task to this heading">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Data="{StaticResource Icon.Plus}" Size="13" VerticalAlignment="Center" />
                          <TextBlock Text="Add task" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Add a heading, as Asana's column at the end of the board -->
            <Border Classes="addcolumn">
              <Panel>
                <Button Classes="quiet addcard" Click="AddColumnClicked" IsVisible="{Binding !IsAddingColumn}" ToolTip.Tip="Add a heading: a new column">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Plus}" Size="13" VerticalAlignment="Center" />
                    <TextBlock Text="Add heading" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBox x:Name="NewColumnBox" Classes="cardbox" Text="{Binding NewHeadingName}" PlaceholderText="Name the heading, then Enter"
                         IsVisible="{Binding IsAddingColumn}" KeyDown="AddColumnKey" LostFocus="ColumnBoxLeft" />
              </Panel>
            </Border>
            </StackPanel>
          </ScrollViewer>

          <DockPanel Margin="0,8,0,0" IsVisible="{Binding IsList}">
            <Button DockPanel.Dock="Right" Classes="quiet" Content="Add heading" Command="{Binding AddHeadingCommand}" Margin="8,0,0,0" />
            <TextBox x:Name="NewHeadingBox" Text="{Binding NewHeadingName}" PlaceholderText="New heading, e.g. Design, Build, Launch" KeyDown="AddHeadingKey" />
          </DockPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- The open task -->
    <Border x:Name="TaskPane" c:PanelGrid.Pane="task" c:PanelGrid.DefaultWidth="440" Background="{DynamicResource Surface2}" DragDrop.AllowDrop="True"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <Panel Margin="24,30">
          <c:EmptyState IsVisible="{Binding !HasTask}" Icon="{StaticResource Icon.Projects}" Title="Open a task"
                        Text="Click the arrow at the end of a task to see its notes and subtasks here." VerticalAlignment="Top" />
          <StackPanel Spacing="14" IsVisible="{Binding #Root.((vm:ProjectsViewModel)DataContext).HasTask}" DataContext="{Binding Detail}" x:DataType="vm:TaskDetail">
            <!-- As Asana's: Mark complete on the left; the timer, add a subtask, delete and close on the right -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="quiet panetool" Command="{Binding StartTimerCommand}" ToolTip.Tip="Start the timer on this task (Time page)">
                  <c:Icon Data="{StaticResource Icon.Time}" Size="15" />
                </Button>
                <Button Classes="quiet panetool" Click="AttachClicked" ToolTip.Tip="Attach files (or drop them on the task)">
                  <c:Icon Data="{StaticResource Icon.Paperclip}" Size="15" />
                </Button>
                <Button Classes="quiet panetool" Click="AddSubtaskClicked" ToolTip.Tip="Add a subtask">
                  <c:Icon Data="{StaticResource Icon.Checklist}" Size="15" />
                </Button>
                <Button Classes="quiet panetool" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the task and its subtasks">
                  <c:Icon Data="{StaticResource Icon.Trash}" Size="15" />
                </Button>
                <Button Classes="quiet panetool" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)">
                  <c:Icon Data="{StaticResource Icon.Close}" Size="15" />
                </Button>
              </StackPanel>
              <ToggleButton Classes="markdone" IsChecked="{Binding Done}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Check}" Size="14" VerticalAlignment="Center" />
                  <Panel>
                    <TextBlock Text="Mark complete" IsVisible="{Binding !Done}" />
                    <TextBlock Text="Completed" IsVisible="{Binding Done}" />
                  </Panel>
                </StackPanel>
              </ToggleButton>
            </DockPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="-24,0" />
            <TextBox Classes="inline heading" FontSize="22" Text="{Binding Title}" TextWrapping="Wrap" PlaceholderText="Write a task name" />
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />

            <!-- The fields, as Asana's: name on the left, value on the right -->
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="fields">
              <TextBlock Classes="field" Text="Assignee" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <c:Monogram Text="{Binding AssignedTo.Label, FallbackValue=''}" Size="24" IsVisible="{Binding HasAssignee}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" MinWidth="180" />
              </StackPanel>
              <TextBlock Grid.Row="1" Classes="field" Text="Due date" />
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,16,*">
                <CalendarDatePicker SelectedDate="{Binding Start}" Watermark="Start" HorizontalAlignment="Stretch" ToolTip.Tip="When work on it starts (optional)" />
                <TextBlock Grid.Column="1" Text="–" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <CalendarDatePicker Grid.Column="2" SelectedDate="{Binding Due}" Watermark="Due" HorizontalAlignment="Stretch" />
              </Grid>
              <TextBlock Grid.Row="2" Classes="field" Text="Projects" />
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,*">
                <Border Classes="projectchip" ToolTip.Tip="{Binding ProjectName}">
                  <TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
                </Border>
                <ComboBox Grid.Column="2" x:Name="HeadingBox" ItemsSource="{Binding Headings}" SelectedItem="{Binding Heading, Mode=OneWay}"
                          SelectionChanged="HeadingPicked" HorizontalAlignment="Stretch" ToolTip.Tip="Its heading in the project" />
              </Grid>
              <TextBlock Grid.Row="3" Classes="field" Text="Priority" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" MinWidth="140" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="4" Classes="field" Text="Tags" VerticalAlignment="Top" Margin="0,8,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding TagsText}" PlaceholderText="e.g. Hosting, SEO" />
                <ItemsControl ItemsSource="{Binding OtherTags}" IsVisible="{Binding HasOtherTags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="quiet" Padding="8,2" FontSize="12" Content="{Binding StringFormat='+ {0}'}"
                              Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).Detail.AddTagCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Grid.Row="5" Classes="field" Text="Repeats" />
              <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Repeats}" SelectedItem="{Binding Repeat}" MinWidth="180" HorizontalAlignment="Left"
                        ToolTip.Tip="Ticking it off makes the next one" />
              <!-- Dependencies, as Asana's: the tasks it's waiting on, and the ones it holds up -->
              <TextBlock Grid.Row="6" Classes="field" Text="Waiting on" VerticalAlignment="Top" Margin="0,7,0,0" />
              <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4">
                <ItemsControl ItemsSource="{Binding WaitingOn}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DependencyRow">
                      <Border Classes="projectchip" Margin="0,0,0,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:Icon Data="{StaticResource Icon.Check}" Size="12" Foreground="{DynamicResource Ok}" IsVisible="{Binding Done}" VerticalAlignment="Center" />
                          <c:Icon Data="{StaticResource Icon.Blocked}" Size="12" Foreground="{DynamicResource Muted}" IsVisible="{Binding Open}" VerticalAlignment="Center" />
                          <Button Classes="link" Padding="0" Content="{Binding Title}" Command="{Binding ShowCommand}" ToolTip.Tip="Open it" />
                          <Button Classes="quiet coltool" Command="{Binding RemoveCommand}" ToolTip.Tip="Stop waiting on it" Padding="3">
                            <c:Icon Data="{StaticResource Icon.Close}" Size="10" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="quiet" Padding="8,4" HorizontalAlignment="Left" ToolTip.Tip="Pick a task in this project that has to be done first">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Plus}" Size="12" VerticalAlignment="Center" />
                    <TextBlock Text="Add a task it waits on" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button.Flyout>
                    <c:FreshMenu Placement="BottomEdgeAlignedLeft" Filling="DependencyFilling" />
                  </Button.Flyout>
                </Button>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding BlockingText}" IsVisible="{Binding HasBlocking}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <!-- Description, with formatting as Asana's -->
            <StackPanel Spacing="6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                  <Button Classes="quiet format" Focusable="False" Click="DescriptionBold" ToolTip.Tip="Bold (Ctrl+B)"><c:Icon Data="{StaticResource Icon.Bold}" Size="13" /></Button>
                  <Button Classes="quiet format" Focusable="False" Click="DescriptionItalic" ToolTip.Tip="Italic (Ctrl+I)"><c:Icon Data="{StaticResource Icon.Italic}" Size="13" /></Button>
                  <Button Classes="quiet format" Focusable="False" Click="DescriptionUnderline" ToolTip.Tip="Underline (Ctrl+U)"><c:Icon Data="{StaticResource Icon.Underline}" Size="13" /></Button>
                  <Button Classes="quiet format" Focusable="False" Click="DescriptionBullets" ToolTip.Tip="Bullets"><c:Icon Data="{StaticResource Icon.Bullets}" Size="13" /></Button>
                  <Button Classes="quiet format" Focusable="False" Click="DescriptionNumbers" ToolTip.Tip="Numbered list"><c:Icon Data="{StaticResource Icon.Numbers}" Size="13" /></Button>
                </StackPanel>
                <TextBlock Classes="label" Text="Description" VerticalAlignment="Center" />
              </DockPanel>
              <Border Classes="description">
                <c:RichTextEditor x:Name="DescriptionEditor" Document="{Binding Description}" Revision="{Binding DescriptionRevision}" PageColours="True"
                                  Placeholder="What is this task about? Links, logins to use, what's needed…" Padding="12,10" MinHeight="96" />
              </Border>
            </StackPanel>

            <!-- Attachments, as Asana's: tiles, pictures shown small; right-click for the cover, the folder or to remove -->
            <StackPanel Spacing="6" IsVisible="{Binding HasAttachments}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="Attachments" VerticalAlignment="Center" />
                <Button Classes="quiet panetool" Click="AttachClicked" ToolTip.Tip="Attach files">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="13" />
                </Button>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AttachmentRow">
                    <Button Classes="filetile" Width="128" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding About}" ContextRequested="AttachmentMenu">
                      <StackPanel Spacing="4">
                        <Border Classes="filethumb" Height="76">
                          <Panel>
                            <Image Source="{Binding Picture}" Stretch="UniformToFill" IsVisible="{Binding HasPicture}" />
                            <c:Icon Data="{StaticResource Icon.Quotes}" Size="24" Foreground="{DynamicResource Muted}" IsVisible="{Binding ShowsIcon}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Classes="coverbadge" IsVisible="{Binding IsCover}" HorizontalAlignment="Left" VerticalAlignment="Top">
                              <TextBlock Text="Cover" FontSize="10" />
                            </Border>
                          </Panel>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Subtasks, as Asana's: a heading with how many are done and a + to add one -->
            <StackPanel x:Name="SubtaskArea" Spacing="4" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label" Text="Subtasks" VerticalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="12" Text="{Binding SubtaskTally}" VerticalAlignment="Center" />
                <Button Classes="quiet panetool" Click="AddSubtaskClicked" ToolTip.Tip="Add a subtask">
                  <c:Icon Data="{StaticResource Icon.Plus}" Size="13" />
                </Button>
              </StackPanel>
              <ItemsControl x:Name="SubtaskList" ItemsSource="{Binding Subtasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskRow">
                    <Border Classes="subtaskrow" Opacity="{Binding Fade}">
                      <Grid ColumnDefinitions="28,*,Auto,Auto,30">
                        <CheckBox Classes="tick" IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Mark complete" />
                        <TextBox Grid.Column="1" Classes="inline" Text="{Binding Title}" />
                        <Button Grid.Column="2" Classes="cell" Click="WhoClicked" ToolTip.Tip="{Binding WhoText}">
                          <Panel>
                            <c:Monogram Text="{Binding WhoInitials}" Size="22" IsVisible="{Binding HasWho}" />
                            <c:Icon Data="{StaticResource Icon.Clients}" Size="14" Foreground="{DynamicResource Muted}" IsVisible="{Binding !HasWho}" />
                          </Panel>
                        </Button>
                        <Button Grid.Column="3" Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Click="DueClicked" ToolTip.Tip="When it's due">
                          <Panel>
                            <TextBlock Text="{Binding DueText}" IsVisible="{Binding HasDue}" />
                            <c:Icon Data="{StaticResource Icon.Calendar}" Size="14" Foreground="{DynamicResource Muted}" IsVisible="{Binding !HasDue}" />
                          </Panel>
                        </Button>
                        <Button Grid.Column="4" Classes="quiet" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the subtask">
                          <c:Icon Data="{StaticResource Icon.Close}" Size="11" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel IsVisible="{Binding ShowSubtaskBox}" Margin="28,2,0,0">
                <TextBox x:Name="NewSubtaskBox" Classes="inline" Text="{Binding NewSubtask}" PlaceholderText="Add subtask, then Enter for the next" KeyDown="AddSubtaskKey" />
              </DockPanel>
              <Button Classes="link" Content="Add subtask" Click="AddSubtaskClicked" IsVisible="{Binding !ShowSubtaskBox}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="Linked to" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenClientCommand}" IsVisible="{Binding HasClient}" Margin="8,0,0,0" />
                <ComboBox x:Name="TaskClientBox" ItemsSource="{Binding Clients}" SelectedItem="{Binding Client, Mode=OneWay}"
                          SelectionChanged="TaskClientPicked" HorizontalAlignment="Stretch" ToolTip.Tip="The client it's about" />
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenDocumentCommand}" IsVisible="{Binding HasDocument}" Margin="8,0,0,0" />
                <ComboBox x:Name="DocumentBox" ItemsSource="{Binding Documents}" SelectedItem="{Binding Document, Mode=OneWay}"
                          SelectionChanged="DocumentPicked" HorizontalAlignment="Stretch" ToolTip.Tip="A quote or invoice it's about" />
              </DockPanel>
              <Border Classes="card" Padding="10,8" IsVisible="{Binding HasMail}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="link" Content="Open" Command="{Binding OpenMailCommand}" />
                    <Button Classes="link" Content="Remove" Command="{Binding RemoveMailCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MailSubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding MailAbout}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding NoMail}">
                <TextBox Text="{Binding MailSearch}" PlaceholderText="Link a mail: search by subject, sender or words" />
                <ItemsControl ItemsSource="{Binding MailFound}" IsVisible="{Binding HasMailFound}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailHit">
                      <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding LinkCommand}">
                        <StackPanel Spacing="2" Margin="6,0">
                          <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="muted" FontSize="12" Text="{Binding History}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- The feed, as Asana's: Comments or All activity, then a box to comment -->
            <Border Height="1" Background="{DynamicResource Line}" Margin="-24,4" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="feedtab" Classes.on="{Binding ShowsComments}" Content="Comments" Command="{Binding ShowCommentsCommand}" />
              <Button Classes="feedtab" Classes.on="{Binding ShowsAll}" Content="All activity" Command="{Binding ShowAllActivityCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="12" Text="No comments yet. Write one below." IsVisible="{Binding NoFeed}" />
            <ItemsControl ItemsSource="{Binding Feed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FeedRow">
                  <DockPanel Margin="0,0,0,12" Background="Transparent" ContextRequested="FeedMenu">
                    <c:Monogram DockPanel.Dock="Left" Text="{Binding Who}" Size="26" VerticalAlignment="Top" Margin="0,0,10,0" IsVisible="{Binding IsComment}" />
                    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource Line2}" VerticalAlignment="Top"
                             Margin="10,7,20,0" IsVisible="{Binding IsActivity}" />
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Text}" FontSize="13" Classes="muted" IsVisible="{Binding IsActivity}" TextWrapping="Wrap" MaxWidth="300" />
                        <TextBlock Text="{Binding When}" Classes="muted" FontSize="12" />
                      </StackPanel>
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsComment}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
              <c:Monogram DockPanel.Dock="Left" Text="{Binding MyName}" Size="28" VerticalAlignment="Top" Margin="0,2,10,0" />
              <StackPanel Spacing="6">
                <TextBox x:Name="CommentBox" Text="{Binding NewComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                         PlaceholderText="Add a comment (Ctrl+Enter to post)" KeyDown="CommentKey" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="link" Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding EditingCommentId, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Button Classes="primary" Content="{Binding CommentButton}" Command="{Binding PostCommentCommand}" />
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Border>
  </c:PanelGrid>

  <UserControl.Resources>
    <!-- Priority (when not Normal) and tags, on a list row or a card. -->
    <DataTemplate x:Key="TaskMarks" x:DataType="vm:TaskRow">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Classes="pill strong" IsVisible="{Binding IsHigh}" ToolTip.Tip="High priority">
          <TextBlock Text="High" FontSize="11" />
        </Border>
        <Border Classes="pill" IsVisible="{Binding IsLow}" ToolTip.Tip="Low priority">
          <TextBlock Text="Low" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Border>
        <Border Classes="pill" IsVisible="{Binding Repeats}" ToolTip.Tip="Comes back once it's ticked off">
          <TextBlock Text="{Binding RepeatLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="pill"><TextBlock Text="{Binding}" FontSize="11" /></Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <!-- Under a task's name in the list: how often it comes back and its tags; priority has its own column. -->
    <DataTemplate x:Key="ListMarks" x:DataType="vm:TaskRow">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Classes="pill" IsVisible="{Binding Repeats}" ToolTip.Tip="Comes back once it's ticked off">
          <TextBlock Text="{Binding RepeatLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="pill"><TextBlock Text="{Binding}" FontSize="11" /></Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProjectRowTemplate" x:DataType="vm:ProjectRow">
      <Button Classes="row" Classes.open="{Binding IsOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="*,28" Margin="8,0">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" IsVisible="{Binding HasAbout}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:Icon Grid.Column="1" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
