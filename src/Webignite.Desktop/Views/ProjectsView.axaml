<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             x:Name="Root">
  <!-- Projects on the left, the open one on the right. The panes move, resize and hide as on Mail. -->
  <c:PanelGrid Layout="{Binding Panels.Layout}" Panels="{Binding Panels}" Resized="PaneResized">
    <Border c:PanelGrid.Pane="list" c:PanelGrid.DefaultWidth="340" Background="{DynamicResource Canvas}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <StackPanel Spacing="16" Margin="24,30,24,30">
          <TextBlock Classes="h1" Text="Projects" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="quiet" Margin="6,0,0,0" ToolTip.Tip="Start a project from a template">
              <c:Icon Data="{StaticResource Icon.ChevronDown}" Size="14" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="TemplatesOpening" />
              </Button.Flyout>
            </Button>
            <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding NewProjectCommand}" ToolTip.Tip="Start a project">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="16" />
            </Button>
            <TextBox x:Name="NewProjectBox" Text="{Binding NewProjectName}" PlaceholderText="New project name" />
          </DockPanel>
          <TextBlock Classes="problem" FontSize="12" Text="{Binding ListMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding ListMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Border Classes="card" Padding="0">
            <Button Classes="row" Classes.open="{Binding IsMyTasks}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding ShowMineCommand}" ToolTip.Tip="Everything given to you, across your projects">
              <Grid ColumnDefinitions="Auto,10,*,Auto" Margin="8,0">
                <c:Icon Data="{StaticResource Icon.Check}" Size="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="My tasks" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="muted" Text="{Binding MyCount}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Border>

          <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Projects}" Title="No projects yet"
                        Text="Type a name above to start one: a website build, an SEO month, anything with steps." />

          <StackPanel Spacing="6" IsVisible="{Binding HasShared}">
            <TextBlock Classes="section" Text="{Binding SharedHeading}" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding SharedProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasPersonal}">
            <TextBlock Classes="section" Text="Just mine" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding PersonalProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <CheckBox IsChecked="{Binding ShowDone}" Content="Show done projects" IsVisible="{Binding !IsEmpty}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The open project -->
    <ScrollViewer c:PanelGrid.Pane="project" c:PanelGrid.DefaultWidth="660" x:Name="ProjectScroll">
      <Panel Margin="32,30" HorizontalAlignment="Stretch">
        <c:EmptyState IsVisible="{Binding IsClosed}" Icon="{StaticResource Icon.Projects}" Title="Pick a project"
                      Text="Its headings and tasks show here. Give tasks to yourself or your partner and set when they're due." VerticalAlignment="Top" />
        <!-- Templates: start a project from one, or remove it -->
        <StackPanel Spacing="12" IsVisible="{Binding IsTemplates}">
          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="Templates" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Start a project from one: it gets the template's headings and tasks, with dates counted from today. Type a name under Projects first to use it." />
          </StackPanel>
          <c:EmptyState IsVisible="{Binding TemplatesEmpty}" Icon="{StaticResource Icon.Projects}" Title="No templates yet"
                        Text="Open a project and click Save as template. It shows here, ready to start the next one from." />
          <ItemsControl ItemsSource="{Binding TemplateRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TemplateRow">
                <Border Classes="card" Padding="16,12" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="link" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                      <Button Classes="primary" Content="Start a project" Command="{Binding StartCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- My tasks: everything given to me, by when it's due -->
        <StackPanel Spacing="12" IsVisible="{Binding IsMyTasks}">
          <StackPanel Spacing="2">
            <TextBlock Classes="h1" Text="My tasks" />
            <TextBlock Classes="muted" Text="{Binding MySummary}" />
          </StackPanel>
          <c:EmptyState IsVisible="{Binding MyTasksEmpty}" Icon="{StaticResource Icon.Check}" Title="All clear"
                        Text="Tasks given to you in any project show here, soonest first. Ones with a due date show in Planner and Calendar too." />
          <ItemsControl ItemsSource="{Binding MyRows}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:MyGroupRow">
                <DockPanel Margin="0,14,0,2">
                  <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Count}" VerticalAlignment="Center" />
                  <TextBlock Classes="section" Classes.overdue="{Binding Overdue}" Text="{Binding Title}" />
                </DockPanel>
              </DataTemplate>
              <DataTemplate DataType="vm:TaskRow">
                <Border Background="Transparent" Padding="0,1" Opacity="{Binding Fade}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="30,*,Auto,32">
                    <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Done" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                      <TextBox Classes="inline" Text="{Binding Title}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,2">
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding ProjectName}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Subtasks, StringFormat='{}{0} subtasks'}" IsVisible="{Binding HasSubtasks}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskMarks}" IsVisible="{Binding HasMarks}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Content="{Binding DueText}"
                            Click="DueClicked" MinWidth="90" VerticalAlignment="Center" ToolTip.Tip="When it's due" />
                    <Button Grid.Column="3" Classes="quiet" Classes.open="{Binding IsOpen}" Padding="6" Margin="4,0,0,0" VerticalAlignment="Center"
                            Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}" ToolTip.Tip="Open the task">
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="16" IsVisible="{Binding IsOpen}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Border Classes="segments" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="segment" Classes.on="{Binding IsList}" Content="List" Command="{Binding ListViewCommand}" />
                  <Button Classes="segment" Classes.on="{Binding IsBoard}" Content="Board" Command="{Binding BoardViewCommand}"
                          ToolTip.Tip="Headings as columns; drag cards across and up and down" />
                </StackPanel>
              </Border>
              <Button Classes="quiet" Content="Save as template" Command="{Binding SaveAsTemplateCommand}"
                      ToolTip.Tip="Keep its headings, tasks and subtasks to start other projects from" />
              <Button Classes="quiet" ToolTip.Tip="Delete the project and its tasks" Command="{Binding DeleteProjectCommand}">
                <c:Icon Data="{StaticResource Icon.Trash}" Size="16" />
              </Button>
              <Button Classes="link" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBox Classes="inline heading" FontSize="22" Text="{Binding EditName}" PlaceholderText="Project name" />
              <TextBlock Classes="muted" Margin="7,0,0,0" Text="{Binding Summary}" />
            </StackPanel>
          </DockPanel>

          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <CheckBox IsChecked="{Binding EditShared}" Content="{Binding SharedLabel}" VerticalAlignment="Center"
                      ToolTip.Tip="Shared projects reach your partner once sync is set up. Until then they stay on this PC." />
            <ComboBox x:Name="ClientBox" ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding EditClient, Mode=OneWay}"
                      SelectionChanged="ClientPicked" MinWidth="200" ToolTip.Tip="The client it's for" />
            <ComboBox x:Name="StatusBox" ItemsSource="{x:Static vm:ProjectsViewModel.Statuses}" SelectedItem="{Binding EditStatus, Mode=OneWay}"
                      SelectionChanged="StatusPicked" MinWidth="120" />
            <CalendarDatePicker SelectedDate="{Binding EditDue}" Watermark="Due date" Width="150" ToolTip.Tip="When the whole project is due" />
          </WrapPanel>
          <TextBlock Classes="problem" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Filters out of the way: one button that says what's filtered -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Classes.chosen="{Binding HasFilter}" Content="{Binding FilterText}" ToolTip.Tip="Show tasks of one priority or with one tag">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="8" Width="220">
                    <TextBlock Classes="label" Text="Priority" />
                    <ComboBox x:Name="PriorityFilterBox" ItemsSource="{x:Static vm:ProjectsViewModel.PriorityFilters}" SelectedItem="{Binding FilterPriority, Mode=OneWay}"
                              SelectionChanged="PriorityFilterPicked" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="label" Text="Tag" />
                    <ComboBox x:Name="TagFilterBox" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding FilterTag, Mode=OneWay}"
                              SelectionChanged="TagFilterPicked" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Classes="link" Content="Show all" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasFilter}" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl x:Name="TaskList" ItemsSource="{Binding Rows}" IsVisible="{Binding IsList}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:SectionRow">
                <Border Classes.droptop="{Binding DropHere}" Margin="0,14,0,2" Padding="0,0,0,4" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="quiet" Padding="6" IsVisible="{Binding IsHeading}" Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete the heading; its tasks stay, under no heading">
                      <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Count}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBox Classes="inline heading" Text="{Binding Name}" IsVisible="{Binding IsHeading}" />
                    <TextBlock Classes="section" Text="Not under a heading" IsVisible="{Binding IsLoose}" Margin="7,6" />
                  </DockPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:TaskRow">
                <Border Classes.droptop="{Binding DropAbove}" Classes.dropbottom="{Binding DropBelow}" Background="Transparent" Padding="0,1"
                        Opacity="{Binding Fade}" ContextRequested="TaskMenu">
                  <Grid ColumnDefinitions="22,30,*,Auto,Auto,Auto,32">
                    <Border Classes="grip" Background="Transparent" Cursor="SizeAll" PointerPressed="GripPressed" ToolTip.Tip="Drag to move">
                      <c:Icon Data="{StaticResource Icon.Grip}" Size="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Done" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBox Classes="inline" Text="{Binding Title}" />
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskMarks}" IsVisible="{Binding HasMarks}" Margin="6,0,0,4" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="{Binding Subtasks}" IsVisible="{Binding HasSubtasks}"
                               VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="Subtasks done" />
                    <!-- Who and when read as words; a click changes them. Delete is on the right-click menu. -->
                    <Button Grid.Column="4" Classes="cell" Classes.empty="{Binding !HasWho}" Content="{Binding WhoText}" Click="WhoClicked"
                            MinWidth="90" ToolTip.Tip="Who it's for" />
                    <Button Grid.Column="5" Classes="cell" Classes.empty="{Binding !HasDue}" Classes.late="{Binding IsLate}" Content="{Binding DueText}"
                            Click="DueClicked" MinWidth="90" ToolTip.Tip="When it's due" />
                    <Button Grid.Column="6" Classes="quiet" Classes.open="{Binding IsOpen}" Padding="6" Margin="4,0,0,0"
                            Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Open the task: notes, subtasks and what it's about">
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:AddTaskRow">
                <DockPanel Margin="52,2,0,0">
                  <Button DockPanel.Dock="Right" Classes="link" Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
                  <TextBox Classes="inline" Text="{Binding Title}" PlaceholderText="Add a task, then Enter" KeyDown="AddTaskKey" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>

          <!-- The board: a column per heading, its tasks as cards. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsBoard}">
            <ItemsControl x:Name="Board" ItemsSource="{Binding Columns}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BoardColumn">
                  <Border Width="270" Background="{DynamicResource TableHead}" CornerRadius="10" Padding="10" VerticalAlignment="Top"
                          BorderBrush="{DynamicResource Primary}" BorderThickness="{Binding DropHere, Converter={x:Static vm:BoardColumn.DropEdge}}">
                    <StackPanel Spacing="8">
                      <DockPanel Margin="4,0">
                        <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Section.Count}" VerticalAlignment="Center" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Section.Name}" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TaskRow">
                            <Border Classes.droptop="{Binding DropAbove}" Classes.dropbottom="{Binding DropBelow}" Padding="0,3" Background="Transparent"
                                    ContextRequested="TaskMenu">
                              <Border Classes="card" Classes.open="{Binding IsOpen}" Padding="8" Opacity="{Binding Fade}">
                                <Grid ColumnDefinitions="18,26,*">
                                  <Border Background="Transparent" Cursor="SizeAll" PointerPressed="GripPressed" ToolTip.Tip="Drag to move" VerticalAlignment="Top" Margin="0,3,0,0">
                                    <c:Icon Data="{StaticResource Icon.Grip}" Size="14" Foreground="{DynamicResource Muted}" />
                                  </Border>
                                  <CheckBox Grid.Column="1" IsChecked="{Binding Done}" VerticalAlignment="Top" ToolTip.Tip="Done" />
                                  <Button Grid.Column="2" Classes="link" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}"
                                          ToolTip.Tip="Open the task">
                                    <StackPanel Spacing="3">
                                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
                                      <TextBlock Classes="muted" FontSize="12" Text="{Binding CardLine}" IsVisible="{Binding HasCardLine}" TextWrapping="Wrap" />
                                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskMarks}" IsVisible="{Binding HasMarks}" Margin="0,2,0,0" />
                                    </StackPanel>
                                  </Button>
                                </Grid>
                              </Border>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBox Classes="inline" Text="{Binding Add.Title}" PlaceholderText="Add a card, then Enter" KeyDown="AddCardKey" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Classes="quiet" Content="Add heading" Command="{Binding AddHeadingCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding NewHeadingName}" PlaceholderText="New heading, e.g. Design, Build, Launch" KeyDown="AddHeadingKey" />
          </DockPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- The open task -->
    <Border c:PanelGrid.Pane="task" c:PanelGrid.DefaultWidth="440" Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <Panel Margin="24,30">
          <c:EmptyState IsVisible="{Binding !HasTask}" Icon="{StaticResource Icon.Projects}" Title="Open a task"
                        Text="Click the arrow at the end of a task to see its notes and subtasks here." VerticalAlignment="Top" />
          <StackPanel Spacing="14" IsVisible="{Binding #Root.((vm:ProjectsViewModel)DataContext).HasTask}" DataContext="{Binding Detail}" x:DataType="vm:TaskDetail">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button Classes="quiet" Padding="6" Command="{Binding StartTimerCommand}" ToolTip.Tip="Start the timer on this task (Time page)">
                  <c:Icon Data="{StaticResource Icon.Time}" Size="14" />
                </Button>
                <Button Classes="quiet" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the task and its subtasks">
                  <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                </Button>
                <Button Classes="link" Content="Close" Command="{Binding CloseCommand}" />
              </StackPanel>
              <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,6,4,0" ToolTip.Tip="Done" />
              <TextBox Classes="inline heading" FontSize="18" Text="{Binding Title}" TextWrapping="Wrap" PlaceholderText="Task title" />
            </DockPanel>
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Classes="muted" Text="For" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="muted" Text="Start" VerticalAlignment="Center" />
              <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Start}" Watermark="No start date" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Classes="muted" Text="Due" VerticalAlignment="Center" />
              <CalendarDatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Due}" Watermark="No due date" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="muted" Text="Heading" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="HeadingBox" ItemsSource="{Binding Headings}" SelectedItem="{Binding Heading, Mode=OneWay}"
                        SelectionChanged="HeadingPicked" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="4" Classes="muted" Text="Priority" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="6" Classes="muted" Text="Repeats" VerticalAlignment="Center" />
              <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Repeats}" SelectedItem="{Binding Repeat}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Ticking it off makes the next one" />
              <TextBlock Grid.Row="5" Classes="muted" Text="Tags" VerticalAlignment="Top" Margin="0,8,0,0" />
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding TagsText}" PlaceholderText="e.g. Hosting, SEO" />
                <ItemsControl ItemsSource="{Binding OtherTags}" IsVisible="{Binding HasOtherTags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="quiet" Padding="8,2" FontSize="12" Content="{Binding StringFormat='+ {0}'}"
                              Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).Detail.AddTagCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Notes" />
              <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" PlaceholderText="What needs doing, links, logins to use..." />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Subtasks" />
              <ItemsControl ItemsSource="{Binding Subtasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskRow">
                    <Grid ColumnDefinitions="30,*,110,32" Opacity="{Binding Fade}" Margin="0,1">
                      <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="inline" Text="{Binding Title}" />
                      <ComboBox Grid.Column="2" ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" MinHeight="30" Margin="4,0" HorizontalAlignment="Stretch"
                                ToolTip.Tip="Who it's for" />
                      <Button Grid.Column="3" Classes="quiet" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the subtask">
                        <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Add" Command="{Binding AddSubtaskCommand}" Margin="8,0,0,0" />
                <TextBox Classes="inline" Text="{Binding NewSubtask}" PlaceholderText="Add a subtask, then Enter" KeyDown="AddSubtaskKey" />
              </DockPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="What it's about" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenClientCommand}" IsVisible="{Binding HasClient}" Margin="8,0,0,0" />
                <ComboBox x:Name="TaskClientBox" ItemsSource="{Binding Clients}" SelectedItem="{Binding Client, Mode=OneWay}"
                          SelectionChanged="TaskClientPicked" HorizontalAlignment="Stretch" ToolTip.Tip="The client it's about" />
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenDocumentCommand}" IsVisible="{Binding HasDocument}" Margin="8,0,0,0" />
                <ComboBox x:Name="DocumentBox" ItemsSource="{Binding Documents}" SelectedItem="{Binding Document, Mode=OneWay}"
                          SelectionChanged="DocumentPicked" HorizontalAlignment="Stretch" ToolTip.Tip="A quote or invoice it's about" />
              </DockPanel>
              <Border Classes="card" Padding="10,8" IsVisible="{Binding HasMail}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="link" Content="Open" Command="{Binding OpenMailCommand}" />
                    <Button Classes="link" Content="Remove" Command="{Binding RemoveMailCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MailSubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding MailAbout}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding NoMail}">
                <TextBox Text="{Binding MailSearch}" PlaceholderText="Link a mail: search by subject, sender or words" />
                <ItemsControl ItemsSource="{Binding MailFound}" IsVisible="{Binding HasMailFound}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailHit">
                      <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding LinkCommand}">
                        <StackPanel Spacing="2" Margin="6,0">
                          <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="muted" FontSize="12" Text="{Binding History}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Border>
  </c:PanelGrid>

  <UserControl.Resources>
    <!-- Priority (when not Normal) and tags, on a list row or a card. -->
    <DataTemplate x:Key="TaskMarks" x:DataType="vm:TaskRow">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Classes="pill strong" IsVisible="{Binding IsHigh}" ToolTip.Tip="High priority">
          <TextBlock Text="High" FontSize="11" />
        </Border>
        <Border Classes="pill" IsVisible="{Binding IsLow}" ToolTip.Tip="Low priority">
          <TextBlock Text="Low" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Border>
        <Border Classes="pill" IsVisible="{Binding Repeats}" ToolTip.Tip="Comes back once it's ticked off">
          <TextBlock Text="{Binding RepeatLabel}" FontSize="11" Foreground="{DynamicResource Muted}" />
        </Border>
        <ItemsControl ItemsSource="{Binding Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Border Classes="pill"><TextBlock Text="{Binding}" FontSize="11" /></Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProjectRowTemplate" x:DataType="vm:ProjectRow">
      <Button Classes="row" Classes.open="{Binding IsOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="*,28" Margin="8,0">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" IsVisible="{Binding HasAbout}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:Icon Grid.Column="1" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
