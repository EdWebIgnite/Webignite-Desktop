<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel"
             x:Name="Root">
  <!-- Projects on the left, the open one on the right. The panes move, resize and hide as on Mail. -->
  <c:PanelGrid Layout="{Binding Panels.Layout}" Panels="{Binding Panels}" Resized="PaneResized">
    <Border c:PanelGrid.Pane="list" c:PanelGrid.DefaultWidth="340" Background="{DynamicResource Canvas}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer>
        <StackPanel Spacing="16" Margin="24,30,24,30">
          <TextBlock Classes="h1" Text="Projects" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Margin="8,0,0,0" Command="{Binding NewProjectCommand}" ToolTip.Tip="Start a project">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="16" />
            </Button>
            <TextBox x:Name="NewProjectBox" Text="{Binding NewProjectName}" PlaceholderText="New project name" />
          </DockPanel>
          <TextBlock Classes="problem" FontSize="12" Text="{Binding ListMessage}" TextWrapping="Wrap"
                     IsVisible="{Binding ListMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Projects}" Title="No projects yet"
                        Text="Type a name above to start one: a website build, an SEO month, anything with steps." />

          <StackPanel Spacing="6" IsVisible="{Binding HasShared}">
            <TextBlock Classes="section" Text="{Binding SharedHeading}" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding SharedProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding HasPersonal}">
            <TextBlock Classes="section" Text="Just mine" />
            <Border Classes="card" Padding="0">
              <ItemsControl ItemsSource="{Binding PersonalProjects}" ItemTemplate="{StaticResource ProjectRowTemplate}" />
            </Border>
          </StackPanel>
          <CheckBox IsChecked="{Binding ShowDone}" Content="Show done projects" IsVisible="{Binding !IsEmpty}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The open project -->
    <ScrollViewer c:PanelGrid.Pane="project" c:PanelGrid.DefaultWidth="660" x:Name="ProjectScroll">
      <Panel Margin="32,30" MaxWidth="1000" HorizontalAlignment="Stretch">
        <c:EmptyState IsVisible="{Binding IsClosed}" Icon="{StaticResource Icon.Projects}" Title="Pick a project"
                      Text="Its headings and tasks show here. Give tasks to yourself or your partner and set when they're due." VerticalAlignment="Top" />
        <StackPanel Spacing="16" IsVisible="{Binding IsOpen}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Classes="quiet" ToolTip.Tip="Delete the project and its tasks" Command="{Binding DeleteProjectCommand}">
                <c:Icon Data="{StaticResource Icon.Trash}" Size="16" />
              </Button>
              <Button Classes="link" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBox Classes="inline heading" FontSize="22" Text="{Binding EditName}" PlaceholderText="Project name" />
              <TextBlock Classes="muted" Margin="7,0,0,0" Text="{Binding Summary}" />
            </StackPanel>
          </DockPanel>

          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <CheckBox IsChecked="{Binding EditShared}" Content="{Binding SharedLabel}" VerticalAlignment="Center"
                      ToolTip.Tip="Shared projects reach your partner once sync is set up. Until then they stay on this PC." />
            <ComboBox x:Name="ClientBox" ItemsSource="{Binding ClientChoices}" SelectedItem="{Binding EditClient, Mode=OneWay}"
                      SelectionChanged="ClientPicked" MinWidth="200" ToolTip.Tip="The client it's for" />
            <ComboBox x:Name="StatusBox" ItemsSource="{x:Static vm:ProjectsViewModel.Statuses}" SelectedItem="{Binding EditStatus, Mode=OneWay}"
                      SelectionChanged="StatusPicked" MinWidth="120" />
            <CalendarDatePicker SelectedDate="{Binding EditDue}" Watermark="Due date" Width="150" ToolTip.Tip="When the whole project is due" />
          </WrapPanel>
          <TextBlock Classes="problem" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ItemsControl x:Name="TaskList" ItemsSource="{Binding Rows}">
            <ItemsControl.DataTemplates>
              <DataTemplate DataType="vm:SectionRow">
                <Border Classes.droptop="{Binding DropHere}" Margin="0,14,0,2" Padding="0,0,0,4" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="quiet" Padding="6" IsVisible="{Binding IsHeading}" Command="{Binding DeleteCommand}"
                            ToolTip.Tip="Delete the heading; its tasks stay, under no heading">
                      <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding Count}" VerticalAlignment="Center" Margin="8,0" />
                    <TextBox Classes="inline heading" Text="{Binding Name}" IsVisible="{Binding IsHeading}" />
                    <TextBlock Classes="section" Text="Not under a heading" IsVisible="{Binding IsLoose}" Margin="7,6" />
                  </DockPanel>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:TaskRow">
                <Border Classes.droptop="{Binding DropAbove}" Classes.dropbottom="{Binding DropBelow}" Background="Transparent" Padding="0,1"
                        Opacity="{Binding Fade}" ContextRequested="TaskMenu">
                  <Grid ColumnDefinitions="22,30,*,Auto,150,140,32,32">
                    <Border Classes="grip" Background="Transparent" Cursor="SizeAll" PointerPressed="GripPressed" ToolTip.Tip="Drag to move">
                      <c:Icon Data="{StaticResource Icon.Grip}" Size="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Done}" VerticalAlignment="Center" ToolTip.Tip="Done" />
                    <TextBox Grid.Column="2" Classes="inline" Text="{Binding Title}" />
                    <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Text="{Binding Subtasks}" IsVisible="{Binding HasSubtasks}"
                               VerticalAlignment="Center" Margin="8,0" ToolTip.Tip="Subtasks done" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" Margin="4,0" MinHeight="30"
                              HorizontalAlignment="Stretch" ToolTip.Tip="Who it's for" />
                    <CalendarDatePicker Grid.Column="5" SelectedDate="{Binding Due}" Watermark="Due" MinHeight="30" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="When it's due" />
                    <Button Grid.Column="6" Classes="quiet" Padding="6" Margin="4,0,0,0" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the task">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                    </Button>
                    <Button Grid.Column="7" Classes="quiet" Classes.open="{Binding IsOpen}" Padding="6" Margin="4,0,0,0"
                            Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenTaskCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Open the task: notes, subtasks and what it's about">
                      <c:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
              <DataTemplate DataType="vm:AddTaskRow">
                <DockPanel Margin="52,2,0,0">
                  <Button DockPanel.Dock="Right" Classes="link" Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0" />
                  <TextBox Classes="inline" Text="{Binding Title}" PlaceholderText="Add a task, then Enter" KeyDown="AddTaskKey" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.DataTemplates>
          </ItemsControl>

          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Classes="quiet" Content="Add heading" Command="{Binding AddHeadingCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding NewHeadingName}" PlaceholderText="New heading, e.g. Design, Build, Launch" KeyDown="AddHeadingKey" />
          </DockPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- The open task -->
    <Border c:PanelGrid.Pane="task" c:PanelGrid.DefaultWidth="440" Background="{DynamicResource Surface2}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <Panel Margin="24,30">
          <c:EmptyState IsVisible="{Binding !HasTask}" Icon="{StaticResource Icon.Projects}" Title="Open a task"
                        Text="Click the arrow at the end of a task to see its notes and subtasks here." VerticalAlignment="Top" />
          <StackPanel Spacing="14" IsVisible="{Binding #Root.((vm:ProjectsViewModel)DataContext).HasTask}" DataContext="{Binding Detail}" x:DataType="vm:TaskDetail">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button Classes="quiet" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the task and its subtasks">
                  <c:Icon Data="{StaticResource Icon.Trash}" Size="14" />
                </Button>
                <Button Classes="link" Content="Close" Command="{Binding CloseCommand}" />
              </StackPanel>
              <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,6,4,0" ToolTip.Tip="Done" />
              <TextBox Classes="inline heading" FontSize="18" Text="{Binding Title}" TextWrapping="Wrap" PlaceholderText="Task title" />
            </DockPanel>
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Classes="muted" Text="For" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="1" Classes="muted" Text="Start" VerticalAlignment="Center" />
              <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Start}" Watermark="No start date" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Classes="muted" Text="Due" VerticalAlignment="Center" />
              <CalendarDatePicker Grid.Row="2" Grid.Column="1" SelectedDate="{Binding Due}" Watermark="No due date" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="3" Classes="muted" Text="Heading" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="HeadingBox" ItemsSource="{Binding Headings}" SelectedItem="{Binding Heading, Mode=OneWay}"
                        SelectionChanged="HeadingPicked" HorizontalAlignment="Stretch" />
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Notes" />
              <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" PlaceholderText="What needs doing, links, logins to use..." />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Subtasks" />
              <ItemsControl ItemsSource="{Binding Subtasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskRow">
                    <Grid ColumnDefinitions="30,*,110,32" Opacity="{Binding Fade}" Margin="0,1">
                      <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Classes="inline" Text="{Binding Title}" />
                      <ComboBox Grid.Column="2" ItemsSource="{Binding People}" SelectedItem="{Binding AssignedTo}" MinHeight="30" Margin="4,0" HorizontalAlignment="Stretch"
                                ToolTip.Tip="Who it's for" />
                      <Button Grid.Column="3" Classes="quiet" Padding="6" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete the subtask">
                        <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Add" Command="{Binding AddSubtaskCommand}" Margin="8,0,0,0" />
                <TextBox Classes="inline" Text="{Binding NewSubtask}" PlaceholderText="Add a subtask, then Enter" KeyDown="AddSubtaskKey" />
              </DockPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="What it's about" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenClientCommand}" IsVisible="{Binding HasClient}" Margin="8,0,0,0" />
                <ComboBox x:Name="TaskClientBox" ItemsSource="{Binding Clients}" SelectedItem="{Binding Client, Mode=OneWay}"
                          SelectionChanged="TaskClientPicked" HorizontalAlignment="Stretch" ToolTip.Tip="The client it's about" />
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Content="Open" Command="{Binding OpenDocumentCommand}" IsVisible="{Binding HasDocument}" Margin="8,0,0,0" />
                <ComboBox x:Name="DocumentBox" ItemsSource="{Binding Documents}" SelectedItem="{Binding Document, Mode=OneWay}"
                          SelectionChanged="DocumentPicked" HorizontalAlignment="Stretch" ToolTip.Tip="A quote or invoice it's about" />
              </DockPanel>
              <Border Classes="card" Padding="10,8" IsVisible="{Binding HasMail}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="link" Content="Open" Command="{Binding OpenMailCommand}" />
                    <Button Classes="link" Content="Remove" Command="{Binding RemoveMailCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MailSubject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding MailAbout}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel Spacing="4" IsVisible="{Binding NoMail}">
                <TextBox Text="{Binding MailSearch}" PlaceholderText="Link a mail: search by subject, sender or words" />
                <ItemsControl ItemsSource="{Binding MailFound}" IsVisible="{Binding HasMailFound}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailHit">
                      <Button Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding LinkCommand}">
                        <StackPanel Spacing="2" Margin="6,0">
                          <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="muted" FontSize="12" Text="{Binding History}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Border>
  </c:PanelGrid>

  <UserControl.Resources>
    <DataTemplate x:Key="ProjectRowTemplate" x:DataType="vm:ProjectRow">
      <Button Classes="row" Classes.open="{Binding IsOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Command="{Binding #Root.((vm:ProjectsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="*,28" Margin="8,0">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding About}" IsVisible="{Binding HasAbout}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <c:Icon Grid.Column="1" Classes="chevron" Data="{StaticResource Icon.ChevronRight}" HorizontalAlignment="Right" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
