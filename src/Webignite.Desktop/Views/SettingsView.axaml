<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notes="using:Webignite.Core.Notes"
             xmlns:tools="using:Webignite.Core.Tools"
             xmlns:c="using:Webignite.Desktop.Controls"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="Settings" />
    <Grid ColumnDefinitions="208,*" ColumnSpacing="28">
      <!-- The side menu: one section at a time, so nothing has to be hunted for. -->
      <ListBox Grid.Column="0" Classes="sections" ItemsSource="{x:Static vm:SettingsViewModel.Sections}" SelectedItem="{Binding Current}"
               VerticalAlignment="Top">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsViewModel+Section">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Spacing="18">

    <Border Classes="card" IsVisible="{Binding ShowXero}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Xero" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Sign-in happens in your own browser on Xero's site. Webignite never sees your Xero password, and the sign-in is kept in Windows Credential Manager." />
        <StackPanel IsVisible="{Binding !IsConnected}" Spacing="10">
          <StackPanel>
            <TextBlock Classes="label" Text="Client ID from your app at developer.xero.com" />
            <TextBox Text="{Binding ClientId}" MaxWidth="420" HorizontalAlignment="Left" Width="420" PlaceholderText="32 letters and numbers" />
          </StackPanel>
          <Button Classes="primary" Content="Connect Xero" Command="{Binding ConnectCommand}" />
        </StackPanel>
        <Border Classes.ready="{Binding IsConnected}" Classes.pending="{Binding !IsConnected}">
          <TextBlock Text="{Binding XeroStatus}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Spacing="8" IsVisible="{Binding IsConnected}">
          <TextBlock FontWeight="SemiBold" Text="Sales account" Margin="0,6,0,0" />
          <TextBlock TextWrapping="Wrap" Text="{Binding AccountText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="Choose from Xero" Command="{Binding LoadAccountsCommand}" IsVisible="{Binding !HasAccounts}" />
            <ComboBox ItemsSource="{Binding SalesAccounts}" SelectedItem="{Binding ChosenAccount}" MinWidth="280" IsVisible="{Binding HasAccounts}" />
            <Button Classes="primary" Content="Use this account" Command="{Binding SaveAccountCommand}" IsVisible="{Binding HasAccounts}" />
          </StackPanel>
          <TextBlock FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Classes="muted" Classes.problem="{Binding AccountProblem}" Text="{Binding AccountMessage}" />
          <TextBlock FontWeight="SemiBold" Text="Branding theme" Margin="0,6,0,0" />
          <TextBlock TextWrapping="Wrap" Text="{Binding ThemeText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="Choose from Xero" Command="{Binding LoadThemesCommand}" IsVisible="{Binding !HasThemes}" />
            <ComboBox ItemsSource="{Binding BrandingThemes}" SelectedItem="{Binding ChosenTheme}" MinWidth="280" IsVisible="{Binding HasThemes}" />
            <Button Classes="primary" Content="Use this theme" Command="{Binding SaveThemeCommand}" IsVisible="{Binding HasThemes}" />
          </StackPanel>
          <TextBlock FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Classes="muted" Classes.problem="{Binding ThemeProblem}" Text="{Binding ThemeMessage}" />
        </StackPanel>
        <Button Classes="quiet" Content="Disconnect Xero" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowBackups}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Backups" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Once a day Webignite saves an encrypted copy of everything to the folder below and keeps the last 14. Pick a folder in OneDrive or on another drive, so a broken PC doesn't take the backups with it." />
        <Border Classes.ready="{Binding !BackupProblem}" Classes.pending="{Binding BackupProblem}">
          <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" Classes.problem="{Binding BackupProblem}" />
        </Border>

        <StackPanel>
          <TextBlock Classes="label" Text="Backup folder" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
              <Button Classes="quiet" Content="Choose folder" Click="ChooseBackupFolder" />
              <Button Classes="link" Content="Open" Command="{Binding OpenBackupFolderCommand}" />
            </StackPanel>
            <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" />
          </DockPanel>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding ShowPasswordFields}">
          <TextBlock FontWeight="SemiBold" Text="Backup password" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                     Text="It locks every backup, and you'll need it to restore on a new PC. Write it down somewhere safe. It stays on this PC in Windows Credential Manager." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBox Width="240" PasswordChar="•" Text="{Binding NewBackupPassword}" PlaceholderText="At least 10 characters" />
            <TextBox Width="240" PasswordChar="•" Text="{Binding RepeatBackupPassword}" PlaceholderText="Type it again" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="Save password" Command="{Binding SaveBackupPasswordCommand}" />
            <Button Classes="link" Content="Cancel" Command="{Binding CancelPasswordCommand}" IsVisible="{Binding HasBackupPassword}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasBackupPassword}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="Back up now" Command="{Binding BackUpNowCommand}" IsEnabled="{Binding !BackingUp}" />
            <c:Spinner IsVisible="{Binding BackingUp}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="quiet" Content="Restore a backup" Click="ChooseRestoreFile" />
          <Button Classes="link" Content="Change backup password" Command="{Binding ChangePasswordCommand}" IsVisible="{Binding !ChangingPassword}" />
        </StackPanel>

        <Border Classes="pending" IsVisible="{Binding ShowRestore}">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{Binding RestoreFileName, StringFormat='Restore {0}'}" TextWrapping="Wrap" />
            <TextBlock FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                       Text="This replaces everything in Webignite with what's in the backup. Your current data is kept aside first, so nothing is lost." />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBox Width="240" PasswordChar="•" Text="{Binding RestorePassword}" PlaceholderText="Password of that backup" />
              <Button Classes="primary" Content="Unlock backup" Command="{Binding RestoreCommand}" />
              <Button Classes="link" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Button Classes="primary" Content="Restart and restore" Command="{Binding RestartToRestoreCommand}" IsVisible="{Binding RestoreReady}" />

        <TextBlock FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Classes="muted" Classes.problem="{Binding BackupMessageIsProblem}"
                   Text="{Binding BackupMessage}" IsVisible="{Binding BackupMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="Mailbox passwords and the Xero sign-in aren't in backups. After restoring on a new PC, sign in to those again." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowLook}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Menu" />
        <Border Classes="segments" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.on="{Binding IsMenuDock}" Content="Dock" Command="{Binding UseMenuCommand}" CommandParameter="Dock" />
            <Button Classes="segment" Classes.on="{Binding IsMenuSidebar}" Content="Sidebar" Command="{Binding UseMenuCommand}" CommandParameter="Sidebar" />
            <Button Classes="segment" Classes.on="{Binding IsMenuButton}" Content="Menu button" Command="{Binding UseMenuCommand}" CommandParameter="Button" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="How you get to pages. Dock, which the app starts with, puts the pages you use most in a bar along the bottom, with the rest behind More; right-click a page in the menu to add it to the dock, or one on the dock to take it off. Sidebar is the list down the left. Menu button leaves the page the whole width, and one button (or Ctrl+M) opens every page, tool and project over it, with how things stand beside each." />
        <!-- The dock's own choices: a strip of its own or floating, and what sits beside it. -->
        <StackPanel Spacing="10" IsVisible="{Binding IsMenuDock}">
          <TextBlock Classes="label" Text="Where the dock sits" />
          <Border Classes="segments" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Button Classes="segment" Classes.on="{Binding Dock.DockHasStrip}" Content="In a strip of its own" Command="{Binding Dock.FloatCommand}" CommandParameter="no" />
              <Button Classes="segment" Classes.on="{Binding Dock.DockFloats}" Content="Floating over the page" Command="{Binding Dock.FloatCommand}" CommandParameter="yes" />
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                     Text="Floating gives the page the window's full height; the dock then covers the middle of the page's bottom edge." />
          <TextBlock Classes="label" Text="Beside the dock" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding Dock.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BarChoiceRow">
                <Grid ColumnDefinitions="150,Auto" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="segments">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="segment" Classes.on="{Binding IsLeft}" Content="Left"
                              Command="{Binding #Root.((vm:SettingsViewModel)DataContext).Dock.PutLeftCommand}" CommandParameter="{Binding}" />
                      <Button Classes="segment" Classes.on="{Binding IsRight}" Content="Right"
                              Command="{Binding #Root.((vm:SettingsViewModel)DataContext).Dock.PutRightCommand}" CommandParameter="{Binding}" />
                      <Button Classes="segment" Classes.on="{Binding IsOff}" Content="Off"
                              Command="{Binding #Root.((vm:SettingsViewModel)DataContext).Dock.TakeOffCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="link" Content="Back to the usual ones" Command="{Binding Dock.UsualCommand}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460"
                       Text="Right-click one beside the dock to move it across or take it off. To put a tool or a whole group on the dock, right-click it in the menu behind More." />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="quiet" Content="Choose what is on the menu…" Command="{Binding EditMenuCommand}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420"
                     Text="Take off the pages and tools you don't use, whichever menu you have. They stay a search (Ctrl+K) or a shortcut away, and can be put back." />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowLook}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Style" />
        <Border Classes="segments" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.on="{Binding IsClassic}" Content="Classic" Command="{Binding UseStyleCommand}" CommandParameter="Classic" />
            <Button Classes="segment" Classes.on="{Binding IsAiry}" Content="Airy" Command="{Binding UseStyleCommand}" CommandParameter="Airy" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="The shape of the app: spacing, corners and edges. Classic is the look Webignite has always had. Airy gives everything more room, with flat cards, soft boxes and slightly larger small text. Any style goes with any colours below." />
        <TextBlock Classes="label" Text="Sidebar" />
        <Border Classes="segments" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.on="{Binding IsDarkSidebar}" Content="Dark" Command="{Binding UseSidebarCommand}" CommandParameter="Dark" />
            <Button Classes="segment" Classes.on="{Binding IsLightSidebar}" Content="Light" Command="{Binding UseSidebarCommand}" CommandParameter="Light" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="Light makes the sidebar white, like the cards, in whichever look is picked." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowLook}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Light and dark" />
        <Border Classes="segments" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.on="{Binding IsLight}" Content="Light" Command="{Binding UseThemeCommand}" CommandParameter="Light" />
            <Button Classes="segment" Classes.on="{Binding IsDark}" Content="Dark" Command="{Binding UseThemeCommand}" CommandParameter="Dark" />
            <Button Classes="segment" Classes.on="{Binding IsFollowingWindows}" Content="Same as Windows" Command="{Binding UseThemeCommand}" CommandParameter="FollowWindows" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="Pick a light look and a dark look. Same as Windows switches between your light and dark looks when Windows does." />
        <TextBlock Classes="label" Text="Light look" />
        <WrapPanel>
          <Button Classes="palette" Classes.on="{Binding IsStandardLight}" Command="{Binding UseLightPaletteCommand}" CommandParameter="Standard">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewStandardLight" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Webignite" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Light page, black sidebar" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="palette" Classes.on="{Binding IsAsanaLight}" Command="{Binding UseLightPaletteCommand}" CommandParameter="Asana">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewAsanaLight" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Asana" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Asana's light colours" />
              </StackPanel>
            </StackPanel>
          </Button>
        </WrapPanel>
        <TextBlock Classes="label" Text="Dark look" />
        <WrapPanel>
          <Button Classes="palette" Classes.on="{Binding IsGraphite}" Command="{Binding UseDarkPaletteCommand}" CommandParameter="Graphite">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewGraphite" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Graphite" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Neutral grey" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="palette" Classes.on="{Binding IsMidnight}" Command="{Binding UseDarkPaletteCommand}" CommandParameter="Midnight">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewMidnight" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Midnight" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Deep blue" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="palette" Classes.on="{Binding IsWarm}" Command="{Binding UseDarkPaletteCommand}" CommandParameter="Warm">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewWarm" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Warm" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Charcoal brown" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button Classes="palette" Classes.on="{Binding IsAsanaDark}" Command="{Binding UseDarkPaletteCommand}" CommandParameter="Asana">
            <StackPanel Spacing="8">
              <Border x:Name="PreviewAsanaDark" Width="200" Height="112" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Canvas}">
                <Grid ColumnDefinitions="46,*">
                  <Border Background="{DynamicResource Nav}" Padding="7,10">
                    <StackPanel Spacing="7">
                      <Border Height="6" CornerRadius="3" Background="{DynamicResource NavText}" Width="26" HorizontalAlignment="Left" />
                      <Border Height="10" CornerRadius="3" Background="{DynamicResource NavSelected}" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="24" HorizontalAlignment="Left" />
                      <Border Height="5" CornerRadius="2" Background="{DynamicResource NavMuted}" Width="20" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10" Spacing="8">
                    <Border Height="7" CornerRadius="3" Background="{DynamicResource Ink}" Width="60" HorizontalAlignment="Left" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="8">
                      <StackPanel Spacing="5">
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Text}" Width="80" HorizontalAlignment="Left" />
                        <Border Height="5" CornerRadius="2" Background="{DynamicResource Muted}" Width="56" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Border Height="12" Width="38" CornerRadius="3" Background="{DynamicResource Primary}" />
                          <Border Height="12" Width="24" CornerRadius="3" Background="{DynamicResource AttentionSoft}" BorderBrush="{DynamicResource AttentionLine}" BorderThickness="1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Spacing="1">
                <TextBlock Text="Asana" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Asana's dark greys" />
              </StackPanel>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowLook}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Motion" />
        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.MotionChoices}" SelectedItem="{Binding MotionChoice}" MinWidth="380" />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="Reduced or Off is easier on the eyes and on older PCs. It changes straight away." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowMail}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Mail checking" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Check for new mail every" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding MailCheckChoices}" SelectedItem="{Binding MailCheckMinutes}" MinWidth="80" />
          <TextBlock Text="minutes" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="New mail also shows within seconds of arriving, when your mail server can tell Webignite (most can, xneelo included). The check above is the backup." />
        <CheckBox IsChecked="{Binding NotifyNewMail}" Content="Show a note in the corner when new mail arrives" />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="Mail is checked while Webignite is open, on any page. The taskbar button flashes when mail comes in while the app is behind other windows." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowMail}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Spelling" />
        <CheckBox IsChecked="{Binding Spelling.SpellCheckOn}" Content="Check spelling as I write mail and notes" />
        <StackPanel Spacing="4" IsEnabled="{Binding Spelling.SpellCheckOn}">
          <TextBlock Classes="label" Text="Languages, checked together" />
          <ItemsControl ItemsSource="{Binding Spelling.SpellLanguages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpellLanguageRow">
                <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Name}" IsEnabled="{Binding IsOnPc}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Text="{Binding Spelling.SpellNote}" />
        <Button Classes="quiet" Content="Add a language in Windows" Command="{Binding Spelling.OpenWindowsLanguagesCommand}" IsVisible="{Binding Spelling.SpellLanguageMissing}"
                HorizontalAlignment="Left" />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="A wavy line marks a word Windows doesn't know. Right-click it for suggestions, to add it to the dictionary, or to ignore it." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowAssistants}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Claude and ChatGPT" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="They can read the mailboxes you share (set per mailbox under Mail, Manage mailboxes) and save drafts in them. They can't send, delete or move mail. You read each draft and send it yourself." />

        <TextBlock FontWeight="SemiBold" Text="Claude Desktop" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="primary" Content="Connect Claude Desktop" Command="{Binding ConnectClaudeCommand}" IsVisible="{Binding !ClaudeConnected}" />
          <Button Classes="quiet" Content="Connect again" Command="{Binding ConnectClaudeCommand}" IsVisible="{Binding ClaudeConnected}" />
        </StackPanel>
        <Border Classes.ready="{Binding ClaudeConnected}" Classes.pending="{Binding !ClaudeConnected}">
          <TextBlock Text="{Binding ClaudeStatus}" TextWrapping="Wrap" Classes.problem="{Binding ClaudeProblem}" />
        </Border>

        <TextBlock FontWeight="SemiBold" Text="ChatGPT" Margin="0,6,0,0" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="ChatGPT reaches Webignite on this PC through OpenAI's tunnel. Webignite runs the tunnel in the background while it's open; you make a tunnel and a key on OpenAI's site once, then add it in ChatGPT. Each PC has its own tunnel." />
        <StackPanel Spacing="10">
          <!-- 1. A tunnel on OpenAI's site -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="1" Width="22" FontWeight="SemiBold" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
              <TextBlock TextWrapping="Wrap" Text="Make a tunnel on OpenAI's Tunnels page (sign in with the OpenAI account your ChatGPT uses), then copy its ID here." />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Margin="8,0,0,0" Content="Open the Tunnels page" Command="{Binding ChatGpt.OpenTunnelsPageCommand}" />
                <TextBox Text="{Binding ChatGpt.ChatGptTunnelId}" PlaceholderText="tunnel_…" />
              </DockPanel>
            </StackPanel>
          </DockPanel>
          <!-- 2. A key -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="2" Width="22" FontWeight="SemiBold" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
              <TextBlock TextWrapping="Wrap" Text="Make a key on OpenAI's API keys page with permission to use tunnels, and paste it here. It's kept in Windows Credential Manager." />
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Margin="8,0,0,0" Content="Open the API keys page" Command="{Binding ChatGpt.OpenKeysPageCommand}" />
                <TextBox Text="{Binding ChatGpt.ChatGptKey}" PasswordChar="•" PlaceholderText="{Binding ChatGpt.ChatGptKeyHint}" />
              </DockPanel>
            </StackPanel>
          </DockPanel>
          <!-- 3. Connect: download and run the tunnel -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="3" Width="22" FontWeight="SemiBold" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="primary" Content="Connect ChatGPT" Command="{Binding ChatGpt.ConnectChatGptCommand}" IsEnabled="{Binding !ChatGpt.ChatGptBusy}" IsVisible="{Binding !ChatGpt.ChatGptConnected}" />
                <Button Classes="quiet" Content="Connect again" Command="{Binding ChatGpt.ConnectChatGptCommand}" IsEnabled="{Binding !ChatGpt.ChatGptBusy}" IsVisible="{Binding ChatGpt.ChatGptConnected}" />
                <Button Classes="link" Content="Stop" Command="{Binding ChatGpt.DisconnectChatGptCommand}" IsVisible="{Binding ChatGpt.ChatGptConnected}" />
              </StackPanel>
              <Border Classes.ready="{Binding ChatGpt.ChatGptWorking}" Classes.pending="{Binding !ChatGpt.ChatGptWorking}">
                <TextBlock Text="{Binding ChatGpt.ChatGptStatus}" TextWrapping="Wrap" Classes.problem="{Binding ChatGpt.ChatGptProblem}" />
              </Border>
            </StackPanel>
          </DockPanel>
          <!-- 4. Add it in ChatGPT -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="4" Width="22" FontWeight="SemiBold" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
              <TextBlock TextWrapping="Wrap"
                         Text="In ChatGPT, open Plugins, click +, then Add custom MCP server. Name it Webignite, set Connection to Tunnel, pick this tunnel, set Authentication to None, accept the warning and create it." />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="link" Content="Open ChatGPT's settings" Command="{Binding ChatGpt.OpenChatGptPluginsCommand}" />
                <Button Classes="link" Content="OpenAI's guide" Command="{Binding OpenTunnelGuideCommand}" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
          <!-- The ChatGPT desktop app needs none of the steps above: it runs the connector itself. -->
          <Border Classes="card" Padding="12" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Using the ChatGPT app on this PC instead?" />
              <TextBlock TextWrapping="Wrap" Classes="muted"
                         Text="It doesn't need a tunnel or a key. In the ChatGPT app choose Connect to a custom MCP, name it Webignite, set Type to STDIO, paste this into Command and leave the rest empty." />
              <SelectableTextBlock Text="{Binding ChatGpt.ConnectorPath}" FontFamily="Consolas, Menlo, monospace" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="quiet" Content="Copy the connector's path" Command="{Binding ChatGpt.CopyConnectorPathCommand}" CommandParameter="{Binding $parent[TopLevel]}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding ChatGpt.ConnectorPathNote}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock FontWeight="SemiBold" Text="What they changed lately" Margin="0,6,0,0" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Everything Claude and ChatGPT change shows here, newest first. When they replaced writing (a description, a note, notes on a client or person) or a client's email or name, Put back brings the old version back." />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Nothing yet." IsVisible="{Binding !AssistantChanges.HasAssistantChanges}" />
        <ItemsControl ItemsSource="{Binding AssistantChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AssistantChangeRow">
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Classes="quiet" Content="Put back" Command="{Binding PutBackCommand}" IsVisible="{Binding CanPutBack}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="{DynamicResource Text12}" Text="Put back" IsVisible="{Binding WasPutBack}" VerticalAlignment="Center" Margin="8,0" />
                <StackPanel>
                  <TextBlock Text="{Binding What}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding When}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding AssistantChanges.AssistantChangesMessage}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowEmails}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Invoice and quote emails" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Paste your Xero email templates here (in Xero: Settings, Email settings, Templates). They're sent from the mailbox ticked for invoices, with Xero's PDF attached." />
        <TextBlock FontWeight="SemiBold" Text="Invoice" />
        <StackPanel>
          <TextBlock Classes="label" Text="Subject" />
          <TextBox Text="{Binding InvoiceSubject}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Message" />
          <TextBox Text="{Binding InvoiceBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding InvoicePlaceholders}" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Quote" Margin="0,6,0,0" />
        <StackPanel>
          <TextBlock Classes="label" Text="Subject" />
          <TextBox Text="{Binding QuoteSubject}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Message" />
          <TextBox Text="{Binding QuoteBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding QuotePlaceholders}" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Quote follow-up, a week after sending" Margin="0,6,0,0" />
        <StackPanel>
          <TextBlock Classes="label" Text="Subject" />
          <TextBox Text="{Binding FollowUpSubject}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Message" />
          <TextBox Text="{Binding FollowUpBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Overdue invoice reminder" Margin="0,6,0,0" />
        <StackPanel>
          <TextBlock Classes="label" Text="Subject" />
          <TextBox Text="{Binding ReminderSubject}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Message" />
          <TextBox Text="{Binding ReminderBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Reminders can also use [Days Overdue]." />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Monthly statement" Margin="0,6,0,0" />
        <StackPanel>
          <TextBlock Classes="label" Text="Subject" />
          <TextBox Text="{Binding StatementSubject}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Message" />
          <TextBox Text="{Binding StatementBody}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="Statements use [Statement Lines], [Statement Date] and [Amount Due] for the total still owed." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="quiet" Content="Save" Command="{Binding SaveTemplatesCommand}" />
          <Button Classes="link" Content="Use Xero's standard wording" Command="{Binding ResetTemplatesCommand}" />
          <TextBlock Classes="muted" Text="{Binding TemplatesMessage}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap"
                   Text="The mailbox signature goes under the message, picture included." />
      </StackPanel>
    </Border>

    <!-- How quote and invoice mails look: the branded layout around the words. -->
    <Border Classes="card" IsVisible="{Binding ShowEmails}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="How quote and invoice mails look" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Your words above go out inside this layout: the logo, a panel with the amount, the date and a button (View and pay online on invoices, Accept this quote on quotes), then the banking details (invoices), your terms and your details at the bottom. Both PCs use the same." />
        <TextBlock FontWeight="SemiBold" Text="Logo" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Background="White" CornerRadius="6" Padding="10,6" IsVisible="{Binding MailBrand.HasBrandLogo}">
            <Image Source="{Binding MailBrand.BrandLogo}" Height="48" Stretch="Uniform" />
          </Border>
          <Button Classes="quiet" Content="Choose logo" Click="ChooseBrandLogo" VerticalAlignment="Center" />
          <Button Classes="link" Content="Remove" Command="{Binding MailBrand.RemoveBrandLogoCommand}" IsVisible="{Binding MailBrand.HasBrandLogo}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto,8,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Classes="label" Text="Company name" />
            <TextBox Text="{Binding MailBrand.BrandCompany}" PlaceholderText="e.g. Webignite (Pty) Ltd" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Classes="label" Text="Phone" />
            <TextBox Text="{Binding MailBrand.BrandPhone}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Classes="label" Text="Email (an Accept this quote reply goes here)" />
            <TextBox Text="{Binding MailBrand.BrandEmail}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="label" Text="Website" />
            <TextBox Text="{Binding MailBrand.BrandWebsite}" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Classes="label" Text="Address" />
            <TextBox Text="{Binding MailBrand.BrandAddress}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <TextBlock Classes="label" Text="Banking details, as they should read (on invoice mails)" />
          <TextBox Text="{Binding MailBrand.BrandBank}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                   PlaceholderText="Bank, account type, account number, branch code, and what to use as the reference" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Link to your terms and conditions" />
          <TextBox Text="{Binding MailBrand.BrandTerms}" PlaceholderText="https://" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="quiet" Content="Save" Command="{Binding MailBrand.SaveBrandCommand}" />
          <Button Classes="link" Content="Send a test to myself" Command="{Binding MailBrand.SendBrandTestCommand}" />
        </StackPanel>
        <TextBlock FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Classes="muted" Classes.problem="{Binding MailBrand.BrandProblem}" Text="{Binding MailBrand.BrandMessage}"
                   IsVisible="{Binding MailBrand.BrandMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowFiles}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Client folders" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="The folder that holds a folder for each client, e.g. C:\Projects. Files shows them at the top, and each client's page finds their folder by name." />
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="quiet" Content="Choose folder" Click="ChooseClientRoot" Margin="8,0,0,0" />
          <TextBox Text="{Binding ClientRoot, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowFiles}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Pictures" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Open pictures from Windows Explorer in Webignite's picture viewer. Windows lets only you choose the default, so this puts Webignite on the list and opens Default apps, where you pick it for JPG, PNG, WebP and the rest." />
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" IsVisible="{Binding !Pictures.CanOfferForPictures}"
                   Text="This needs Windows." />
        <WrapPanel IsVisible="{Binding Pictures.CanOfferForPictures}" ItemSpacing="8" LineSpacing="8">
          <Button Classes="quiet" Content="Offer Webignite for pictures" Command="{Binding Pictures.OfferForPicturesCommand}" IsVisible="{Binding Pictures.NotOfferedForPictures}" />
          <Button Classes="quiet" Content="Choose it in Default apps" Command="{Binding Pictures.OpenDefaultAppsCommand}" IsVisible="{Binding Pictures.OfferedForPictures}" />
          <Button Classes="link" Content="Stop offering it" Command="{Binding Pictures.StopOfferingForPicturesCommand}" IsVisible="{Binding Pictures.OfferedForPictures}" />
        </WrapPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Pictures.PicturesMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding Pictures.PicturesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowFiles}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Tags" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Tag files and folders in Files by right-clicking them. Each tag has a spot in Files' side list showing everything with it, from every client. Tags stay in Webignite, so Windows Explorer doesn't show them, and they follow a file renamed or moved on the same drive." />
        <ItemsControl ItemsSource="{Binding FileTags.FileTagRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileTagRow">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBox Text="{Binding Name}" Width="220" LostFocus="FileTagNameLost" KeyDown="FileTagNameKeys" />
                <ItemsControl ItemsSource="{Binding Colours}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileTagColour">
                      <Button Classes="link" Padding="4" Command="{Binding PickCommand}" ToolTip.Tip="{Binding Colour}">
                        <Border Classes="swatch" Classes.chosen="{Binding Chosen}">
                          <c:CategoryDot Colour="{Binding Colour}" Size="12" />
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="link" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                        ToolTip.Tip="Takes the tag off the list and off every file. The files themselves stay." />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding FileTags.NewFileTag}" Width="220" PlaceholderText="e.g. Needs client OK" KeyDown="NewFileTagKeys" />
          <Button Classes="quiet" Content="Add tag" Command="{Binding FileTags.AddFileTagCommand}" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding FileTags.FileTagMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding FileTags.FileTagMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowScreenshots}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Screenshots" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Press the shortcut in any program: the screen freezes, you drag over a part, click a window, or press Enter for all of it, and it opens in Mark-up to add arrows, text or blur." />
        <StackPanel>
          <TextBlock Classes="label" Text="Shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ShortcutBox" Width="220" Text="{Binding ScreenshotShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.Screenshot}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+S" />
            <Button Classes="link" Content="Ctrl+Alt+S" Command="{Binding ShortcutBackCommand}" CommandParameter="{x:Static tools:GlobalShortcut.Screenshot}" ToolTip.Tip="Go back to the usual shortcut" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.Screenshot}" />
          </StackPanel>
          <TextBlock FontSize="{DynamicResource Text12}" Classes="muted" Classes.problem="{Binding ShortcutProblem}" Text="{Binding ShortcutMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                     IsVisible="{Binding ShortcutMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Recording shortcut, to start and stop" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding RecordShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.Recording}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+R" />
            <CheckBox Content="Record my microphone too" IsChecked="{Binding RecordMicrophone}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Clipboard history shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding ClipboardShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.ClipboardHistory}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+V" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.ClipboardHistory}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Opens the last things you copied, text and pictures, from any program." />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Colour picker shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding ColourShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.ColourPicker}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+C" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.ColourPicker}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Freezes the screen; click any colour and its code is copied, e.g. #E8590C. Esc stops." />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Text snippets shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding SnippetShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.Snippets}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+T" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.Snippets}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Opens your saved blocks of text from any program. Pick one and it is pasted where you were typing." />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Text from the screen shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding TextShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.ScreenText}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+X" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.ScreenText}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Freezes the screen; drag over words in a picture, a video or a locked PDF and they are copied as text. Read on this PC by Windows." />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Screen ruler shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding RulerShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.Ruler}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+M" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.Ruler}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Freezes the screen; point at a gap or a block to measure it, or drag a box. A click copies the size, e.g. 480 × 270. Esc stops." />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Screenshots without a client go to" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="quiet" Content="Choose folder" Click="ChooseScreenshotFolder" Margin="8,0,0,0" />
            <TextBox Text="{Binding ScreenshotFolder, Mode=OneWay}" IsReadOnly="True" />
          </DockPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="With a client picked in Mark-up, the screenshot is saved in their client folder instead." />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowAccount}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Account and sync" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="An account on your Webignite sync server lets you and your partner share projects. Your password never leaves this PC, and what's synced is locked here first, so the server can't read it." />

        <StackPanel IsVisible="{Binding Account.ShowSyncServerBox}">
          <TextBlock Classes="label" Text="Sync server" />
          <TextBox Text="{Binding Account.SyncServer}" PlaceholderText="https://sync.webignite.co.za" IsEnabled="{Binding Account.IsSignedOut}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Account.ShowSyncServerBox}">
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" VerticalAlignment="Center" Text="{Binding Account.SyncServerShown}" />
          <Button Classes="link" FontSize="{DynamicResource Text12}" Content="Change" Command="{Binding Account.ChangeSyncServerCommand}" IsVisible="{Binding Account.IsSignedOut}" />
        </StackPanel>

        <!-- Signed out: sign in, create an account, or join a workspace with an invite. -->
        <StackPanel Spacing="12" IsVisible="{Binding Account.IsSignedOut}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="segment" Classes.on="{Binding Account.IsSignInForm}" Content="Sign in" Command="{Binding Account.ShowAccountFormCommand}" CommandParameter="sign-in" />
            <Button Classes="segment" Classes.on="{Binding Account.IsNewAccountForm}" Content="New account" Command="{Binding Account.ShowAccountFormCommand}" CommandParameter="new" />
            <Button Classes="segment" Classes.on="{Binding Account.IsJoinForm}" Content="Join with an invite" Command="{Binding Account.ShowAccountFormCommand}" CommandParameter="join" />
            <Button Classes="segment" Classes.on="{Binding Account.IsRecoverForm}" Content="Forgot your password?" Command="{Binding Account.ShowAccountFormCommand}" CommandParameter="recover" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.IsJoinForm}">
            <TextBlock Classes="label" Text="Invite code, from the person who invited you" />
            <TextBox Text="{Binding Account.JoinCode}" PlaceholderText="ABCD-EFGH-JKLM" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Email" />
            <TextBox Text="{Binding Account.AccountEmail}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.IsRecoverForm}">
            <TextBlock Classes="label" Text="Recovery key" />
            <TextBox Text="{Binding Account.RecoveryKeyTyped}" PlaceholderText="The 52 letters and digits you kept when you made the account" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Password" IsVisible="{Binding !Account.IsRecoverForm}" />
            <TextBlock Classes="label" Text="New password" IsVisible="{Binding Account.IsRecoverForm}" />
            <TextBox PasswordChar="•" Text="{Binding Account.AccountPassword}" PlaceholderText="At least 12 characters; a few words together works well" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.NeedsNewPassword}">
            <TextBlock Classes="label" Text="Password again" />
            <TextBox PasswordChar="•" Text="{Binding Account.AccountPasswordAgain}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.IsNewAccountForm}">
            <TextBlock Classes="label" Text="Workspace name" />
            <TextBox Text="{Binding Account.NewWorkspaceName}" PlaceholderText="Webignite" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.NeedsSignInCode}">
            <TextBlock Classes="label" Text="Code from your authenticator app, or a recovery code" />
            <TextBox Text="{Binding Account.SignInCode}" Width="200" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="Sign in" Command="{Binding Account.SignInCommand}" IsVisible="{Binding Account.IsSignInForm}" IsEnabled="{Binding !Account.AccountBusy}" />
            <Button Classes="primary" Content="Create the account" Command="{Binding Account.CreateAccountCommand}" IsVisible="{Binding Account.IsCreating}" IsEnabled="{Binding !Account.AccountBusy}" />
            <Button Classes="primary" Content="Set the new password" Command="{Binding Account.RecoverCommand}" IsVisible="{Binding Account.IsRecoverForm}" IsEnabled="{Binding !Account.AccountBusy}" />
          </StackPanel>
        </StackPanel>

        <!-- Signed in: who, the workspace, two-factor and inviting your partner. -->
        <StackPanel Spacing="12" IsVisible="{Binding Account.IsSignedIn}">
          <TextBlock Text="{Binding Account.SignedInAs}" TextWrapping="Wrap" />
          <Button Classes="link" HorizontalAlignment="Left" Content="Go through the setup guide again" Command="{Binding Account.RunSetupGuideCommand}"
                  ToolTip.Tip="Xero, ChatGPT and a look round the main pages" />
          <Border Classes="pending" IsVisible="{Binding Account.HasNewRecoveryKey}" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Your recovery key" />
              <SelectableTextBlock Text="{Binding Account.NewRecoveryKey}" FontSize="16" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="If you forget your password, this key and your email get you back in without losing anything synced. Nobody else has it, not even the server. Write it down or print it, and keep it away from this PC." />
              <Button Classes="quiet" Content="I've kept it safe" Command="{Binding Account.RecoveryKeyKeptCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="This PC has the workspace key, so it can unlock what's shared." IsVisible="{Binding Account.HasWorkspaceKey}" />
          <TextBlock Classes="problem" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Text="This PC doesn't have the workspace key yet. Sign out and sign in again with your password." IsVisible="{Binding !Account.HasWorkspaceKey}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" TextWrapping="Wrap" Text="Who's in the workspace is under Your organisation." />

          <TextBlock FontWeight="SemiBold" Text="Licence" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Account.LicenceText}" TextWrapping="Wrap" Classes.problem="{Binding Account.LicenceProblem}" />

          <TextBlock FontWeight="SemiBold" Text="Shared projects" Margin="0,6,0,0" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Projects ticked Shared, with their sections, tasks, comments and activity, sync every 15 minutes while you're signed in, and when you click Sync now or close Webignite. Chat and your status go every minute. When you both change the same task, each field keeps whoever changed it last. Personal projects stay on this PC. Files attached to tasks go too (up to 25 MB each)." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="quiet" Content="Sync now" Command="{Binding Account.SyncNowCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" VerticalAlignment="Center" Text="{Binding Account.LastSyncedText}" />
          </StackPanel>

          <TextBlock FontWeight="SemiBold" Text="Two-factor" Margin="0,6,0,0" />
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Account.TwoFactorOff}"
                     Text="With two-factor on, signing in also needs a code from an authenticator app on your phone, so a stolen password isn't enough." />
          <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Account.TwoFactorOn}"
                     Text="Two-factor is on. To turn it off, type a code from your authenticator app." />
          <Button Classes="quiet" Content="Turn on two-factor" Command="{Binding Account.StartTwoFactorCommand}" IsVisible="{Binding Account.TwoFactorOff}" IsEnabled="{Binding !Account.AccountBusy}" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding Account.SettingUpTwoFactor}">
            <Image Source="{Binding Account.TwoFactorQr}" Width="180" Height="180" />
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="Or type this key into the app" />
              <SelectableTextBlock Text="{Binding Account.TwoFactorSecret}" FontFamily="Consolas, Menlo, monospace" />
              <TextBlock Classes="label" Text="The six digits it shows" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Account.TwoFactorCode}" Width="120" />
                <Button Classes="primary" Content="Turn it on" Command="{Binding Account.ConfirmTwoFactorCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Account.TwoFactorOn}">
            <TextBox Text="{Binding Account.TwoFactorCode}" Width="120" PlaceholderText="Code" />
            <Button Classes="quiet" Content="Turn off two-factor" Command="{Binding Account.StopTwoFactorCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Account.HasRecoveryCodes}">
            <TextBlock Classes="label" Text="Recovery codes" />
            <SelectableTextBlock Text="{Binding Account.RecoveryCodesText}" FontFamily="Consolas, Menlo, monospace" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding Account.IsWorkspaceOwner}">
            <TextBlock FontWeight="SemiBold" Text="Your partner" Margin="0,6,0,0" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Makes one message with everything your partner needs: the link to install Webignite, an invite code and the few steps. Send it only to them." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet" Content="Make an invite" Command="{Binding Account.InvitePartnerCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
              <Button Classes="link" Content="Copy the install link" Command="{Binding Account.CopyInstallLinkCommand}" CommandParameter="{Binding $parent[TopLevel]}"
                      ToolTip.Tip="Always the newest Webignite for Windows" VerticalAlignment="Center" />
            </StackPanel>
            <Border Classes="pending" Padding="14" IsVisible="{Binding Account.HasInvite}">
              <StackPanel Spacing="10">
                <SelectableTextBlock Text="{Binding Account.InviteMessage}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Copy the message" Command="{Binding Account.CopyInviteCommand}" CommandParameter="{Binding $parent[TopLevel]}" />
                  <Button Classes="quiet" Content="Send it by mail" Command="{Binding Account.MailInviteCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock FontWeight="SemiBold" Text="Password and PCs" Margin="0,6,0,0" />
          <Button Classes="quiet" Content="Change password" Command="{Binding Account.StartChangeAccountPasswordCommand}" IsVisible="{Binding !Account.ChangingAccountPassword}" HorizontalAlignment="Left" />
          <StackPanel Spacing="8" IsVisible="{Binding Account.ChangingAccountPassword}" MaxWidth="360" HorizontalAlignment="Left">
            <TextBlock Classes="label" Text="Current password" />
            <TextBox Text="{Binding Account.PasswordNow}" PasswordChar="•" />
            <TextBlock Classes="label" Text="New password" />
            <TextBox Text="{Binding Account.PasswordNew}" PasswordChar="•" />
            <TextBlock Classes="label" Text="New password again" />
            <TextBox Text="{Binding Account.PasswordNewAgain}" PasswordChar="•" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Change it" Command="{Binding Account.ChangeAccountPasswordCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
              <Button Classes="quiet" Content="Cancel" Command="{Binding Account.CancelChangeAccountPasswordCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="quiet" Content="Sign out on this PC" Command="{Binding Account.SignOutCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
            <Button Classes="quiet" Content="Sign out other PCs" Command="{Binding Account.SignOutOtherPcsCommand}" IsEnabled="{Binding !Account.AccountBusy}"
                    ToolTip.Tip="Signs out every other PC on your account, for example one that was lost or sold." />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Account.SyncMessage}" TextWrapping="Wrap" Classes.problem="{Binding Account.SyncProblem}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowOrganisation}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Your organisation" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Account.OrganisationText}" />
        <!-- Everyone in the workspace, as Asana's members list: initials, name, email, role and status -->
        <ItemsControl ItemsSource="{Binding Account.Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MemberRowViewModel">
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="link" Content="Take out" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                          VerticalAlignment="Center" ToolTip.Tip="They can't sign in or sync any more." />
                  <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Role}" VerticalAlignment="Center" Margin="12,0" />
                  <Panel DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                    <c:Monogram Text="{Binding Name}" Size="36" />
                    <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Surface}" StrokeThickness="2"
                             Fill="{Binding Shown, Converter={x:Static c:PresenceColours.Brush}}" ToolTip.Tip="{Binding ShownText}" />
                  </Panel>
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="(you)" IsVisible="{Binding IsMe}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Email}" IsVisible="{Binding HasEmail}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="pending" IsVisible="{Binding Account.ConfirmingRemove}">
          <StackPanel Spacing="8">
            <TextBlock TextWrapping="Wrap" Text="{Binding Account.RemoveQuestion}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet" Content="Take them out" Command="{Binding Account.RemoveMemberCommand}" IsEnabled="{Binding !Account.AccountBusy}" />
              <Button Classes="quiet" Content="Keep them" Command="{Binding Account.KeepMemberCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock FontWeight="SemiBold" Text="Names" Margin="0,6,0,0" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Tasks can be given to either of you, and every change records who made it. Your name goes to your partner's PC with the next sync, and theirs comes to you, so you both see the same names and initials." />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="8" Width="520" HorizontalAlignment="Left">
          <TextBlock Text="Your name" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Account.MyName}" />
          <TextBlock Grid.Row="1" Text="Partner's name" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Account.PartnerName}" ToolTip.Tip="Replaced by the name your partner gives themselves on their PC" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Save" Command="{Binding Account.SaveTeamCommand}" />
          <TextBlock Text="{Binding Account.TeamMessage}" VerticalAlignment="Center" Classes.problem="{Binding Account.TeamProblem}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Account.SyncMessage}" TextWrapping="Wrap" Classes.problem="{Binding Account.SyncProblem}" IsVisible="{Binding Account.SyncMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowNotes}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Quick note" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Press the shortcut in any program and a small box opens. Type the thought down, press Ctrl+Enter or Esc, and it's in Notes." />
        <StackPanel>
          <TextBlock Classes="label" Text="Shortcut" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" Text="{Binding QuickNoteShortcut, Mode=OneWay}" IsReadOnly="True"
                     PlaceholderText="Click, then press the keys" KeyDown="ShortcutKeys" Tag="{x:Static tools:GlobalShortcut.QuickNote}" ToolTip.Tip="Click here, then press the keys you want, e.g. Ctrl+Alt+N" />
            <Button Classes="link" Content="Ctrl+Alt+N" Command="{Binding ShortcutBackCommand}" CommandParameter="{x:Static tools:GlobalShortcut.QuickNote}" ToolTip.Tip="Go back to the usual shortcut" />
            <Button Classes="link" Content="Turn off" Command="{Binding ShortcutOffCommand}" CommandParameter="{x:Static tools:GlobalShortcut.QuickNote}" />
            <Button Classes="link" Content="Try it" Command="{Binding OpenQuickNoteCommand}" />
          </StackPanel>
          <TextBlock FontSize="{DynamicResource Text12}" Classes="muted" Classes.problem="{Binding QuickNoteProblem}" Text="{Binding QuickNoteMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                     IsVisible="{Binding QuickNoteMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Quick notes go into" />
          <ComboBox Width="220" ItemsSource="{Binding Notebooks}" SelectedItem="{Binding QuickNotebook, Mode=OneWay}" SelectionChanged="QuickNotebookPicked">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="notes:Notebook">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowDocuments}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="New documents" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel>
            <TextBlock Classes="label" Text="Invoices due after (days)" />
            <TextBox Text="{Binding InvoiceDueDays}" Width="120" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Quotes expire after (days)" />
            <TextBox Text="{Binding QuoteExpiryDays}" Width="120" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="quiet" Content="Save" Command="{Binding SaveDefaultsCommand}" />
          <TextBlock Classes="muted" Text="{Binding DefaultsMessage}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="Currency is ZAR and there is no VAT, as Webignite is not VAT registered." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowDocuments}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="Price list" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Your standard packages and items. To add one, fill in the lines on a quote or invoice and click &quot;Save these lines to the price list&quot;. Saving again under the same name updates it. Claude and ChatGPT can read this list when they prepare quotes." />
        <TextBlock Classes="muted" Text="Nothing saved yet." IsVisible="{Binding !HasPrices}" />
        <ItemsControl ItemsSource="{Binding Prices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PriceRow">
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Classes="link" Content="Remove" VerticalAlignment="Center"
                        Command="{Binding #Root.((vm:SettingsViewModel)DataContext).DeletePriceCommand}" CommandParameter="{Binding}" />
                <StackPanel>
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding Name}" />
                    <Run Text="  " />
                    <Run Text="{Binding Summary}" FontWeight="Normal" Foreground="{DynamicResource Muted}" />
                  </TextBlock>
                  <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding LinesText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowHelp}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="If something goes wrong" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Problems the app runs into in the background, such as a mail check that failed, are written to a log on this PC and kept for two weeks. Nothing is sent anywhere." />
        <Button Classes="quiet" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
