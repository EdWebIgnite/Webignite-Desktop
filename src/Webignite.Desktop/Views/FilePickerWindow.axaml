<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Webignite.Desktop.ViewModels"
        xmlns:v="using:Webignite.Desktop.Views"
        x:Class="Webignite.Desktop.Views.FilePickerWindow"
        x:DataType="vm:FilePickerViewModel"
        Title="{Binding Title}" Width="1040" Height="660" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
  <DockPanel>
    <!-- What it's for, and the button that picks -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Classes="link" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Classes="primary" Content="{Binding ChooseText}" Command="{Binding ChooseCommand}" />
        </StackPanel>
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <DockPanel IsVisible="{Binding IsSave}">
            <TextBlock DockPanel.Dock="Left" Text="Save as" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" Text="{Binding FileName}" KeyDown="NameKeys" />
          </DockPanel>
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Shows, StringFormat='Shows {0}'}" IsVisible="{Binding HasShows}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <v:FilesView DataContext="{Binding Files}" />
  </DockPanel>
</Window>
