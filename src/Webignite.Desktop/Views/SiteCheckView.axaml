<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:web="using:Webignite.Core.Web"
             x:Class="Webignite.Desktop.Views.SiteCheckView"
             x:DataType="vm:SiteCheckViewModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="4">
      <TextBlock Classes="h1" Text="Site check" />
      <TextBlock Classes="muted" Text="Look over a client's domain and how fast their site loads, before they ask." />
    </StackPanel>

    <Border Classes="card">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <Button Classes="primary" Content="Check domain" Command="{Binding CheckDomainCommand}" />
          <Button Classes="quiet" Content="Test speed" Command="{Binding TestSpeedCommand}" />
        </StackPanel>
        <TextBox Text="{Binding Address}" PlaceholderText="A domain or web address, e.g. karoocoffee.co.za" FontSize="15">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CheckDomainCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding DomainTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted" Classes.problem="{Binding DomainProblem}" Text="{Binding DomainMessage}" VerticalAlignment="Center" />
          <TextBlock Classes="h2" Text="{Binding DomainTitle}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasDomain}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="web:DomainFinding">
              <Grid ColumnDefinitions="180,*" Margin="0,5">
                <TextBlock Grid.Column="0" Classes="label" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Classes.problem="{Binding Problem}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding SpeedTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="muted" Text="Google PageSpeed, mobile" VerticalAlignment="Center" />
          <TextBlock Classes="h2" Text="{Binding SpeedTitle}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Classes="muted" Classes.problem="{Binding SpeedMessageProblem}" Text="{Binding SpeedMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding SpeedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Grid ColumnDefinitions="140,24,*" IsVisible="{Binding HasSpeed}">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding SpeedScore}" FontSize="48" FontWeight="Bold" Classes.problem="{Binding SpeedIsProblem}" />
            <TextBlock Classes="muted" Text="{Binding SpeedVerdict}" />
            <TextBlock Classes="muted" FontSize="12" Text="out of 100. 90 and up is good." TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl Grid.Column="2" ItemsSource="{Binding Speed.Metrics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="web:SpeedMetric">
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Classes.problem="{Binding Problem}" />
                  <TextBlock Text="{Binding Label}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <StackPanel Spacing="6" IsVisible="{Binding HasFixes}">
          <TextBlock FontWeight="SemiBold" Text="What would help most" />
          <ItemsControl ItemsSource="{Binding Speed.Fixes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Images are usually the biggest win. The Website images tool under Tools makes them smaller." />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
