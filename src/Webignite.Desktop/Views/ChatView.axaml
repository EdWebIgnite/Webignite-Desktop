<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             xmlns:c="using:Webignite.Desktop.Controls"
             x:Class="Webignite.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel"
             DragDrop.AllowDrop="True">
  <UserControl.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MaxWidth" Value="380" />
      <Setter Property="Background" Value="{DynamicResource Surface2}" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="Background" Value="{DynamicResource InvoiceSoft}" />
    </Style>
    <Style Selector="StackPanel.message">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="StackPanel.message.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="StackPanel.message > TextBlock.mine">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.bubble SelectableTextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.chatfile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Who's there: my partner's status, and mine to pick (Busy keeps pop-ups and sounds away). -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding MyShown, Converter={x:Static c:PresenceColours.Brush}}" />
          <TextBlock Classes="muted" FontSize="12" Text="Me:" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding MyStatus}" MinWidth="110" FontSize="12"
                    ToolTip.Tip="Away shows by itself after 10 minutes without using the PC. Busy means no pop-ups or sounds.">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static c:PresenceColours.Word}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding PartnerShown, Converter={x:Static c:PresenceColours.Brush}}" />
          <TextBlock Text="{Binding PartnerStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- Writing: files waiting to go, the words, Attach and Send -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Classes="muted" Classes.problem="{Binding NoteIsProblem}"
                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding Pending}" IsVisible="{Binding HasPending}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PendingFile">
              <Border Classes="chip" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Data="{StaticResource Icon.Paperclip}" Size="12" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                  <Button Classes="link" Content="×" Padding="2,0" Command="{Binding RemoveCommand}" ToolTip.Tip="Take it off" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding SendCommand}" />
          <Button DockPanel.Dock="Left" Classes="quiet" Margin="0,0,8,0" VerticalAlignment="Bottom" Click="Attach" ToolTip.Tip="Attach files (or drop them here, or paste a screenshot)">
            <c:Icon Data="{StaticResource Icon.Paperclip}" Size="15" />
          </Button>
          <TextBox x:Name="DraftBox" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                   PlaceholderText="Write a message. Enter sends, Shift+Enter for a new line." KeyDown="DraftKeyDown" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Panel>
      <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="{StaticResource Icon.Send}" Title="No messages yet"
                    Text="Write to your partner here. Files and screenshots can go too; everything is locked before it leaves this PC." />
      <ScrollViewer x:Name="Scroller" IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Messages}" Margin="12,12,12,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatBubble">
              <StackPanel Spacing="2" Classes="message" Classes.mine="{Binding IsMine}">
                <TextBlock Classes="muted" FontSize="11" Classes.mine="{Binding IsMine}">
                  <Run Text="{Binding Who}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding When}" />
                </TextBlock>
                <Border Classes="bubble" Classes.mine="{Binding IsMine}">
                  <StackPanel Spacing="6">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}" />
                    <ItemsControl ItemsSource="{Binding Files}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatFileRow">
                          <Button Classes="chatfile" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Name}">
                            <Panel>
                              <Image Source="{Binding Picture}" MaxWidth="260" MaxHeight="200" Stretch="Uniform" IsVisible="{Binding HasPicture}" />
                              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFile}">
                                <c:Icon Data="{StaticResource Icon.Paperclip}" Size="14" VerticalAlignment="Center" />
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                  <TextBlock Classes="muted" FontSize="11" Text="{Binding SizeText}" />
                                </StackPanel>
                              </StackPanel>
                            </Panel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
