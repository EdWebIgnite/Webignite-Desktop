<v:FullBleedView xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Webignite.Desktop.ViewModels"
                 xmlns:v="using:Webignite.Desktop.Views"
                 xmlns:c="using:Webignite.Desktop.Controls"
                 x:Class="Webignite.Desktop.Views.CalendarView"
                 x:DataType="vm:CalendarViewModel"
                 x:Name="Root">
  <!-- The month fills the window both ways: on a big screen each day grows and shows more of what is on it. -->
  <Grid x:Name="Layout" ColumnDefinitions="*,20,300" RowDefinitions="Auto,*" Margin="36,30,36,24">
    <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
        <Button Classes="quiet" Content="Today" Command="{Binding GoToTodayCommand}" />
        <Button Classes="quiet" Content="‹" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month" />
        <Button Classes="quiet" Content="›" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month" />
      </StackPanel>
      <TextBlock Classes="h1" Text="{Binding MonthTitle}" />
    </DockPanel>

    <!-- Month grid, with a handle under it to make it shorter or taller -->
    <Grid x:Name="MonthArea" Grid.Row="1" Grid.Column="0" RowDefinitions="*,14">
    <Border Classes="card" Padding="0" ClipToBounds="True">
      <DockPanel>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{x:Static vm:CalendarViewModel.WeekdayNames}" Background="{DynamicResource TableHead}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="label" Text="{Binding}" Margin="8,9" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Scrolls only when the window is too short for a readable month; otherwise the weeks share the height. -->
        <ScrollViewer x:Name="MonthScroller" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="DayGrid" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DayCellViewModel">
                <Button Classes="day" Classes.other="{Binding IsOtherMonth}" Classes.selected="{Binding IsSelected}" MinHeight="84"
                        Command="{Binding #Root.((vm:CalendarViewModel)DataContext).SelectDayCommand}" CommandParameter="{Binding}">
                  <StackPanel Spacing="3">
                    <Panel HorizontalAlignment="Left">
                      <Border Classes="todaydot" IsVisible="{Binding IsToday}" />
                      <TextBlock Classes="daynum" Classes.today="{Binding IsToday}" Text="{Binding DayNumber}" FontSize="{DynamicResource Text12}" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,3" />
                    </Panel>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgendaItemViewModel">
                          <c:AgendaChip Padding="4,1" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Text11}" TextTrimming="CharacterEllipsis" />
                          </c:AgendaChip>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="{DynamicResource Text11}" Text="{Binding More}" IsVisible="{Binding HasMore}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Classes="sizegrip" PointerPressed="GripPressed" PointerMoved="GripMoved" PointerReleased="GripReleased" DoubleTapped="GripReset"
            ToolTip.Tip="Drag to make the month shorter or taller. Double-click to fill the window again.">
      <Border Classes="sizegripline" />
    </Border>
    </Grid>

    <!-- Drag to make the day panel wider or narrower -->
    <GridSplitter x:Name="SideSplitter" Grid.Row="1" Grid.Column="1" Classes="gap" ResizeDirection="Columns"
                  DragCompleted="SideDragged" ToolTip.Tip="Drag to make the day panel wider or narrower" />

    <!-- Selected day -->
    <ScrollViewer x:Name="DaySide" Grid.Row="1" Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{Binding SelectedTitle}" />
            <TextBlock Classes="muted" Text="Nothing on this day." IsVisible="{Binding SelectedIsEmpty}" />
            <ItemsControl ItemsSource="{Binding SelectedItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgendaItemViewModel">
                  <c:AgendaChip Padding="8,6" Margin="0,0,0,6">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Classes="link" ToolTip.Tip="Delete event"
                              IsVisible="{Binding CanDelete}" Command="{Binding Delete}" Padding="4,0">
                        <c:Icon Data="{StaticResource Icon.Close}" Size="12" />
                      </Button>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" FontSize="{DynamicResource Text11}">
                          <Run Text="{Binding Time}" /><Run Text="  " /><Run Text="{Binding KindLabel}" />
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </c:AgendaChip>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Add an event" />
            <TextBox Text="{Binding NewTitle}" PlaceholderText="e.g. Meeting with Bosveld Builders" />
            <Grid ColumnDefinitions="100,8,*">
              <TextBox Text="{Binding NewTime}" PlaceholderText="Time" ToolTip.Tip="e.g. 9:30 or 14:00. Empty means all day." />
              <TextBox Grid.Column="2" Text="{Binding NewLocation}" PlaceholderText="Where (optional)" />
            </Grid>
            <TextBlock Classes="muted" FontSize="{DynamicResource Text12}" Text="{Binding FormMessage}" TextWrapping="Wrap" />
            <Button Classes="primary" Content="Add to this day" Command="{Binding AddEventCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</v:FullBleedView>
