<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Webignite.Desktop.ViewModels"
             x:Class="Webignite.Desktop.Views.RenewalsView"
             x:DataType="vm:RenewalsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="RenewalRow" x:DataType="vm:RenewalRowViewModel">
      <Border Classes="taskrow" Padding="20,12,12,12">
        <Grid ColumnDefinitions="*,200,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding When}" Classes.short="{Binding IsOverdue}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Amounts}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !ConfirmingRemove}">
              <Button Classes="quiet" Content="Renewed" Command="{Binding RenewedCommand}" IsVisible="{Binding !IsFine}"
                      ToolTip.Tip="Moves it to the next date and adds the cost to expenses." />
              <Button Classes="link" Content="Change" Command="{Binding ChangeCommand}" />
              <Button Classes="link" Content="Remove" Command="{Binding AskRemoveCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ConfirmingRemove}">
              <Button Classes="quiet" Content="Remove it" Command="{Binding RemoveCommand}" />
              <Button Classes="link" Content="Keep" Command="{Binding CancelRemoveCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="18">
    <DockPanel>
      <Button DockPanel.Dock="Right" Classes="primary" Content="Add domain or hosting" Command="{Binding NewCommand}" VerticalAlignment="Center" />
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Domains and hosting" />
        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                   Text="A to-do appears before each renewal. If the client pays for it, the renewal invoice is drafted at the same time for you to check." />
      </StackPanel>
    </DockPanel>

    <Border Classes="ready" IsVisible="{Binding HasMessage}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <Border Classes="card" IsVisible="{Binding ShowForm}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{Binding FormTitle}" />
        <Grid ColumnDefinitions="2*,12,*,12,2*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Domain or name" />
            <TextBox Text="{Binding FormName}" PlaceholderText="e.g. karoocoffee.co.za" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Type" />
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding FormKind}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="Client" />
            <AutoCompleteBox Text="{Binding FormClient}" ItemsSource="{Binding ClientNames}" FilterMode="ContainsOrdinal" PlaceholderText="Empty if it's Webignite's own" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Classes="label" Text="Renewed with" />
            <TextBox Text="{Binding FormProvider}" PlaceholderText="e.g. xneelo" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,12,*,12,*,12,*,12,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="label" Text="Next renewal" />
            <CalendarDatePicker SelectedDate="{Binding FormDate}" HorizontalAlignment="Stretch" SelectedDateFormat="Custom" CustomDateFormatString="d MMM yyyy" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Renews" />
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding FormPeriod}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Classes="label" Text="It costs us" />
            <TextBox Text="{Binding FormCost}" PlaceholderText="Optional" />
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Classes="label" Text="Charge the client" />
            <TextBox Text="{Binding FormPrice}" PlaceholderText="Optional" />
          </StackPanel>
          <StackPanel Grid.Column="8">
            <TextBlock Classes="label" Text="Remind days before" />
            <TextBox Text="{Binding FormRemind}" />
          </StackPanel>
        </Grid>
        <StackPanel>
          <TextBlock Classes="label" Text="Notes" />
          <TextBox Text="{Binding FormNotes}" PlaceholderText="Login hints (no passwords), DNS details, anything to remember" />
        </StackPanel>
        <TextBlock Classes="label short" Text="{Binding FormMessage}" IsVisible="{Binding HasFormMessage}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary" Content="Save" Command="{Binding SaveFormCommand}" />
          <Button Classes="quiet" Content="Cancel" Command="{Binding CancelFormCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsEmpty}">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Nothing here yet. Add your clients' domains and hosting, and Webignite's own." />
    </Border>

    <StackPanel Spacing="8" IsVisible="{Binding HasSoon}">
      <TextBlock Classes="label" Text="RENEW SOON" />
      <Border Classes="card" Padding="0">
        <ItemsControl ItemsSource="{Binding Soon}" ItemTemplate="{StaticResource RenewalRow}" />
      </Border>
    </StackPanel>

    <StackPanel Spacing="8" IsVisible="{Binding HasLater}">
      <TextBlock Classes="label" Text="LATER" />
      <Border Classes="card" Padding="0">
        <ItemsControl ItemsSource="{Binding Later}" ItemTemplate="{StaticResource RenewalRow}" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
