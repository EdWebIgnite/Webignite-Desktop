<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Webignite.Desktop</RootNamespace>
    <AssemblyName>Webignite</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\webignite.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Kept light on memory. Background GC holds extra heap for an app that is mostly idle; without it the app
         runs about 30 MB smaller, and its pauses are still far too short to notice. ConserveMemory has the GC
         compact the heap rather than grow it. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Webignite.Core\Webignite.Core.csproj" />
    <ProjectReference Include="..\Webignite.Data\Webignite.Data.csproj" />
    <ProjectReference Include="..\Webignite.Xero\Webignite.Xero.csproj" />
    <ProjectReference Include="..\Webignite.Mail\Webignite.Mail.csproj" />
    <ProjectReference Include="..\Webignite.Services\Webignite.Services.csproj" />
  </ItemGroup>
</Project>
