# Copy this to .env on the server and fill it in. Never put .env in the repository.

# The address the apps use, without https://. Its DNS must point at this server.
SYNC_DOMAIN=sync.webignite.co.za

# 32 random bytes, Base64. Make one on the server with:  openssl rand -base64 32
# Keep a copy somewhere safe (a password manager): losing it means everyone sets up two-factor again.
WEBIGNITE_SERVER_SECRET=

# The key licences are signed with. Make it with:  docker compose run --rm server make-licence-key
# Keep it secret; the public half it prints goes into the app.
WEBIGNITE_LICENCE_KEY=
